}

model OpenClawChannel {
  id              String   @id @default(uuid()) @db.Uuid
  deploymentId    String   @map("deployment_id") @db.Uuid
  platform        String
  configEncrypted String   @map("config_encrypted") @db.Text
  enabled         Boolean  @default(true)

  // The platform's own id for the installed workspace/server (Slack
  // team_id). A distributed Slack app has ONE Events Request URL, so
  // inbound events carry a team id and nothing else we control —
  // resolving deployment-by-team is only possible if we record it.
  externalId      String?  @map("external_id")
  externalName    String?  @map("external_name")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  deployment      OpenClawDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  // One channel row per (deployment, platform): the resolver did
  // findFirst with no ordering, so duplicates made resolution arbitrary.
  @@unique([deploymentId, platform])
  // One workspace installs into at most one deployment. The second
  // install REFUSES with a named reason rather than silently stealing
  // the first one's events. (Postgres permits many NULL external_ids, so
  // manually-configured rows are unaffected.)
  @@unique([platform, externalId])
  @@index([deploymentId])
  @@map("openclaw_channels")
}

// ============================================
// Agent Token Marketplace (Phase 6)
// ============================================

enum TokenStatus {
  BONDING
  GRADUATED
  FAILED
}

model AgentToken {
  id                String      @id @default(uuid()) @db.Uuid
  agentListingId    String      @unique @map("agent_listing_id") @db.Uuid
  mintAddress       String      @unique @map("mint_address")
  pumpfunUrl        String?     @map("pumpfun_url")
  bondingCurveAddress String?   @map("bonding_curve_address")
  creatorAddress    String      @map("creator_address")
  name              String
  symbol            String
  imageUri          String?     @map("image_uri")
  // Which launchpad minted this token ("pumpfun" | "bags"). Discriminator
  // for the Bags fee-claim sweep (which only operates on bags tokens).
  // Existing rows backfill to "pumpfun".
  launchpad         String      @default("pumpfun")
  // Bags Meteora fee-share config key (base58). Null for pump.fun.
  meteoraConfigKey  String?     @map("meteora_config_key")
  totalSupply       BigInt      @default(1000000000) @map("total_supply")
  curveSupply       BigInt      @default(800000000) @map("curve_supply")
  reservedSupply    BigInt      @default(200000000) @map("reserved_supply")
  status            TokenStatus @default(BONDING)
  graduatedAt       DateTime?   @map("graduated_at")
  raydiumPoolId     String?     @map("raydium_pool_id")
  marketCapUsd      Float       @default(0) @map("market_cap_usd")
  priceUsd          Float       @default(0) @map("price_usd")
  volume24h         Float       @default(0) @map("volume_24h")
  holders           Int         @default(0)
  creatorLockupEnd  DateTime?   @map("creator_lockup_end")
  // Per-agent treasury PDA (derived from mintAddress). Receives the token's
  // fee share and auto-pays the agent's Nosana compute bill. See plan A2/A3.
  treasuryAddress       String? @unique @map("treasury_address")
  treasuryPdaAuthorityBump Int?   @map("treasury_pda_authority_bump")
  // Cumulative lifetime counters (mirror of on-chain state, updated by
  // treasury-settlement worker).
  computePaidLamports BigInt @default(0) @map("compute_paid_lamports")
  revenueLamports     BigInt @default(0) @map("revenue_lamports")
  // Whether the reputation-oracle program's AgentReputation PDA has been
  // initialized on-chain for this token mint (plan A4). The attestation
  // worker skips agents where this is false; the bootstrap path calls
  // initialize_agent_reputation and flips it. Existing rows default false.
  reputationProgramInitialized Boolean   @default(false) @map("reputation_program_initialized")
  // Cursor advanced by the reputation-attestation worker after a
  // successful submit_attestation. Usage records with periodEnd > this
  // cursor contribute to the next attestation. Null = never attested.
  lastOnChainAttestationAt     DateTime? @map("last_on_chain_attestation_at")
  // Per-token high-water-mark cursor for the trade indexer (plan D7):
  // timestamp of the newest trade fetched from the launchpad API. The
  // indexer paginates each tick until it reaches this cursor, so bursts
  // larger than one page are not silently dropped. Null = never indexed
  // (fetch from epoch).
  tradeIndexCursor             DateTime? @map("trade_index_cursor")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  agentListing      AgentListing @relation(fields: [agentListingId], references: [id], onDelete: Cascade)
  trades            AgentTokenTrade[]
  holdersList       AgentTokenHolder[]
  snapshots         AgentTokenSnapshot[]
  treasury          AgentTreasury?
  onChainAttestations OnChainAttestation[]

  @@index([status])
  @@index([marketCapUsd])
  @@index([volume24h])
  @@index([launchpad])
  @@map("agent_tokens")
}

// ============================================
// On-chain reputation attestation mirror (Plan A4)
// ============================================
//
// The reputation-oracle Anchor program emits an `AttestationSubmitted`
// event on every successful submit_attestation. We mirror those events
// here so off-chain readers (token launchpad eligibility, public
// transparency pages, the runway dashboard) don't have to scan the
// chain on every load. The on-chain AgentReputation PDA remains the
// source of truth — this is a read-cache, not authoritative.

// OnChainAttestation mirror state machine (confirmation discipline,
// remediation D6b):
//
//   SUBMITTED ──getSignatureStatuses confirmed/finalized──> CONFIRMED
//       │
//       ├── landed with on-chain err ──────────> FAILED
//       └── expired (head > lastValidBlockHeight) AND unseen ──> FAILED
//
// The row is INSERTED at submit time (claim-first: BEFORE the broadcast)
// with the signed-tx artifacts, so a crash anywhere afterwards leaves a
// durable record recovery can settle from on-chain evidence. Only
// CONFIRMED rows count as attestations; the per-token cursor
// (AgentToken.lastOnChainAttestationAt) advances only on CONFIRMED.
// FAILED rows keep the window open — the next tick re-attests it.
enum OnChainAttestationStatus {
  SUBMITTED
  CONFIRMED
  FAILED
}

model OnChainAttestation {
  id                  String   @id @default(uuid()) @db.Uuid
  tokenId             String   @map("token_id") @db.Uuid
  txSignature         String   @unique @map("tx_signature")
  attestorAddress     String   @map("attestor_address")
  uptimeSecondsDelta  BigInt   @map("uptime_seconds_delta")
  messageCountDelta   BigInt   @map("message_count_delta")
  score               Int
  status              OnChainAttestationStatus @default(SUBMITTED)
  // Cumulative totals AFTER applying this attestation, read back from the
  // on-chain AgentReputation PDA at CONFIRMATION time (the program is the
  // source of truth — these are NOT derived from the deltas). Null while
  // the row is SUBMITTED/FAILED, or when the post-confirm readback was
  // unavailable.
  cumulativeUptimeSeconds BigInt? @map("cumulative_uptime_seconds")
  cumulativeMessageCount  BigInt? @map("cumulative_message_count")
  attestationCount        Int?    @map("attestation_count")
  // Attestor-claimed unix timestamp; the program rejected stale values
  // (< prior last_attestation_unix_ts) so this is monotonic per token.
  attestorUnixTs      BigInt   @map("attestor_unix_ts")
  // When we CONFIRMED the on-chain landing (getSignatureStatuses returned
  // confirmed/finalized). Null until then — broadcast time is createdAt.
  observedAt          DateTime? @map("observed_at")
  // Claim-first artifacts (same shape as ComputePayment, remediation D3):
  // persisted BEFORE broadcast so recovery can re-broadcast the SAME bytes
  // (same signature ⇒ cluster dedupes) or prove expiry from
  // lastValidBlockHeight + an unseen signature.
  signedTxB64          String?  @map("signed_tx_b64")
  lastValidBlockHeight BigInt?  @map("last_valid_block_height")
  createdAt           DateTime @default(now()) @map("created_at")

  token               AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, attestorUnixTs])
  @@index([attestorAddress])
  @@index([status])
  @@map("on_chain_attestations")
}

model AgentTokenTrade {
  id            String   @id @default(uuid()) @db.Uuid
  tokenId       String   @map("token_id") @db.Uuid
  txSignature   String   @unique @map("tx_signature")
  traderAddress String   @map("trader_address")
  side          String
  solAmount     Float    @map("sol_amount")
  tokenAmount   Float    @map("token_amount")
  priceUsd      Float    @map("price_usd")
  // Integer raw units — the money-path source of truth (remediation D9).
  // The Float columns above are retained for display/charts only.
  // solLamports = SOL × 1e9; tokenAmountRaw = tokens × 1e6 (pump.fun mints
  // are 6 decimals). Converted ONCE at the indexer boundary
  // (fetchTokenTradesSince); fee summation reads solLamports and holder
  // balances read tokenAmountRaw — never the Floats — so no float error
  // compounds across the trade stream and large values don't lose
  // precision near 2^53.
  solLamports    BigInt   @map("sol_lamports")
  tokenAmountRaw BigInt   @map("token_amount_raw")
  timestamp     DateTime
  // Row-identity fee routing (remediation D6a). Null = this trade's 1%
  // fee has not been claimed by any fee-routing batch yet; the fee
  // router selects by THIS column, never by timestamp windows, so a
  // late-arriving trade (older timestamp, indexed after a batch routed)
  // simply joins a later batch instead of being silently skipped.
  // Cleared back to null when the owning batch FAILs (expired/errored
  // on-chain) so the trades rejoin the next batch.
  feeRoutingBatchId String? @map("fee_routing_batch_id") @db.Uuid

  token           AgentToken       @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  feeRoutingBatch FeeRoutingBatch? @relation(fields: [feeRoutingBatchId], references: [id], onDelete: SetNull)

  @@index([tokenId, timestamp])
  @@index([traderAddress])
  @@index([feeRoutingBatchId])
  @@map("agent_token_trades")
}

// Fee-routing batch state machine (row-identity fee routing, remediation
// D6a). One batch = one fee_receive transaction depositing 1% of the
// claimed trades' SOL volume into the agent's treasury PDA.
//
//   CLAIMED ──sign (CAS + artifacts persisted)──> SUBMITTED ──confirm──> CONFIRMED
//      │                                             │
//      │ crash before sign (nothing broadcast)       │ landed with err, OR
//      ▼                                             ▼ expired AND provably unseen
//    FAILED <────────────────────────────────────  FAILED
//    (trades un-stamped → rejoin the next batch)
//
// CLAIMED  — batch row + trade stamps written in one $transaction; no
//            signature exists yet, so failing a stale CLAIMED batch is
//            always safe (nothing can land).
// SUBMITTED— signed artifacts persisted via compare-and-set BEFORE the
//            broadcast (claim-first, same as ComputePayment D3); recovery
//            settles it from on-chain evidence only: landed → CONFIRMED,
//            unexpired+unseen → re-broadcast the SAME bytes, expired+unseen
//            or landed-with-err → FAILED + un-stamp.
// CONFIRMED— getSignatureStatuses returned confirmed/finalized with no err.
//            The trades' fee is durably routed; they never rejoin a batch.
enum FeeRoutingBatchStatus {
  CLAIMED
  SUBMITTED
  CONFIRMED
  FAILED
}

model FeeRoutingBatch {
  id                   String                @id @default(uuid()) @db.Uuid
  treasuryId           String                @map("treasury_id") @db.Uuid
  status               FeeRoutingBatchStatus @default(CLAIMED)
  // 1% of the claimed trades' summed SOL volume, floored to lamports
  // (same math as the pre-batch fee router; D9 revisits the Float source).
  lamports             BigInt
  tradeCount           Int                   @map("trade_count")
  txSignature          String?               @unique @map("tx_signature")
  signedTxB64          String?               @map("signed_tx_b64")
  lastValidBlockHeight BigInt?               @map("last_valid_block_height")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  treasury AgentTreasury     @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  trades   AgentTokenTrade[]

  @@index([status])
  @@index([treasuryId, createdAt])
  @@map("fee_routing_batches")
}

model AgentTokenHolder {
  id            String   @id @default(uuid()) @db.Uuid
  tokenId       String   @map("token_id") @db.Uuid
  walletAddress String   @map("wallet_address")
  balance       Float
  percentage    Float
  // Integer raw token units (tokens × 1e6). The token-gate access
  // decision reads THIS, not the Float `balance` (display only) — D9.
  balanceRaw    BigInt   @map("balance_raw")
  updatedAt     DateTime @updatedAt @map("updated_at")

  token         AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, walletAddress])
  @@index([tokenId])
  @@map("agent_token_holders")
}

model AgentTokenSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  tokenId      String   @map("token_id") @db.Uuid
  priceUsd     Float    @map("price_usd")
  marketCapUsd Float    @map("market_cap_usd")
  volume24h    Float    @map("volume_24h")
  holders      Int
  timestamp    DateTime @default(now())

  token        AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, timestamp])
  @@map("agent_token_snapshots")
}

// ============================================
// Per-Agent Treasury (Plan A2/A3)
// ============================================
//
// Each tokenized agent owns a Solana PDA treasury derived from its mint
// address. The on-chain `agent-treasury` Anchor program is the source of
// truth for balances; these rows are a local mirror maintained by the
// treasury-settlement worker for fast reads + indexing.

model AgentTreasury {
  id                       String   @id @default(uuid()) @db.Uuid
  tokenId                  String   @unique @map("token_id") @db.Uuid
  treasuryPdaAddress       String   @unique @map("treasury_pda_address")
  authorityBump            Int      @map("authority_bump")
  solBalanceLamports       BigInt   @default(0) @map("sol_balance_lamports")
  // When the balance-sync tick last mirrored the on-chain PDA lamports into
  // solBalanceLamports (spendable = lamports - rent reserve). Settlement
  // skips treasuries whose mirror is stale — null/old means "skip", never
  // "assume 0 or pay anyway".
  balanceSyncedAt          DateTime? @map("balance_synced_at")
  accruedFeeLamports       BigInt   @default(0) @map("accrued_fee_lamports")
  lastComputeBillLamports  BigInt?  @map("last_compute_bill_lamports")
  lastComputeBillAt        DateTime? @map("last_compute_bill_at")
  // Computed off last-paid compute rate; UI reads this to render the runway
  // card. Recomputed on each settlement tick.
  runwaySecondsEstimate    BigInt   @default(0) @map("runway_seconds_estimate")
  lastSyncedAt             DateTime @default(now()) @map("last_synced_at")
  // Whether the agent-treasury Anchor program has been initialized
  // on-chain for this row (`initialize_treasury` instruction landed).
  // The submit worker reads this to decide between the legacy
  // SystemProgram.transfer path (false) and the program-mediated
  // pay_nosana path (true). Existing rows default to false; the
  // backfill script flips them as it migrates each treasury PDA.
  programInitialized       Boolean  @default(false) @map("program_initialized")
  // DISPLAY/OPS ONLY (remediation D6a): the latest trade timestamp whose
  // fee was confirmed-routed, bumped by the fee router after a batch
  // reaches CONFIRMED. It is NO LONGER the routing source of truth —
  // routing selects trades by row identity (AgentTokenTrade.
  // feeRoutingBatchId IS NULL), so this value being stale or null never
  // causes a fee to be skipped or double-paid.
  lastFeeRoutedAt          DateTime? @map("last_fee_routed_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  token            AgentToken        @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  payments         ComputePayment[]
  feeRoutingBatches FeeRoutingBatch[]

  @@map("agent_treasuries")
}

// ComputePayment state machine (claim-first submit protocol, remediation D3/D5):
//
//   PENDING ──claim (CAS + sign artifacts)──> SUBMITTING ──broadcast ok──> SUBMITTED ──poller──> CONFIRMED
//      │                                          │                            │
//      │                                          │ blockhash expired AND      │ poller saw on-chain err,
//      │                                          │ signature provably unseen  │ or reaper proved
//      │                                          ▼ (claim fields cleared)     ▼ expired + unseen
//      │<──────────── safe-expiry recovery ── PENDING                       FAILED
//      │
//      ├── prepare/sign failure ──> FAILED  (terminal; no tx bytes ever existed)
//      └── recipient-resolution failure ──> stays PENDING with resolution_attempts += 1;
//          after the 5th failed attempt ──> PARKED (terminal until operator re-PENDINGs)
//
// SUBMITTING rows are owned by the submit worker's recovery scan: the signed
// bytes + signature + lastValidBlockHeight persisted at claim time make
// re-broadcast idempotent (same signature ⇒ at most one effective transfer).
// A SUBMITTING row is NEVER re-signed; it either lands (→ SUBMITTED), is
// re-broadcast verbatim, or is proven expired-and-unseen (→ back to PENDING).
enum ComputePaymentStatus {
  PENDING
  SUBMITTING
  SUBMITTED
  CONFIRMED
  FAILED
  PARKED
}

model ComputePayment {
  id             String               @id @default(uuid()) @db.Uuid
  treasuryId     String               @map("treasury_id") @db.Uuid
  nosanaJobId    String               @map("nosana_job_id")
  amountLamports BigInt               @map("amount_lamports")
  computeSeconds BigInt               @map("compute_seconds")
  txSignature    String?              @unique @map("tx_signature")
  status         ComputePaymentStatus @default(PENDING)
  errorMessage   String?              @map("error_message")
  scheduledFor   DateTime             @default(now()) @map("scheduled_for")
  // Set when status moves SUBMITTING → SUBMITTED (broadcast accepted).
  // Reaper uses this as the wall-clock TRIGGER for which rows to examine;
  // the actual FAIL decision additionally requires on-chain evidence
  // (block height past lastValidBlockHeight + signature unseen).
  submittedAt    DateTime?            @map("submitted_at")
  // Claim-first protocol fields (remediation D3). Written atomically by the
  // PENDING → SUBMITTING compare-and-set BEFORE any broadcast:
  //   signedTxB64          — the fully signed tx bytes; recovery re-broadcasts
  //                          these verbatim (same signature, no double-spend).
  //   lastValidBlockHeight — expiry bound of the signed tx's blockhash. Once
  //                          the chain passes it AND the signature is unseen
  //                          (searchTransactionHistory), re-signing is safe.
  // Cleared when safe-expiry recovery returns the row to PENDING.
  signedTxB64    String?              @map("signed_tx_b64")
  lastValidBlockHeight BigInt?        @map("last_valid_block_height")
  // Counts recipient-resolution failures (Nosana job → host pubkey). The
  // submit worker retries a PENDING row whose resolution failed (transient
  // "no host yet" / RPC blips) and PARKs the row once this reaches 5 so a
  // poison job can't occupy the queue forever (remediation D5).
  resolutionAttempts Int              @default(0) @map("resolution_attempts")
  paidAt         DateTime?            @map("paid_at")
  // Counts retries from FAILED → PENDING resubmissions. Lifecycle
  // shouldRetry() reads this against a maxRetries policy.
  retryCount     Int                  @default(0) @map("retry_count")
  // Billing window this row charges for (delta billing, remediation D2).
  // periodStart = the treasury's lastComputeBillAt cursor at decision time
  // (epoch for the first-ever bill); periodEnd = the tick's `now`, which
  // becomes the new cursor. The composite unique below is the DB backstop
  // against double-billing the same window: createMany(skipDuplicates) makes
  // a crash-replayed tick a no-op. Legacy rows keep NULL periodStart —
  // Postgres treats NULLs as distinct in unique indexes, which is acceptable
  // for pre-migration rows; every new write sets both bounds.
  periodStart    DateTime?            @map("period_start")
  periodEnd      DateTime?            @map("period_end")
  createdAt      DateTime             @default(now()) @map("created_at")

  treasury AgentTreasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)

  @@unique([treasuryId, nosanaJobId, periodStart], map: "compute_payments_treasury_job_period_key")
  @@index([treasuryId, status])
  @@index([status, scheduledFor])
  @@map("compute_payments")
}

// ============================================
// Free Tier Usage Tracking
// ============================================

model FreeTierUsage {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  model        String
  provider     String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  requestCount Int      @default(0) @map("request_count")
  date         DateTime @default(now()) @db.Date

  @@unique([orgId, model, date])
  @@map("free_tier_usage")
}

// ============================================
// Web chat channel and Try it
// ============================================

// A web chat channel of an agent: the publishable key a site's embed snippet
// carries. It is public by design (it ships in page source), so it grants
// nothing by itself: a browser is held to allowedOrigins, and everyone to the
// fail-closed limits and the owner's daily cap.
model WidgetKey {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  agentId          String    @map("agent_id") @db.Uuid
  publicKey        String    @unique @map("public_key") // 'wpk_' + 32 url-safe characters
  name             String

  // 'https://host[:port]' or 'https://*.host'. Empty = no site may use it.
  allowedOrigins   String[]  @default([]) @map("allowed_origins")
  // null = the platform default.
  dailyMessageCap  Int?      @map("daily_message_cap")
  perIpPerMinute   Int?      @map("per_ip_per_minute")

  // Appearance
  title            String?
  greeting         String?   @db.VarChar(500)
  primaryColor     String?   @map("primary_color") // '#RRGGBB'
  position         String    @default("bottom-right") // 'bottom-right', 'bottom-left'

  // Off unless the owner opts in: visitor messages are then kept as
  // Conversation rows in the owner's organization.
  storeTranscripts Boolean   @default(false) @map("store_transcripts")
  // The owner's wish to hide "Powered by WheelsAI". It takes effect only
  // while their plan has white-labelling, checked when the widget loads.
  hideBranding     Boolean   @default(false) @map("hide_branding")
  enabled          Boolean   @default(true)
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")

  // Set on the one key that serves an agent's public page (/a/<handle>), to
  // that agent's id, which is then also agentId (the database checks it).
  // Unique, so an agent has at most one page key. Cleared on revoke. Null on
  // every key made for a website.
  pageOfAgentId    String?   @unique @map("page_of_agent_id") @db.Uuid

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent            Agent        @relation("WidgetKeyAgent", fields: [agentId], references: [id], onDelete: Cascade)
  pageOfAgent      Agent?       @relation("AgentPageKey", fields: [pageOfAgentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([agentId])
  @@map("widget_keys")
}

// One listing's Try it messages on one UTC day. fundedCount only rises by a
// compare-and-set that keeps it below the listing's trialFundedDailyCap, and
// falls only when a funded message is refunded.
model TrialDailyUsage {
  listingId   String   @map("listing_id") @db.Uuid
  day         String   // UTC 'YYYY-MM-DD'
  baseCount   Int      @default(0) @map("base_count") // paid for by the platform
  fundedCount Int      @default(0) @map("funded_count") // paid for by the publisher
  updatedAt   DateTime @updatedAt @map("updated_at")

  listing     AgentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([listingId, day])
  @@map("trial_daily_usage")
}

// One publisher-funded Try it message. Held before the model is called;
// settled or refunded exactly once, by compare-and-set from 'held'. No
// foreign keys: like the ledger rows it is referenced from, it outlives the
// listing.
model TrialCharge {
  id            String    @id @default(uuid()) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  publisherId   String    @map("publisher_id") @db.Uuid
  day           String    // UTC 'YYYY-MM-DD'
  amountCents   BigInt    @map("amount_cents")
  status        String    @default("held") // 'held', 'settled', 'refunded'
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  @@index([listingId, day])
  @@index([status, createdAt])
  @@map("trial_charges")
}
