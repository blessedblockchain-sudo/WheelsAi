{
  "name": "@wheelsai/cli",
  "version": "0.1.0",
  "private": true,
  "description": "WheelsAI command-line tool: build, deploy and monetize AI agents",
  "type": "module",
  "bin": {
    "wheelsai": "./bin/wheelsai.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "cli": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "clean": "rm -rf dist .test-build"
  },
  "dependencies": {
    "@wheelsai/sdk": "*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "conf": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
