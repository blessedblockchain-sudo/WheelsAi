# ===========================================
# WheelsAI Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://wheelsai:wheelsai@localhost:5434/wheelsai?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6380"

# ---- Web App (Next.js) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- API Server ----
API_PORT=4000
API_HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:3000"

# ---- Auth ----
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# ---- Encryption (required in production, falls back to JWT_SECRET in dev) ----
# ENCRYPTION_KEY=""

# ---- Agent Wallet Encryption ----
WALLET_MASTER_KEY=""

# ---- Solana / Nosana ----
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"
NOSANA_WALLET_PRIVATE_KEY=""
TREASURY_WALLET_ADDRESS="11111111111111111111111111111111"

# ---- Nosana deployments (all optional; see apps/api/src/config/nosanaDeploy.ts) ----
# The built-in GPU markets are MAINNET markets. On devnet a tier is deployable only
# when you supply its market (Nosana devnet test market example below).
# NOSANA_MARKETS_JSON='{"4090":"J2mYPCyZkFzhg2oi1EqA8UAYZHhYVmktV4ExB5itFJYW"}'
# NOSANA_JOB_TIMEOUT_SECONDS=7200          # per-job timeout (kept alive by SIMPLE-EXTEND)
# NOSANA_DEPLOYMENT_STRATEGY="SIMPLE-EXTEND"   # or INFINITE | SIMPLE
# NOSANA_VAULT_FUND_SECONDS=14400          # run-time funded up front (default 2x job timeout)
# NOSANA_VAULT_SOL_LAMPORTS_PER_REPLICA=10000000
# NOSANA_NETWORK_FEE_BPS=1000
# GPU_BILLING_INTERVAL_MS=60000            # per-second GPU billing tick (0 disables)
# HF_TOKEN=""                              # Hugging Face token for gated models (confidential jobs only)
# ALLOW_LOOPBACK_NODE_URLS=false           # dev only: let /v1 + the health probe reach localhost (also needs NODE_ENV=development)

# ---- Free Model Providers (get free keys at each provider's console) ----
GROQ_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
TOGETHER_API_KEY=""
FREE_TIER_RPM=20
FREE_TIER_RPD=200
# Wall-clock limit (ms) for one agent chat, tool rounds and streaming included.
AGENT_CHAT_TIMEOUT_MS=120000

# ---- GitHub Import (optional, for private repos) ----
# GITHUB_TOKEN=""

# ---- Stripe (Payments — simulated in development) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- IPFS ----
PINATA_API_KEY=""
PINATA_SECRET_KEY=""

# ---- Inference ----
INFERENCE_TIMEOUT_MS=30000
MAX_RETRIES=2

# ---- Agent skills / tools (all optional; see apps/api/src/config/skills.ts) ----
# A tool whose provider is unset answers "unavailable: <reason>" to the model and is
# labelled "needs configuration" in the UI - it never returns made-up output.
# TAVILY_API_KEY=""                       # enables web_search (https://tavily.com)
# SANDBOX_RUNNER_URL=""                   # enables code_interpreter + the graph `code` node;
#                                         # an EXTERNAL runner on a PUBLIC address (SSRF-guarded).
#                                         # HTTP contract: apps/api/src/services/skills/sandboxRunner.ts
# SANDBOX_RUNNER_TOKEN=""                 # sent as Authorization: Bearer <token>
# SANDBOX_LANGUAGES="python,javascript"
# SANDBOX_TIMEOUT_MS=15000                # 1000..120000
# SANDBOX_MAX_OUTPUT_BYTES=65536          # per stream
# AGENT_FILES_MAX_BYTES=1048576           # per-agent file storage (file_read/file_write) reuses
# AGENT_FILES_MAX_COUNT=50                # the dataset bucket: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, DATASETS_BUCKET

# ---- OpenClaw ----
OPENCLAW_DEFAULT_IMAGE="wheelsai/openclaw-hardened:latest"
OPENCLAW_SUBDOMAIN_BASE="openclaw.wheelsai.com"

# ---- Token Marketplace (Pump.fun) ----
PUMPFUN_API_KEY=""
TOKEN_INDEXER_INTERVAL_MS=30000

# ---- X402 Payments (optional, disabled by default) ----
X402_ENABLED=false
X402_INFERENCE_MODE="off"
X402_DEFAULT_ASSET="USDC"
X402_SUBMIT_TRANSACTIONS=false
X402_SETTLEMENT_WORKER_ENABLED=false

# =============================================================================
# Everything else the API and web app read. Optional unless noted; the value
# shown is the default. Source of truth: apps/api/src/config/env.ts (plus
# config/nosanaDeploy.ts and config/skills.ts for their sections above).
# See docs/FOUNDER-ACTIONS.md for which accounts and keys unlock what.
# =============================================================================

# --- Public origins, proxies, cookies -----------------------------------------
# PUBLIC_API_URL=""            # absolute API origin: OAuth redirects, Telegram webhooks, endpoints shown to users
# PUBLIC_WEB_URL=""            # absolute web origin: links in emails, listing URLs
# TRUST_PROXY_HOPS=1           # reverse proxies in front of the API (Fly edge = 1)
# RATE_LIMIT_MAX_PER_MINUTE=100 # requests per minute per client across the API (login keeps its own 5/min)
# COOKIE_DOMAIN=""             # e.g. ".wheelsai.app" when web and API are sibling subdomains

# --- Email (verification, password reset, invites, alerts) -------------------
# EMAIL_PROVIDER=""            # "resend" (or "log", development only); unset = email flows answer 501
# RESEND_API_KEY=""
# EMAIL_FROM=""                # e.g. "WheelsAI <no-reply@wheelsai.app>"
# SALES_EMAIL=""               # where Contact Sales requests are emailed (they are also stored)

# --- Stripe (cards, Pro plan) -------------------------------------------------
# STRIPE_PRO_PRICE_ID=""       # recurring Price for the $49/month Pro plan

# --- Object storage (datasets, agent files); S3 or R2 -------------------------
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# DATASETS_BUCKET=""           # all three credentials + bucket must be set, else uploads answer 503

# --- Models and embeddings -----------------------------------------------------
# OPENAI_API_KEY=""
# EMBEDDING_PROVIDER=""        # OpenAI-compatible /embeddings provider; unset = keyword search only
# EMBEDDING_MODEL=""
# EMBEDDING_BACKFILL_INTERVAL_MS=0
# EMBEDDING_BACKFILL_BATCH_SIZE=50

# --- Background workers (0 disables a worker) --------------------------------
# DEPLOYMENT_STATUS_INTERVAL_MS=30000
# SCHEDULER_INTERVAL_MS=30000
# UPTIME_PROBER_INTERVAL_MS=30000
# ALERT_EVALUATOR_INTERVAL_MS=60000
# ANALYTICS_SNAPSHOT_INTERVAL_MS=3600000
# SUBSCRIPTION_RENEWAL_INTERVAL_MS=3600000
# TREASURY_SETTLEMENT_INTERVAL_MS=60000
# TREASURY_SETTLEMENT_BATCH_INTERVAL_MS=300000
# PAYMENT_SUBMIT_INTERVAL_MS=30000
# PAYMENT_POLL_INTERVAL_MS=15000
# PAYMENT_REAP_INTERVAL_MS=120000
# PAYMENT_BATCH_LIMIT=50
# PAYMENT_REAP_MAX_AGE_SECONDS=150
# PAYMENT_REAP_BATCH_LIMIT=100
# FEE_ROUTER_INTERVAL_MS=0             # needs FEE_ROUTER_WALLET_PRIVATE_KEY (funded)
# BAGS_FEE_SWEEP_INTERVAL_MS=0         # only with LAUNCHPAD=bags
# REPUTATION_ATTESTATION_INTERVAL_MS=0 # needs REPUTATION_ATTESTOR_PRIVATE_KEY (whitelisted attestor)
# PAYOUT_EXECUTOR_INTERVAL_MS=0        # needs PAYOUTS_ENABLED=true
# PAYOUT_EXECUTOR_BATCH_SIZE=10

# --- Limits ----------------------------------------------------------------------
# MAX_ACTIVE_DEPLOYMENTS_PER_ORG=5

# --- Payouts and wallet top-ups --------------------------------------------------
# PAYOUTS_ENABLED=false
# PAYOUT_SOL_PRICE_USD=""              # operator-stated quote; required only to settle crypto_sol payouts
# WALLET_TOPUPS_ENABLED=false          # USDC deposit addresses; requires WALLET_MASTER_KEY
# ALLOW_DEVNET_WALLET_TOPUPS=false     # devnet SOL rail; refused in production
# WALLET_TOPUP_SOL_PRICE_USD=""        # operator-stated quote for the devnet SOL rail

# --- Development-only switches (refused in production) ---------------------------
# ALLOW_NOSANA_MOCK=false              # mock Nosana jobs (also needs NODE_ENV=development)
# ALLOW_MOCK_CHECKOUT=false            # grant credits without Stripe

# --- Platform wallets ---------------------------------------------------------------
# FEE_ROUTER_WALLET_PRIVATE_KEY=""
# REPUTATION_ATTESTOR_PRIVATE_KEY=""

# --- Token launchpad ----------------------------------------------------------------
# LAUNCHPAD="pumpfun"                  # or "bags" (mainnet only)
# BAGS_API_KEY=""
# BAGS_FEE_RECIPIENT=""                # a WheelsAI-controlled fee-claimer wallet

# --- x402 settlement and alerts --------------------------------------------------------
# X402_SETTLEMENT_INTERVAL_MS=15000
# X402_SETTLEMENT_BATCH_SIZE=25
# X402_SETTLEMENT_MAX_RETRIES=5
# X402_METRICS_HISTORY_LIMIT=168
# X402_METRICS_RETENTION_DAYS=30
# X402_METRICS_PRUNE_INTERVAL_MINUTES=60
# X402_ALERT_WEBHOOK_URL=""
# X402_ALERT_WEBHOOK_SECRET=""
# X402_ALERT_NOTIFY_COOLDOWN_MINUTES=30
# X402_ALERT_MAX_PENDING=25
# X402_ALERT_MAX_FAILED=15
# X402_ALERT_MAX_RETRIABLE=20
# X402_ALERT_MAX_FAILURE_RATE_PERCENT=20
# X402_ALERT_MAX_OLDEST_PENDING_MINUTES=30

# --- Slack app and GitHub App ------------------------------------------------------------
# SLACK_OAUTH_ENABLED=false
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""
# SLACK_SIGNING_SECRET=""
# GITHUB_APP_ENABLED=false
# GITHUB_APP_ID=""
# GITHUB_APP_SLUG=""
# GITHUB_APP_PRIVATE_KEY=""            # PEM, or base64-encoded PEM
# GITHUB_WEBHOOK_SECRET=""             # at least 16 characters

# --- Operations ----------------------------------------------------------------------------
# STATUS_PAGE_ORG_ID=""                # org whose uptime monitors the public /status page shows
# SENTRY_DSN=""
# METRICS_TOKEN=""                     # bearer token for GET /metrics
# PLATFORM_ADMIN_KEY=""                # marketplace curation (featured listings); at least 16 characters

# --- Web app (apps/web) ----------------------------------------------------------------------
# NEXT_PUBLIC_SOLANA_CLUSTER="devnet"
# NEXT_PUBLIC_SOLANA_RPC_URL=""
# NEXT_PUBLIC_LAUNCHPAD="pumpfun"
# NEXT_PUBLIC_ENABLE_TOKEN_UI=false
# NEXT_PUBLIC_ENABLE_TRADING=false
