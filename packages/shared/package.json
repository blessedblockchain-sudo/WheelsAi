{
  "name": "@wheelsai/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./latency": {
      "types": "./src/latency.ts",
      "default": "./src/latency.ts"
    },
    "./agent-kind": {
      "types": "./src/agentKind.ts",
      "default": "./src/agentKind.ts"
    },
    "./schedule-choice": {
      "types": "./src/scheduleChoice.ts",
      "default": "./src/scheduleChoice.ts"
    },
    "./revenue": {
      "types": "./src/revenue.ts",
      "default": "./src/revenue.ts"
    },
    "./payouts": {
      "types": "./src/payouts.ts",
      "default": "./src/payouts.ts"
    },
    "./ledger": {
      "types": "./src/ledger.ts",
      "default": "./src/ledger.ts"
    },
    "./organization-name": {
      "types": "./src/organizationName.ts",
      "default": "./src/organizationName.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wheelsai/types": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
