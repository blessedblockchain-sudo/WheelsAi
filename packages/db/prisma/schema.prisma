model Orchestration {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  // The workflow's address under /v1 (model "workflow/<slug>"). Set on
  // create from the name; a rename does not change it.
  slug          String
  description   String?

  executionMode String   @map("execution_mode") // 'sequential', 'parallel', 'conditional', 'pipeline'
  maxConcurrency Int     @default(5) @map("max_concurrency")
  timeout       Int      @default(600000)
  retryPolicy   Json?    @map("retry_policy")

  inputSchema   Json?    @map("input_schema")
  outputSchema  Json?    @map("output_schema")

  // Editor canvas state: step positions keyed by step name, and the viewport.
  layout        Json?

