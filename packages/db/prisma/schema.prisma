model TeamInvite {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  email         String
  role          String    @default("member")
  invitedBy     String    @map("invited_by") @db.Uuid
  token         String    @unique
  status        String    @default("pending") // 'pending', 'accepted', 'expired', 'revoked'
  expiresAt     DateTime  @map("expires_at")
  acceptedAt    DateTime? @map("accepted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([orgId, status])
  @@index([email])
  @@map("team_invites")
}

// ============================================
// Visual Agent Builder (Phase 3)
// ============================================

model AgentGraph {
  id            String   @id @default(uuid()) @db.Uuid
  agentId       String   @unique @map("agent_id") @db.Uuid

  // Graph structure
  nodes         Json     @default("[]") // Array of node definitions
  edges         Json     @default("[]") // Array of edge connections
  viewport      Json?    // Saved viewport position/zoom

  // Metadata
  version       Int      @default(1)
  isValid       Boolean  @default(false) @map("is_valid")
  validationErrors Json? @map("validation_errors")

  // Generated code cache
  generatedCode String?  @map("generated_code") @db.Text
  codeLanguage  String?  @map("code_language") // 'typescript', 'python'
  lastGenerated DateTime? @map("last_generated")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executions    AgentGraphExecution[]

  @@map("agent_graphs")
}

// One run of a visual graph through the linear interpreter (W2). The
// builder could draw and compile a graph but nothing executed it; this
// records what actually happened, node by node, so a run is inspectable
// rather than a disappearing response.
model AgentGraphExecution {
  id            String   @id @default(uuid()) @db.Uuid
  graphId       String   @map("graph_id") @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid

  status        String   @default("running") // 'running' | 'completed' | 'failed'
  input         String?  @db.Text
  output        String?  @db.Text
  error         String?  @db.Text
  // Per-node record: type, status (success/failed/refused), timing, and
  // the value that entered and left the node.
  trace         Json     @default("[]")

  startedAt     DateTime @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?     @map("duration_ms")

  graph         AgentGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([agentId, startedAt])
  @@map("agent_graph_executions")
}

// ============================================
// Advanced Analytics (Phase 3)
// ============================================

model AnalyticsSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  snapshotType    String   @map("snapshot_type") // 'daily', 'weekly', 'monthly'
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")

  // Usage metrics
  totalRequests   BigInt   @default(0) @map("total_requests")
  totalTokensIn   BigInt   @default(0) @map("total_tokens_in")
  totalTokensOut  BigInt   @default(0) @map("total_tokens_out")
  totalCostCents  BigInt   @default(0) @map("total_cost_cents")

  // Performance metrics
  // End-to-end time of the day's answered requests, from RequestLatencySample
  // (percentile_disc); NULL for a day with no sample. Percentiles stored
  // before 20261010210000 were means of hourly means and were cleared.
  avgLatencyMs    Float?   @map("avg_latency_ms")
  p50LatencyMs    Float?   @map("p50_latency_ms")
  p95LatencyMs    Float?   @map("p95_latency_ms")
  p99LatencyMs    Float?   @map("p99_latency_ms")
  errorRate       Float?   @map("error_rate")

  // Deployment breakdown
  deploymentStats Json?    @map("deployment_stats") // { [deploymentId]: { requests, tokens, cost } }
  agentStats      Json?    @map("agent_stats") // { [agentId]: { requests, tokens, cost } }
  modelStats      Json?    @map("model_stats") // { [modelId]: { requests, tokens, cost } }

  // Cost breakdown
  costByGpuTier   Json?    @map("cost_by_gpu_tier")
  costByModel     Json?    @map("cost_by_model")

  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([orgId, snapshotType, periodStart])
  @@index([orgId, snapshotType, periodStart])
  @@map("analytics_snapshots")
}

// ============================================
// Monitoring & Alerting (Phase 4)
// ============================================

model AlertChannel {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  type          String   // 'slack', 'discord', 'email', 'webhook', 'pagerduty'

  // Channel configuration (encrypted for webhooks)
  config        Json     // { webhookUrl, email, slackChannel, etc. }

  isEnabled     Boolean  @default(true) @map("is_enabled")
  lastTestedAt  DateTime? @map("last_tested_at")
  lastError     String?  @map("last_error")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  alertRules    AlertRuleChannel[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("alert_channels")
}

model AlertRule {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  name            String
  description     String?

  // Rule type and target
  ruleType        String   @map("rule_type") // 'threshold', 'anomaly', 'uptime', 'budget'
  resourceType    String   @map("resource_type") // 'deployment', 'agent', 'organization'
  resourceId      String?  @map("resource_id") @db.Uuid // null = all resources

  // Condition
  metric          String   // 'error_rate', 'latency_p95', 'request_count', 'cost', 'uptime'
  operator        String   // 'gt', 'gte', 'lt', 'lte', 'eq'
  threshold       Float    // Threshold value
  windowMinutes   Int      @default(5) @map("window_minutes") // Evaluation window

  // Alert settings
  severity        String   @default("warning") // 'info', 'warning', 'critical'
  cooldownMinutes Int      @default(60) @map("cooldown_minutes") // Min time between alerts

  isEnabled       Boolean  @default(true) @map("is_enabled")
  lastTriggeredAt DateTime? @map("last_triggered_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  channels        AlertRuleChannel[]
  alerts          Alert[]

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@index([resourceType, resourceId])
  @@map("alert_rules")
}

model AlertRuleChannel {
  ruleId    String @map("rule_id") @db.Uuid
  channelId String @map("channel_id") @db.Uuid

  rule      AlertRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel   AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
  @@map("alert_rule_channels")
}

model Alert {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  ruleId          String    @map("rule_id") @db.Uuid

  // Alert details
  status          String    @default("active") // 'active', 'acknowledged', 'resolved'
  severity        String    // 'info', 'warning', 'critical'
  title           String
  message         String    @db.Text

  // Context
  resourceType    String    @map("resource_type")
  resourceId      String?   @map("resource_id") @db.Uuid
  metricValue     Float     @map("metric_value") // The value that triggered the alert
  threshold       Float     // The threshold that was breached

  // Timeline
  triggeredAt     DateTime  @default(now()) @map("triggered_at")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  acknowledgedBy  String?   @map("acknowledged_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      String?   @map("resolved_by") @db.Uuid

  // Notification tracking
  notificationsSent Json?   @map("notifications_sent") // { [channelId]: { sentAt, success, error } }

  rule            AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, triggeredAt])
  @@index([ruleId, status])
  @@map("alerts")
}

model UptimeMonitor {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  name            String

  // Target configuration
  targetType      String   @map("target_type") // 'deployment', 'agent', 'custom_url'
  targetId        String?  @map("target_id") @db.Uuid
  targetUrl       String?  @map("target_url") // For custom URLs

  // Check configuration
  checkIntervalSeconds Int @default(60) @map("check_interval_seconds")
  timeoutSeconds  Int      @default(30) @map("timeout_seconds")
  httpMethod      String   @default("GET") @map("http_method")
  expectedStatus  Int      @default(200) @map("expected_status")
  expectedBody    String?  @map("expected_body") // Optional substring to check
  headers         Json?    // Custom headers for the check

  // Status
  isEnabled       Boolean  @default(true) @map("is_enabled")
  currentStatus   String   @default("unknown") @map("current_status") // 'up', 'down', 'degraded', 'unknown'
  lastCheckAt     DateTime? @map("last_check_at")
  lastUpAt        DateTime? @map("last_up_at")
  lastDownAt      DateTime? @map("last_down_at")

  // Stats
  uptimePercent24h Float?  @map("uptime_percent_24h")
  uptimePercent7d  Float?  @map("uptime_percent_7d")
  uptimePercent30d Float?  @map("uptime_percent_30d")
  avgLatencyMs    Float?   @map("avg_latency_ms")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  events          UptimeEvent[]

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@map("uptime_monitors")
}

model UptimeEvent {
  id              String   @id @default(uuid()) @db.Uuid
  monitorId       String   @map("monitor_id") @db.Uuid

  // Check result
  status          String   // 'up', 'down', 'degraded', 'timeout', 'error'
  statusCode      Int?     @map("status_code")
  latencyMs       Int?     @map("latency_ms")
  errorMessage    String?  @map("error_message")

  // Response details
  responseBody    String?  @map("response_body") @db.Text // Stored only on errors
  responseHeaders Json?    @map("response_headers")

  // Location (for distributed checks)
  checkRegion     String?  @map("check_region") // 'us-east', 'eu-west', etc.

  checkedAt       DateTime @default(now()) @map("checked_at")

  monitor         UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@index([monitorId, status])
  @@map("uptime_events")
}

// ============================================
// Agent Versioning (Phase 4)
// ============================================

model AgentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  version       String   // Semantic version: "1.0.0", "1.1.0", etc.
  versionNumber Int      @map("version_number") // Auto-incrementing version number

  // Snapshot of agent configuration at this version
  name          String
  description   String?
  framework     String
  systemPrompt  String?  @map("system_prompt") @db.Text
  tools         Json     @default("[]")
  modelConfig   Json     @map("model_config")
  sourceType    String   @map("source_type")
  sourceUrl     String?  @map("source_url")
  sourceCode    String?  @map("source_code") @db.Text
  env           Json     @default("{}")

  // Graph snapshot (if visual builder was used)
  graphNodes    Json?    @map("graph_nodes")
  graphEdges    Json?    @map("graph_edges")
  // How the agent answered at this version: 'chat' or 'graph'. Null on
  // versions taken before it was recorded.
  entrypoint    String?
  // How the agent was used at this version, and that kind's settings. Null
  // on versions taken before they were recorded.
  agentKind     String?  @map("agent_kind")
  kindConfig    Json?    @map("kind_config")

  // Version metadata
  changeLog     String?  @map("change_log") @db.Text // Description of changes
  changeType    String   @map("change_type") // 'major', 'minor', 'patch'
  tags          String[] @default([])

  // Author: a user, or the API key that acted (a key has no user behind it).
  // The key id is not a relation, so the record survives the key's revocation.
  createdById       String?  @map("created_by_id") @db.Uuid
  createdByApiKeyId String?  @map("created_by_api_key_id") @db.Uuid
  createdByName     String?  @map("created_by_name")

  // Status
  isLatest      Boolean  @default(false) @map("is_latest")
  isPublished   Boolean  @default(false) @map("is_published") // Published to marketplace
  publishedAt   DateTime? @map("published_at")

  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([agentId, version])
  @@unique([agentId, versionNumber])
  @@index([agentId, isLatest])
  @@index([agentId, createdAt])
  @@map("agent_versions")
}

model AgentVersionDiff {
  id              String   @id @default(uuid()) @db.Uuid
  agentId         String   @map("agent_id") @db.Uuid
  fromVersion     String   @map("from_version")
  toVersion       String   @map("to_version")

  // Diff details
  changes         Json     // { field: { from: ..., to: ... }, ... }
  addedFields     String[] @default([]) @map("added_fields")
  removedFields   String[] @default([]) @map("removed_fields")
  modifiedFields  String[] @default([]) @map("modified_fields")

  // Stats
  linesAdded      Int      @default(0) @map("lines_added")
  linesRemoved    Int      @default(0) @map("lines_removed")

  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([agentId, fromVersion, toVersion])
  @@map("agent_version_diffs")
}

// ============================================
// Webhooks & Integrations (Phase 4)
// ============================================

model Webhook {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  description   String?

  // Endpoint configuration
  url           String
  secret        String   // HMAC secret for signature verification

  // Event configuration
  events        String[] @default([]) // 'agent.created', 'agent.deployed', 'deployment.started', etc.

  // Filters
  resourceType  String?  @map("resource_type") // 'agent', 'deployment', 'training', etc.
  resourceId    String?  @map("resource_id") @db.Uuid // Specific resource to watch

  // Settings
  isEnabled     Boolean  @default(true) @map("is_enabled")
  retryCount    Int      @default(3) @map("retry_count")
  timeoutSeconds Int     @default(30) @map("timeout_seconds")
  headers       Json?    // Custom headers to include

  // Status
  lastDeliveredAt DateTime? @map("last_delivered_at")
  lastFailedAt    DateTime? @map("last_failed_at")
  lastError       String?   @map("last_error")
  consecutiveFailures Int   @default(0) @map("consecutive_failures")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deliveries    WebhookDelivery[]

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@index([orgId, events])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  webhookId     String   @map("webhook_id") @db.Uuid

  // Event data
  eventType     String   @map("event_type")
  eventId       String   @map("event_id") // Unique event ID for idempotency
  payload       Json     // The webhook payload

  // Delivery attempt
  attempt       Int      @default(1)
  status        String   @default("pending") // 'pending', 'success', 'failed', 'retrying'

  // Response
  statusCode    Int?     @map("status_code")
  responseBody  String?  @map("response_body") @db.Text
  responseTimeMs Int?    @map("response_time_ms")
  errorMessage  String?  @map("error_message")

  // Timing
  scheduledAt   DateTime @default(now()) @map("scheduled_at")
  deliveredAt   DateTime? @map("delivered_at")
  nextRetryAt   DateTime? @map("next_retry_at")

  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([webhookId, eventId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model Integration {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  type          String   // 'slack', 'discord', 'github', 'zapier', 'make', 'n8n'
  name          String

  // OAuth credentials (encrypted)
  accessToken   Bytes?   @map("access_token")
  refreshToken  Bytes?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")

  // Integration-specific config
  config        Json     @default("{}") // { workspace, channel, repo, etc. }
  scopes        String[] @default([])

  // Status
  isEnabled     Boolean  @default(true) @map("is_enabled")
  isConnected   Boolean  @default(false) @map("is_connected")
  lastSyncAt    DateTime? @map("last_sync_at")
  lastError     String?  @map("last_error")

  // Metadata
  externalId    String?  @map("external_id") // ID in the external system
  externalName  String?  @map("external_name") // Name in the external system

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([orgId, type, name])
  @@index([orgId, type])
  @@index([orgId, isEnabled])
  @@map("integrations")
}

model IntegrationEvent {
  id              String   @id @default(uuid()) @db.Uuid
  integrationId   String   @map("integration_id") @db.Uuid

  // Event details
  eventType       String   @map("event_type") // 'sync', 'action', 'notification'
  action          String   // 'send_message', 'create_issue', 'trigger_workflow', etc.

  // Payload
  inputPayload    Json?    @map("input_payload")
  outputPayload   Json?    @map("output_payload")

  // Status
  status          String   @default("pending") // 'pending', 'success', 'failed'
  errorMessage    String?  @map("error_message")

  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([integrationId, createdAt])
  @@index([integrationId, status])
  @@map("integration_events")
}

// ============================================
// Testing Framework (Phase 4)
// ============================================

model TestSuite {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  name          String
  description   String?

  // Test configuration
  timeout       Int      @default(30000) // Timeout per test in ms
  retries       Int      @default(0) // Number of retries on failure
  parallel      Boolean  @default(false) // Run tests in parallel

  // Metadata
  tags          String[] @default([])
  isEnabled     Boolean  @default(true) @map("is_enabled")

  // Stats
  totalTests    Int      @default(0) @map("total_tests")
  lastRunAt     DateTime? @map("last_run_at")
  lastStatus    String?   @map("last_status") // 'passed', 'failed', 'partial'
  passRate      Float?    @map("pass_rate") // Percentage of passing tests

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  testCases     TestCase[]
  testRuns      TestRun[]

  @@unique([orgId, agentId, name])
  @@index([orgId, agentId])
  @@index([orgId, isEnabled])
  @@map("test_suites")
}

model TestCase {
  id            String   @id @default(uuid()) @db.Uuid
  suiteId       String   @map("suite_id") @db.Uuid
  name          String
  description   String?

  // Test input
  inputType     String   @map("input_type") // 'message', 'conversation', 'api'
  input         Json     // { messages: [], params: {} } or single message

  // Expected output
  assertionType String   @map("assertion_type") // 'exact', 'contains', 'regex', 'semantic', 'json_schema', 'function'
  expected      Json     // Expected value or pattern
  tolerance     Float?   // For semantic similarity (0-1)

  // Test metadata
  priority      Int      @default(0) // Higher = run first
  tags          String[] @default([])
  isEnabled     Boolean  @default(true) @map("is_enabled")

  // Custom assertions
  customScript  String?  @map("custom_script") @db.Text // JavaScript assertion function

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  suite         TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  results       TestResult[]

  @@unique([suiteId, name])
  @@index([suiteId, isEnabled])
  @@map("test_cases")
}

model TestRun {
  id            String   @id @default(uuid()) @db.Uuid
  suiteId       String   @map("suite_id") @db.Uuid

  // Run configuration
  agentVersion  String?  @map("agent_version") // Version tested
  deploymentId  String?  @map("deployment_id") @db.Uuid // Which deployment was tested

  // Status
  status        String   @default("pending") // 'pending', 'running', 'completed', 'failed', 'cancelled'
  progress      Int      @default(0) // 0-100

  // Results summary
  totalTests    Int      @default(0) @map("total_tests")
  passedTests   Int      @default(0) @map("passed_tests")
  failedTests   Int      @default(0) @map("failed_tests")
  skippedTests  Int      @default(0) @map("skipped_tests")
  passRate      Float?   @map("pass_rate")

  // Timing
  totalDurationMs Int?   @map("total_duration_ms")

  // Trigger info
  triggeredBy   String?  @map("triggered_by") // 'manual', 'ci', 'scheduled', 'deployment'
  triggeredById String?  @map("triggered_by_id") @db.Uuid

  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  suite         TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  results       TestResult[]

  @@index([suiteId, status])
  @@index([suiteId, createdAt])
  @@map("test_runs")
}

model TestResult {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  testCaseId    String   @map("test_case_id") @db.Uuid

  // Result
  status        String   // 'passed', 'failed', 'skipped', 'error'
  durationMs    Int?     @map("duration_ms")

  // Output
  actualOutput  Json?    @map("actual_output") // What the agent returned
  error         String?  // Error message if failed

  // Assertion details
  assertionResult Json?  @map("assertion_result") // { passed: boolean, details: string, score?: number }

  // Retry info
  attempt       Int      @default(1)

  createdAt     DateTime @default(now()) @map("created_at")

  run           TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([testCaseId])
  @@map("test_results")
}

// ============================================
// Conversation Memory (Phase 4)
// ============================================

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  agentId       String?  @map("agent_id") @db.Uuid
  deploymentId  String?  @map("deployment_id") @db.Uuid

  // Session info
  sessionId     String   @map("session_id") // External session identifier
  userId        String?  @map("user_id") // External user identifier

  // Metadata
  title         String?  // Auto-generated or manual title
  tags          String[] @default([])
  metadata      Json?    // Custom metadata

  // Status
  status        String   @default("active") // 'active', 'archived', 'deleted'
  messageCount  Int      @default(0) @map("message_count")
  tokenCount    Int      @default(0) @map("token_count")

  // Timestamps
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  messages      Message[]
  memories      MemoryContext[]

  @@unique([orgId, sessionId])
  @@index([orgId, agentId])
  @@index([orgId, status])
  @@index([orgId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid

  // Message content
  role            String   // 'user', 'assistant', 'system', 'function', 'tool'
  content         String   @db.Text
  name            String?  // For function/tool messages

  // Function/tool calls
  functionCall    Json?    @map("function_call") // { name, arguments }
  toolCalls       Json?    @map("tool_calls") // Array of tool calls
  toolCallId      String?  @map("tool_call_id") // For tool responses

  // Metadata
  tokens          Int      @default(0) // Token count for this message
  metadata        Json?    // Custom metadata (latency, model used, etc.)

  // Ordering
  sequenceNum     Int      @map("sequence_num")

  createdAt       DateTime @default(now()) @map("created_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequenceNum])
  @@index([conversationId, role])
  @@map("messages")
}

model MemoryContext {
  id              String   @id @default(uuid()) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid

  // Memory type
  type            String   // 'summary', 'fact', 'preference', 'entity', 'custom'
  key             String?  // Key for key-value memories

  // Content
  content         String   @db.Text // The actual memory content
  // pgvector column (W2 RAG) — same unspecified-dimension reasoning as
  // document_chunks.embedding_vec. Replaces a `Bytes?` column that had
  // zero writers.
  embeddingVec    Unsupported("vector")?  @map("embedding_vec")
  embeddingModel  String?  @map("embedding_model")
  embeddingDims   Int?     @map("embedding_dims")
  embeddedAt      DateTime? @map("embedded_at")

  // Importance and decay
  importance      Float    @default(0.5) // 0-1 importance score
  accessCount     Int      @default(0) @map("access_count")
  lastAccessedAt  DateTime? @map("last_accessed_at")

  // Source tracking
  sourceMessageId String?  @map("source_message_id") @db.Uuid
  sourceRange     Json?    @map("source_range") // { start: sequenceNum, end: sequenceNum }

  // Status
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, type])
  @@index([conversationId, isActive])
  @@index([conversationId, importance])
  @@map("memory_contexts")
}

// ============================================
// Custom Domains (Phase 4)
// ============================================

model CustomDomain {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid

  // Domain configuration. `domain` is NOT globally unique: several
  // organisations may hold a pending claim on one name, so an unverified claim
  // can never block the real owner. The claim that counts is verifiedDomain.
  domain         String // e.g., "api.example.com" (normalised: lowercase, punycode)
  subdomain       String?  // Optional subdomain
  rootDomain      String   @map("root_domain") // e.g., "example.com"
  // Equals `domain` only while this row is verified; unique, so the first
  // organisation to prove ownership holds the name. Cleared on expiry,
  // re-verification and delete. The edge and the router look hosts up here.
  verifiedDomain String? @unique @map("verified_domain")

  // Target resource
  targetType      String   @map("target_type") // 'agent', 'deployment'
  targetId        String   @map("target_id") @db.Uuid

  // DNS verification
  // 'pending' | 'verified' | 'expired'. A resolver error never changes it
  // ('failed' is no longer written). 'expired' = never verified within 14
  // days, or the TXT record was gone for 72 hours.
  verificationStatus    String    @default("pending") @map("verification_status")
  verificationToken String @unique @map("verification_token") // DNS TXT record value
  verificationMethod String @default("dns_txt") @map("verification_method") // 'dns_txt', 'dns_cname', 'http'
  verifiedAt      DateTime? @map("verified_at")
  lastCheckedAt   DateTime? @map("last_checked_at")
  verificationError String? @map("verification_error")
  // Start of the 14 days a pending claim has to verify (reset on re-verify).
  verificationStartedAt DateTime  @default(now()) @map("verification_started_at")
  // When a verified domain's TXT record was first seen missing; the domain
  // keeps serving for 72 hours from here, then expires.
  verificationLostAt    DateTime? @map("verification_lost_at")

  // DNS routing, as observed: do all of the domain's addresses belong to the edge?
  routingStatus     String    @default("pending") @map("routing_status") // 'pending' | 'ok' | 'misrouted' | 'unresolvable'
  // Consecutive not-ok observations of a routed domain; one bad answer does not flip it.
  routingFailures   Int       @default(0) @map("routing_failures")
  routingCheckedAt  DateTime? @map("routing_checked_at")
  routingError      String?   @map("routing_error")
  observedAddresses String[]  @default([]) @map("observed_addresses")
  isApex            Boolean?  @map("is_apex") // zone apex (SOA at the name): needs A/AAAA, not a CNAME

  // SSL certificate. Every field here is written ONLY from a TLS handshake the
  // checker made with the edge - never from a timer or an assumption.
  // 'pending' (not attempted) | 'provisioning' (verified and routed, waiting
  // for the edge to present a valid certificate) | 'active' (valid certificate
  // observed) | 'failed' | 'expired' (an expired certificate was observed)
  sslStatus            String    @default("pending") @map("ssl_status")
  sslProvider          String?   @map("ssl_provider") // 'edge_acme' | 'custom' (unused)
  sslExpiresAt    DateTime? @map("ssl_expires_at")
  sslError        String?  @map("ssl_error")
  sslCheckedAt         DateTime? @map("ssl_checked_at")
  sslValidFrom         DateTime? @map("ssl_valid_from")
  sslIssuer            String?   @map("ssl_issuer")
  sslFingerprint256    String?   @map("ssl_fingerprint256")
  sslFailures          Int       @default(0) @map("ssl_failures") // consecutive failed handshakes
  sslProvisioningSince DateTime? @map("ssl_provisioning_since")

  // Custom SSL (for custom certificates)
  customCert      Bytes?   @map("custom_cert") // Encrypted
  customKey       Bytes?   @map("custom_key") // Encrypted
  customCertChain Bytes?   @map("custom_cert_chain") // Encrypted

  // Routing configuration
  routingMode     String   @default("proxy") @map("routing_mode") // 'proxy', 'redirect'
  forceHttps      Boolean  @default(true) @map("force_https")
  headers         Json?    // Custom headers to add

  // Status. `enabled` is what the owner asked for. `isActive` is DERIVED
  // ("serving") and written only by the check core: enabled AND verified AND
  // routed AND certificate active AND plan entitled AND target present.
  enabled      Boolean   @default(true)
  isActive        Boolean  @default(false) @map("is_active")
  // Why it is not serving: 'disabled' | 'plan_inactive' | 'target_missing' |
  // 'verification_lost' | 'dns_not_routed' | 'certificate_invalid'
  pausedReason String?   @map("paused_reason")
  isPrimary       Boolean  @default(false) @map("is_primary") // Primary domain for the target
  // When the checker looks at this row again; null = never (expired claims).
  nextCheckAt  DateTime? @map("next_check_at")

  // Analytics
  totalRequests   BigInt   @default(0) @map("total_requests")
  lastRequestAt   DateTime? @map("last_request_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([orgId, domain])
  @@index([domain])
  @@index([orgId, targetType, targetId])
  @@index([verificationStatus])
  @@index([sslStatus])
  @@index([isActive])
  @@index([nextCheckAt])
  @@index([orgId, nextCheckAt])
  @@map("custom_domains")
}

// One "yes, obtain a certificate" the API gave the edge for a hostname that had
// no observed certificate. Counted per name, organization and platform before
// the next one is given. No relation to CustomDomain on purpose: deleting a
// domain must not give its organization the budget back.
model CustomDomainIssuanceGrant {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  domain    String
  grantedAt DateTime @default(now()) @map("granted_at")

  @@index([grantedAt])
  @@index([orgId, grantedAt])
  @@index([domain, grantedAt])
  @@map("custom_domain_issuance_grants")
}

model DomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  domainId      String   @map("domain_id") @db.Uuid

  // Event details
  // 'created', 'verification_success', 'verification_lost', 'verification_restored',
  // 'verification_expired', 'claimed_elsewhere', 'routing_ok', 'routing_lost',
  // 'ssl_provisioning', 'ssl_observed', 'ssl_renewed', 'ssl_invalid', 'ssl_status_reset',
  // 'plan_paused', 'plan_resumed', 'target_missing', 'serving_started', 'serving_stopped',
  // 'activated', 'deactivated', 'reverification_started'
  eventType String  @map("event_type")
  message       String?
  details       Json?    // Additional event details

  // Status at time of event
  previousStatus String?  @map("previous_status")
  newStatus     String?  @map("new_status")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([domainId, createdAt])
  @@index([domainId, eventType])
  @@map("domain_events")
}

// ============================================
// Scheduled Tasks / Cron Jobs (Phase 5)
// ============================================

model ScheduledTask {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  // Each task type decides whether it needs an agent.
  agentId       String?  @map("agent_id") @db.Uuid
  // The workflow a workflow_run task starts.
  orchestrationId String? @map("orchestration_id") @db.Uuid
  name          String
  description   String?

  // Schedule configuration
  scheduleType  String   @map("schedule_type") // 'cron', 'interval', 'once'
  cronExpression String? @map("cron_expression")
  intervalSeconds Int?   @map("interval_seconds")
  scheduledAt   DateTime? @map("scheduled_at")
  timezone      String   @default("UTC")

  // Task configuration
  taskType      String   @map("task_type") // agent_run|inference|webhook|data_sync|health_check|report|cleanup|custom|workflow_run
  payload       Json     @default("{}")
  timeout       Int      @default(300000)
  maxRetries    Int      @default(3) @map("max_retries")

  // Status
  isEnabled     Boolean  @default(true) @map("is_enabled")
  status        String   @default("active") // 'active', 'paused', 'completed', 'failed', 'disabled'

  // Execution tracking
  lastRunAt     DateTime? @map("last_run_at")
  lastRunStatus String?  @map("last_run_status")
  lastRunDurationMs Int? @map("last_run_duration_ms")
  lastError     String?  @map("last_error")
  nextRunAt     DateTime? @map("next_run_at")
  totalRuns     Int      @default(0) @map("total_runs")
  successfulRuns Int     @default(0) @map("successful_runs")
  failedRuns    Int      @default(0) @map("failed_runs")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  executions    TaskExecution[]
  // Cascade: a task goes with its agent, history included. Before this
  // relation agent_id was a bare column and a deleted agent's tasks kept
  // firing.
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orchestration Orchestration? @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@index([nextRunAt, isEnabled])
  @@index([status])
  @@index([agentId])
  @@index([orchestrationId])
  @@map("scheduled_tasks")
}

model TaskExecution {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid

  status        String   @default("pending") // 'pending', 'running', 'success', 'failed', 'timeout', 'cancelled'
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?     @map("duration_ms")

  input         Json?
  output        Json?
  error         String?
  logs          String?  @db.Text
  // Where the result of a finished agent_run was sent, and how that went: a
  // list of { channelId, name, type, status: sent | failed | skipped,
  // reason?, at } (services/scheduledTasks/resultDelivery.ts). Null: nothing
  // was asked to be sent. A delivery never changes `status` above.
  delivery      Json?

  attempt       Int      @default(1)
  nextRetryAt   DateTime? @map("next_retry_at")

  triggeredBy   String   @default("scheduler") @map("triggered_by")

  // The workflow run a workflow_run execution started; that run's worker
  // finishes this row.
  orchestrationExecutionId String? @unique @map("orchestration_execution_id") @db.Uuid

  createdAt     DateTime @default(now()) @map("created_at")

  task          ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([taskId, createdAt])
  @@index([status, startedAt])
  @@map("task_executions")
}

// ============================================
// RAG / Knowledge Base (Phase 5)
// ============================================

model KnowledgeBase {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  description   String?

  embeddingModel String  @default("text-embedding-ada-002") @map("embedding_model")
  chunkSize     Int      @default(512) @map("chunk_size")
  chunkOverlap  Int      @default(50) @map("chunk_overlap")

  status        String   @default("active")

  totalDocuments Int     @default(0) @map("total_documents")
  totalChunks   Int      @default(0) @map("total_chunks")
  totalSizeBytes BigInt  @default(0) @map("total_size_bytes")

  // Legacy denormalized list with no foreign key — superseded by the
  // Agent.knowledgeBaseId relation below, which the RAG path reads.
  agentIds      String[] @default([]) @map("agent_ids")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  documents     KnowledgeDocument[]
  groundedAgents Agent[] @relation("AgentKnowledgeBase")

  @@unique([orgId, name])
  @@index([orgId])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String   @id @default(uuid()) @db.Uuid
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid

  title           String
  fileName        String?  @map("file_name")
  mimeType        String?  @map("mime_type")
  sourceUrl       String?  @map("source_url")
  sourceType      String   @map("source_type")

  rawContent      String?  @map("raw_content") @db.Text
  sizeBytes       BigInt   @default(0) @map("size_bytes")

  status          String   @default("pending")
  processingError String?  @map("processing_error")
  processedAt     DateTime? @map("processed_at")

  chunkCount      Int      @default(0) @map("chunk_count")

  metadata        Json?
  tags            String[] @default([])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]

  @@index([knowledgeBaseId, status])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid

  content         String   @db.Text
  chunkIndex      Int      @map("chunk_index")

  // pgvector column (W2 RAG). Deliberately UNSPECIFIED dimension: the
  // embedding model is operator-configurable (768/1536/3072 all exist),
  // and pinning a dimension here would force a migration to change model.
  // The cost is exact sequential cosine search instead of an ANN index —
  // correct, and fine at current scale. Pin the dimension and add an HNSW
  // index once a model is settled on.
  // The previous `embedding Bytes?` column is gone: it had zero writers
  // and zero rows, and two embedding columns invites "which one is real?".
  embeddingVec    Unsupported("vector")?  @map("embedding_vec")
  embeddingModel  String?  @map("embedding_model")
  embeddingDims   Int?     @map("embedding_dims")
  embeddedAt      DateTime? @map("embedded_at")

  metadata        Json?
  tokenCount      Int      @default(0) @map("token_count")

  createdAt       DateTime @default(now()) @map("created_at")

  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@map("document_chunks")
}

// ============================================
// Multi-Agent Orchestration (Phase 5)
