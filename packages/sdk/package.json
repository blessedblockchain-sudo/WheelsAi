{
  "name": "@wheelsai/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed TypeScript client for the WheelsAI API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "clean": "rm -rf dist .test-build"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
