{
  "name": "@wheelsai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test:x402": "tsx --test src/tests/x402.integration.test.ts",
    "test:wallet-auth": "tsx --test src/tests/wallet-auth.integration.test.ts",
    "test:nosana": "tsx --test src/tests/nosana.integration.test.ts",
    "test:unit": "tsx --test src/tests/*.unit.test.ts",
    "test:integration": "tsx --test src/tests/*.integration.test.ts",
    "test": "tsx --test src/tests/*.unit.test.ts src/tests/*.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.966.0",
    "@aws-sdk/s3-request-presigner": "^3.966.0",
    "@bagsfm/bags-sdk": "^1.3.7",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@mastra/core": "^1.10.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.12",
    "@noble/ed25519": "^2.0.0",
    "@nosana/sdk": "0.4.74",
    "@sentry/node": "^10.69.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.87.6",
    "@trpc/server": "^11.0.0-rc.0",
    "@wheelsai/db": "*",
    "@wheelsai/shared": "*",
    "@wheelsai/types": "*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "bs58": "^5.0.0",
    "bullmq": "^5.1.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "ioredis": "^5.3.2",
    "luxon": "^3.7.2",
    "nanoid": "^5.0.4",
    "pino": "^8.17.2",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "re2js": "^1.3.3",
    "stripe": "^14.12.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "openai": "^7.28.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
