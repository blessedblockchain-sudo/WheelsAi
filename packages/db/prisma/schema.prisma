  deploymentStats Json?    @map("deployment_stats") // { [deploymentId]: { requests, tokens, cost } }
  agentStats      Json?    @map("agent_stats") // { [agentId]: { requests, tokens, cost } }
  modelStats      Json?    @map("model_stats") // { [modelId]: { requests, tokens, cost } }

