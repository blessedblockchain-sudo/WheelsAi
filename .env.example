# ===========================================
# WheelsAI Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://wheelsai:wheelsai@localhost:5434/wheelsai?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6380"

# ---- Web App (Next.js) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- API Server ----
API_PORT=4000
API_HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:3000"

# ---- Auth ----
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# ---- Encryption (required in production, falls back to JWT_SECRET in dev) ----
# ENCRYPTION_KEY=""

# ---- Agent Wallet Encryption ----
WALLET_MASTER_KEY=""

# ---- Solana / Nosana ----
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"
NOSANA_WALLET_PRIVATE_KEY=""
TREASURY_WALLET_ADDRESS="11111111111111111111111111111111"

# ---- Free Model Providers (get free keys at each provider's console) ----
GROQ_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
TOGETHER_API_KEY=""
FREE_TIER_RPM=20
FREE_TIER_RPD=200

# ---- GitHub Import (optional, for private repos) ----
# GITHUB_TOKEN=""

# ---- Stripe (Payments — simulated in development) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- IPFS ----
PINATA_API_KEY=""
PINATA_SECRET_KEY=""

# ---- Inference ----
INFERENCE_TIMEOUT_MS=30000
MAX_RETRIES=2

# ---- OpenClaw ----
OPENCLAW_DEFAULT_IMAGE="wheelsai/openclaw-hardened:latest"
OPENCLAW_SUBDOMAIN_BASE="openclaw.wheelsai.com"

# ---- Token Marketplace (Pump.fun) ----
PUMPFUN_API_KEY=""
TOKEN_INDEXER_INTERVAL_MS=30000

# ---- X402 Payments (optional, disabled by default) ----
X402_ENABLED=false
X402_INFERENCE_MODE="off"
X402_DEFAULT_ASSET="USDC"
X402_SUBMIT_TRANSACTIONS=false
X402_SETTLEMENT_WORKER_ENABLED=false
