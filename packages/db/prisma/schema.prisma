// ============================================
// Monitoring & Alerting (Phase 4)
// ============================================

model AlertChannel {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  type          String   // 'slack', 'discord', 'email', 'webhook', 'pagerduty'

  // Channel configuration (encrypted for webhooks)
  config        Json     // { webhookUrl, email, slackChannel, etc. }

  isEnabled     Boolean  @default(true) @map("is_enabled")
  lastTestedAt  DateTime? @map("last_tested_at")
  lastError     String?  @map("last_error")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  alertRules    AlertRuleChannel[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("alert_channels")
}

model AlertRule {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  name            String
  description     String?

  // Rule type and target
  ruleType        String   @map("rule_type") // 'threshold', 'anomaly', 'uptime', 'budget'
  resourceType    String   @map("resource_type") // 'deployment', 'agent', 'organization'
  resourceId      String?  @map("resource_id") @db.Uuid // null = all resources

  // Condition
  metric          String   // 'error_rate', 'latency_p95', 'request_count', 'cost', 'uptime'
  operator        String   // 'gt', 'gte', 'lt', 'lte', 'eq'
  threshold       Float    // Threshold value
  windowMinutes   Int      @default(5) @map("window_minutes") // Evaluation window

  // Alert settings
  severity        String   @default("warning") // 'info', 'warning', 'critical'
  cooldownMinutes Int      @default(60) @map("cooldown_minutes") // Min time between alerts

  isEnabled       Boolean  @default(true) @map("is_enabled")
  lastTriggeredAt DateTime? @map("last_triggered_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  channels        AlertRuleChannel[]
  alerts          Alert[]

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@index([resourceType, resourceId])
  @@map("alert_rules")
}

model AlertRuleChannel {
  ruleId    String @map("rule_id") @db.Uuid
  channelId String @map("channel_id") @db.Uuid

  rule      AlertRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel   AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
  @@map("alert_rule_channels")
}

model Alert {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  ruleId          String    @map("rule_id") @db.Uuid

  // Alert details
  status          String    @default("active") // 'active', 'acknowledged', 'resolved'
  severity        String    // 'info', 'warning', 'critical'
  title           String
  message         String    @db.Text

  // Context
  resourceType    String    @map("resource_type")
  resourceId      String?   @map("resource_id") @db.Uuid
  metricValue     Float     @map("metric_value") // The value that triggered the alert
  threshold       Float     // The threshold that was breached

  // Timeline
  triggeredAt     DateTime  @default(now()) @map("triggered_at")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  acknowledgedBy  String?   @map("acknowledged_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      String?   @map("resolved_by") @db.Uuid

  // Notification tracking
  notificationsSent Json?   @map("notifications_sent") // { [channelId]: { sentAt, success, error } }

  rule            AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, triggeredAt])
  @@index([ruleId, status])
  @@map("alerts")
}

model UptimeMonitor {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  name            String

  // Target configuration
  targetType      String   @map("target_type") // 'deployment', 'agent', 'custom_url'
  targetId        String?  @map("target_id") @db.Uuid
  targetUrl       String?  @map("target_url") // For custom URLs

  // Check configuration
  checkIntervalSeconds Int @default(60) @map("check_interval_seconds")
  timeoutSeconds  Int      @default(30) @map("timeout_seconds")
  httpMethod      String   @default("GET") @map("http_method")
  expectedStatus  Int      @default(200) @map("expected_status")
  expectedBody    String?  @map("expected_body") // Optional substring to check
  headers         Json?    // Custom headers for the check

  // Status
  isEnabled       Boolean  @default(true) @map("is_enabled")
  currentStatus   String   @default("unknown") @map("current_status") // 'up', 'down', 'degraded', 'unknown'
  lastCheckAt     DateTime? @map("last_check_at")
  lastUpAt        DateTime? @map("last_up_at")
  lastDownAt      DateTime? @map("last_down_at")

  // Stats
  uptimePercent24h Float?  @map("uptime_percent_24h")
  uptimePercent7d  Float?  @map("uptime_percent_7d")
  uptimePercent30d Float?  @map("uptime_percent_30d")
  avgLatencyMs    Float?   @map("avg_latency_ms")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  events          UptimeEvent[]

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@map("uptime_monitors")
}

model UptimeEvent {
  id              String   @id @default(uuid()) @db.Uuid
  monitorId       String   @map("monitor_id") @db.Uuid

  // Check result
  status          String   // 'up', 'down', 'degraded', 'timeout', 'error'
  statusCode      Int?     @map("status_code")
  latencyMs       Int?     @map("latency_ms")
  errorMessage    String?  @map("error_message")

  // Response details
  responseBody    String?  @map("response_body") @db.Text // Stored only on errors
  responseHeaders Json?    @map("response_headers")

  // Location (for distributed checks)
  checkRegion     String?  @map("check_region") // 'us-east', 'eu-west', etc.

  checkedAt       DateTime @default(now()) @map("checked_at")

  monitor         UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@index([monitorId, status])
  @@map("uptime_events")
}

// ============================================
// Agent Versioning (Phase 4)
// ============================================

model AgentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  version       String   // Semantic version: "1.0.0", "1.1.0", etc.
  versionNumber Int      @map("version_number") // Auto-incrementing version number

  // Snapshot of agent configuration at this version
  name          String
  description   String?
  framework     String
  systemPrompt  String?  @map("system_prompt") @db.Text
  tools         Json     @default("[]")
  modelConfig   Json     @map("model_config")
  sourceType    String   @map("source_type")
  sourceUrl     String?  @map("source_url")
  sourceCode    String?  @map("source_code") @db.Text
  env           Json     @default("{}")

  // Graph snapshot (if visual builder was used)
  graphNodes    Json?    @map("graph_nodes")
  graphEdges    Json?    @map("graph_edges")

  // Version metadata
  changeLog     String?  @map("change_log") @db.Text // Description of changes
  changeType    String   @map("change_type") // 'major', 'minor', 'patch'
  tags          String[] @default([])

  // Author
  createdById   String   @map("created_by_id") @db.Uuid
  createdByName String?  @map("created_by_name")

  // Status
  isLatest      Boolean  @default(false) @map("is_latest")
  isPublished   Boolean  @default(false) @map("is_published") // Published to marketplace
  publishedAt   DateTime? @map("published_at")

  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([agentId, version])
  @@unique([agentId, versionNumber])
  @@index([agentId, isLatest])
  @@index([agentId, createdAt])
  @@map("agent_versions")
}

model AgentVersionDiff {
  id              String   @id @default(uuid()) @db.Uuid
  agentId         String   @map("agent_id") @db.Uuid
  fromVersion     String   @map("from_version")
  toVersion       String   @map("to_version")

  // Diff details
  changes         Json     // { field: { from: ..., to: ... }, ... }
  addedFields     String[] @default([]) @map("added_fields")
  removedFields   String[] @default([]) @map("removed_fields")
  modifiedFields  String[] @default([]) @map("modified_fields")

  // Stats
  linesAdded      Int      @default(0) @map("lines_added")
  linesRemoved    Int      @default(0) @map("lines_removed")

  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([agentId, fromVersion, toVersion])
  @@map("agent_version_diffs")
}

// ============================================
// Webhooks & Integrations (Phase 4)
// ============================================

model Webhook {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  description   String?

  // Endpoint configuration
  url           String
  secret        String   // HMAC secret for signature verification

  // Event configuration
  events        String[] @default([]) // 'agent.created', 'agent.deployed', 'deployment.started', etc.

  // Filters
  resourceType  String?  @map("resource_type") // 'agent', 'deployment', 'training', etc.
  resourceId    String?  @map("resource_id") @db.Uuid // Specific resource to watch

  // Settings
  isEnabled     Boolean  @default(true) @map("is_enabled")
  retryCount    Int      @default(3) @map("retry_count")
  timeoutSeconds Int     @default(30) @map("timeout_seconds")
  headers       Json?    // Custom headers to include

  // Status
  lastDeliveredAt DateTime? @map("last_delivered_at")
  lastFailedAt    DateTime? @map("last_failed_at")
  lastError       String?   @map("last_error")
  consecutiveFailures Int   @default(0) @map("consecutive_failures")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deliveries    WebhookDelivery[]

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@index([orgId, events])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  webhookId     String   @map("webhook_id") @db.Uuid

  // Event data
  eventType     String   @map("event_type")
  eventId       String   @map("event_id") // Unique event ID for idempotency
  payload       Json     // The webhook payload

  // Delivery attempt
  attempt       Int      @default(1)
  status        String   @default("pending") // 'pending', 'success', 'failed', 'retrying'

  // Response
  statusCode    Int?     @map("status_code")
  responseBody  String?  @map("response_body") @db.Text
  responseTimeMs Int?    @map("response_time_ms")
  errorMessage  String?  @map("error_message")

  // Timing
  scheduledAt   DateTime @default(now()) @map("scheduled_at")
  deliveredAt   DateTime? @map("delivered_at")
  nextRetryAt   DateTime? @map("next_retry_at")

  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@index([webhookId, eventId])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model Integration {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  type          String   // 'slack', 'discord', 'github', 'zapier', 'make', 'n8n'
  name          String

  // OAuth credentials (encrypted)
  accessToken   Bytes?   @map("access_token")
  refreshToken  Bytes?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")

  // Integration-specific config
  config        Json     @default("{}") // { workspace, channel, repo, etc. }
  scopes        String[] @default([])

  // Status
  isEnabled     Boolean  @default(true) @map("is_enabled")
  isConnected   Boolean  @default(false) @map("is_connected")
  lastSyncAt    DateTime? @map("last_sync_at")
  lastError     String?  @map("last_error")

  // Metadata
  externalId    String?  @map("external_id") // ID in the external system
  externalName  String?  @map("external_name") // Name in the external system

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([orgId, type, name])
  @@index([orgId, type])
  @@index([orgId, isEnabled])
  @@map("integrations")
}

model IntegrationEvent {
  id              String   @id @default(uuid()) @db.Uuid
  integrationId   String   @map("integration_id") @db.Uuid

  // Event details
  eventType       String   @map("event_type") // 'sync', 'action', 'notification'
  action          String   // 'send_message', 'create_issue', 'trigger_workflow', etc.

  // Payload
  inputPayload    Json?    @map("input_payload")
  outputPayload   Json?    @map("output_payload")

  // Status
  status          String   @default("pending") // 'pending', 'success', 'failed'
  errorMessage    String?  @map("error_message")

  createdAt       DateTime @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@index([integrationId, createdAt])
  @@index([integrationId, status])
  @@map("integration_events")
}

// ============================================
// Testing Framework (Phase 4)
// ============================================

model TestSuite {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  name          String
  description   String?

  // Test configuration
  timeout       Int      @default(30000) // Timeout per test in ms
  retries       Int      @default(0) // Number of retries on failure
  parallel      Boolean  @default(false) // Run tests in parallel

  // Metadata
  tags          String[] @default([])
  isEnabled     Boolean  @default(true) @map("is_enabled")

  // Stats
  totalTests    Int      @default(0) @map("total_tests")
  lastRunAt     DateTime? @map("last_run_at")
  lastStatus    String?   @map("last_status") // 'passed', 'failed', 'partial'
  passRate      Float?    @map("pass_rate") // Percentage of passing tests

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  testCases     TestCase[]
  testRuns      TestRun[]

  @@unique([orgId, agentId, name])
  @@index([orgId, agentId])
  @@index([orgId, isEnabled])
  @@map("test_suites")
}

model TestCase {
  id            String   @id @default(uuid()) @db.Uuid
  suiteId       String   @map("suite_id") @db.Uuid
  name          String
  description   String?

  // Test input
  inputType     String   @map("input_type") // 'message', 'conversation', 'api'
  input         Json     // { messages: [], params: {} } or single message

  // Expected output
  assertionType String   @map("assertion_type") // 'exact', 'contains', 'regex', 'semantic', 'json_schema', 'function'
  expected      Json     // Expected value or pattern
  tolerance     Float?   // For semantic similarity (0-1)

  // Test metadata
  priority      Int      @default(0) // Higher = run first
  tags          String[] @default([])
  isEnabled     Boolean  @default(true) @map("is_enabled")

  // Custom assertions
  customScript  String?  @map("custom_script") @db.Text // JavaScript assertion function

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  suite         TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  results       TestResult[]

  @@unique([suiteId, name])
  @@index([suiteId, isEnabled])
  @@map("test_cases")
}

model TestRun {
  id            String   @id @default(uuid()) @db.Uuid
  suiteId       String   @map("suite_id") @db.Uuid

  // Run configuration
  agentVersion  String?  @map("agent_version") // Version tested
  deploymentId  String?  @map("deployment_id") @db.Uuid // Which deployment was tested

  // Status
  status        String   @default("pending") // 'pending', 'running', 'completed', 'failed', 'cancelled'
  progress      Int      @default(0) // 0-100

  // Results summary
  totalTests    Int      @default(0) @map("total_tests")
  passedTests   Int      @default(0) @map("passed_tests")
  failedTests   Int      @default(0) @map("failed_tests")
  skippedTests  Int      @default(0) @map("skipped_tests")
  passRate      Float?   @map("pass_rate")

  // Timing
  totalDurationMs Int?   @map("total_duration_ms")

  // Trigger info
  triggeredBy   String?  @map("triggered_by") // 'manual', 'ci', 'scheduled', 'deployment'
  triggeredById String?  @map("triggered_by_id") @db.Uuid

  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  suite         TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  results       TestResult[]

  @@index([suiteId, status])
  @@index([suiteId, createdAt])
  @@map("test_runs")
}

model TestResult {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  testCaseId    String   @map("test_case_id") @db.Uuid

  // Result
  status        String   // 'passed', 'failed', 'skipped', 'error'
  durationMs    Int?     @map("duration_ms")

  // Output
  actualOutput  Json?    @map("actual_output") // What the agent returned
  error         String?  // Error message if failed

  // Assertion details
  assertionResult Json?  @map("assertion_result") // { passed: boolean, details: string, score?: number }

  // Retry info
  attempt       Int      @default(1)

  createdAt     DateTime @default(now()) @map("created_at")

  run           TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase      TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([testCaseId])
  @@map("test_results")
}

// ============================================
// Conversation Memory (Phase 4)
// ============================================

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  agentId       String?  @map("agent_id") @db.Uuid
  deploymentId  String?  @map("deployment_id") @db.Uuid

  // Session info
  sessionId     String   @map("session_id") // External session identifier
  userId        String?  @map("user_id") // External user identifier

  // Metadata
  title         String?  // Auto-generated or manual title
  tags          String[] @default([])
  metadata      Json?    // Custom metadata

  // Status
  status        String   @default("active") // 'active', 'archived', 'deleted'
  messageCount  Int      @default(0) @map("message_count")
  tokenCount    Int      @default(0) @map("token_count")

  // Timestamps
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  messages      Message[]
  memories      MemoryContext[]

  @@unique([orgId, sessionId])
  @@index([orgId, agentId])
  @@index([orgId, status])
  @@index([orgId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid()) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid

  // Message content
  role            String   // 'user', 'assistant', 'system', 'function', 'tool'
  content         String   @db.Text
  name            String?  // For function/tool messages

  // Function/tool calls
  functionCall    Json?    @map("function_call") // { name, arguments }
  toolCalls       Json?    @map("tool_calls") // Array of tool calls
  toolCallId      String?  @map("tool_call_id") // For tool responses

  // Metadata
  tokens          Int      @default(0) // Token count for this message
  metadata        Json?    // Custom metadata (latency, model used, etc.)

  // Ordering
  sequenceNum     Int      @map("sequence_num")

  createdAt       DateTime @default(now()) @map("created_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequenceNum])
  @@index([conversationId, role])
  @@map("messages")
}

model MemoryContext {
  id              String   @id @default(uuid()) @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid

  // Memory type
  type            String   // 'summary', 'fact', 'preference', 'entity', 'custom'
  key             String?  // Key for key-value memories

  // Content
  content         String   @db.Text // The actual memory content
  embedding       Bytes?   // Vector embedding for semantic search

  // Importance and decay
  importance      Float    @default(0.5) // 0-1 importance score
  accessCount     Int      @default(0) @map("access_count")
  lastAccessedAt  DateTime? @map("last_accessed_at")

  // Source tracking
  sourceMessageId String?  @map("source_message_id") @db.Uuid
  sourceRange     Json?    @map("source_range") // { start: sequenceNum, end: sequenceNum }

  // Status
  isActive        Boolean  @default(true) @map("is_active")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, type])
  @@index([conversationId, isActive])
  @@index([conversationId, importance])
  @@map("memory_contexts")
}

// ============================================
// Custom Domains (Phase 4)
// ============================================

model CustomDomain {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid

  // Domain configuration
  domain          String   @unique // e.g., "api.example.com"
  subdomain       String?  // Optional subdomain
  rootDomain      String   @map("root_domain") // e.g., "example.com"

  // Target resource
  targetType      String   @map("target_type") // 'agent', 'deployment'
  targetId        String   @map("target_id") @db.Uuid

  // DNS verification
  verificationStatus String @default("pending") @map("verification_status") // 'pending', 'verified', 'failed', 'expired'
  verificationToken String @unique @map("verification_token") // DNS TXT record value
  verificationMethod String @default("dns_txt") @map("verification_method") // 'dns_txt', 'dns_cname', 'http'
  verifiedAt      DateTime? @map("verified_at")
  lastCheckedAt   DateTime? @map("last_checked_at")
  verificationError String? @map("verification_error")

  // SSL certificate
  sslStatus       String   @default("pending") @map("ssl_status") // 'pending', 'provisioning', 'active', 'failed', 'expired'
  sslProvider     String?  @map("ssl_provider") // 'lets_encrypt', 'custom'
  sslExpiresAt    DateTime? @map("ssl_expires_at")
  sslError        String?  @map("ssl_error")

  // Custom SSL (for custom certificates)
  customCert      Bytes?   @map("custom_cert") // Encrypted
  customKey       Bytes?   @map("custom_key") // Encrypted
  customCertChain Bytes?   @map("custom_cert_chain") // Encrypted

  // Routing configuration
  routingMode     String   @default("proxy") @map("routing_mode") // 'proxy', 'redirect'
  forceHttps      Boolean  @default(true) @map("force_https")
  headers         Json?    // Custom headers to add

  // Status
  isActive        Boolean  @default(false) @map("is_active")
  isPrimary       Boolean  @default(false) @map("is_primary") // Primary domain for the target

  // Analytics
  totalRequests   BigInt   @default(0) @map("total_requests")
  lastRequestAt   DateTime? @map("last_request_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([orgId, domain])
  @@index([orgId, targetType, targetId])
  @@index([verificationStatus])
  @@index([sslStatus])
  @@index([isActive])
  @@map("custom_domains")
}

model DomainEvent {
  id            String   @id @default(uuid()) @db.Uuid
  domainId      String   @map("domain_id") @db.Uuid

  // Event details
  eventType     String   @map("event_type") // 'verification_started', 'verification_success', 'verification_failed', 'ssl_provisioned', 'ssl_renewed', 'ssl_failed', 'activated', 'deactivated'
  message       String?
  details       Json?    // Additional event details

  // Status at time of event
  previousStatus String?  @map("previous_status")
  newStatus     String?  @map("new_status")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([domainId, createdAt])
  @@index([domainId, eventType])
  @@map("domain_events")
}

// ============================================
// Scheduled Tasks / Cron Jobs (Phase 5)
// ============================================

model ScheduledTask {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid
  name          String
  description   String?

  // Schedule configuration
  scheduleType  String   @map("schedule_type") // 'cron', 'interval', 'once'
  cronExpression String? @map("cron_expression")
  intervalSeconds Int?   @map("interval_seconds")
  scheduledAt   DateTime? @map("scheduled_at")
  timezone      String   @default("UTC")

  // Task configuration
  taskType      String   @map("task_type") // 'inference', 'webhook', 'custom'
  payload       Json     @default("{}")
  timeout       Int      @default(300000)
  maxRetries    Int      @default(3) @map("max_retries")

  // Status
  isEnabled     Boolean  @default(true) @map("is_enabled")
  status        String   @default("active") // 'active', 'paused', 'completed', 'failed', 'disabled'

  // Execution tracking
  lastRunAt     DateTime? @map("last_run_at")
  lastRunStatus String?  @map("last_run_status")
  lastRunDurationMs Int? @map("last_run_duration_ms")
  lastError     String?  @map("last_error")
  nextRunAt     DateTime? @map("next_run_at")
  totalRuns     Int      @default(0) @map("total_runs")
  successfulRuns Int     @default(0) @map("successful_runs")
  failedRuns    Int      @default(0) @map("failed_runs")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  executions    TaskExecution[]

  @@unique([orgId, name])
  @@index([orgId, isEnabled])
  @@index([nextRunAt, isEnabled])
  @@index([status])
  @@map("scheduled_tasks")
}

model TaskExecution {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @map("task_id") @db.Uuid

  status        String   @default("pending") // 'pending', 'running', 'success', 'failed', 'timeout', 'cancelled'
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?     @map("duration_ms")

  input         Json?
  output        Json?
  error         String?
  logs          String?  @db.Text

  attempt       Int      @default(1)
  nextRetryAt   DateTime? @map("next_retry_at")

  triggeredBy   String   @default("scheduler") @map("triggered_by")

  createdAt     DateTime @default(now()) @map("created_at")

  task          ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([taskId, createdAt])
  @@map("task_executions")
}

// ============================================
// RAG / Knowledge Base (Phase 5)
// ============================================

model KnowledgeBase {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  description   String?

  embeddingModel String  @default("text-embedding-ada-002") @map("embedding_model")
  chunkSize     Int      @default(512) @map("chunk_size")
  chunkOverlap  Int      @default(50) @map("chunk_overlap")

  status        String   @default("active")

  totalDocuments Int     @default(0) @map("total_documents")
  totalChunks   Int      @default(0) @map("total_chunks")
  totalSizeBytes BigInt  @default(0) @map("total_size_bytes")

  agentIds      String[] @default([]) @map("agent_ids")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  documents     KnowledgeDocument[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String   @id @default(uuid()) @db.Uuid
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid

  title           String
  fileName        String?  @map("file_name")
  mimeType        String?  @map("mime_type")
  sourceUrl       String?  @map("source_url")
  sourceType      String   @map("source_type")

  rawContent      String?  @map("raw_content") @db.Text
  sizeBytes       BigInt   @default(0) @map("size_bytes")

  status          String   @default("pending")
  processingError String?  @map("processing_error")
  processedAt     DateTime? @map("processed_at")

  chunkCount      Int      @default(0) @map("chunk_count")

  metadata        Json?
  tags            String[] @default([])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]

  @@index([knowledgeBaseId, status])
  @@map("knowledge_documents")
}

model DocumentChunk {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @map("document_id") @db.Uuid

  content         String   @db.Text
  chunkIndex      Int      @map("chunk_index")

  embedding       Bytes?
  embeddingModel  String?  @map("embedding_model")

  metadata        Json?
  tokenCount      Int      @default(0) @map("token_count")

  createdAt       DateTime @default(now()) @map("created_at")

  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@map("document_chunks")
}

// ============================================
// Multi-Agent Orchestration (Phase 5)
// ============================================

model Orchestration {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  description   String?

  executionMode String   @map("execution_mode") // 'sequential', 'parallel', 'conditional', 'pipeline'
  maxConcurrency Int     @default(5) @map("max_concurrency")
  timeout       Int      @default(600000)
  retryPolicy   Json?    @map("retry_policy")

  inputSchema   Json?    @map("input_schema")
  outputSchema  Json?    @map("output_schema")

  isEnabled     Boolean  @default(true) @map("is_enabled")

  totalRuns     Int      @default(0) @map("total_runs")
  successfulRuns Int     @default(0) @map("successful_runs")
  failedRuns    Int      @default(0) @map("failed_runs")
  avgDurationMs Int?     @map("avg_duration_ms")
  lastRunAt     DateTime? @map("last_run_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  steps         OrchestrationStep[]
  executions    OrchestrationExecution[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("orchestrations")
}

model OrchestrationStep {
  id              String   @id @default(uuid()) @db.Uuid
  orchestrationId String   @map("orchestration_id") @db.Uuid

  name            String
  stepOrder       Int      @map("step_order")
  agentId         String   @map("agent_id") @db.Uuid

  inputMapping    Json?    @map("input_mapping")
  outputMapping   Json?    @map("output_mapping")

  condition       Json?

  onError         String   @default("fail") @map("on_error")
  fallbackAgentId String?  @map("fallback_agent_id") @db.Uuid
  maxRetries      Int      @default(0) @map("max_retries")
  timeoutMs       Int?     @map("timeout_ms")

  dependsOn       String[] @default([]) @map("depends_on")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orchestration   Orchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@unique([orchestrationId, name])
  @@unique([orchestrationId, stepOrder])
  @@index([orchestrationId])
  @@map("orchestration_steps")
}

model OrchestrationExecution {
  id              String   @id @default(uuid()) @db.Uuid
  orchestrationId String   @map("orchestration_id") @db.Uuid

  status          String   @default("pending")
  progress        Int      @default(0)

  input           Json?
  output          Json?
  context         Json?

  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationMs      Int?      @map("duration_ms")

  triggeredBy     String   @default("manual") @map("triggered_by")
  triggeredById   String?  @map("triggered_by_id") @db.Uuid

  error           String?
  failedStepId    String?  @map("failed_step_id") @db.Uuid

  createdAt       DateTime @default(now()) @map("created_at")

  orchestration   Orchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)
  stepResults     OrchestrationStepResult[]

  @@index([orchestrationId, status])
  @@index([orchestrationId, createdAt])
  @@map("orchestration_executions")
}

model OrchestrationStepResult {
  id            String   @id @default(uuid()) @db.Uuid
  executionId   String   @map("execution_id") @db.Uuid
  stepId        String   @map("step_id") @db.Uuid
  stepName      String   @map("step_name")

  status        String   @default("pending")
  agentId       String   @map("agent_id") @db.Uuid

  input         Json?
  output        Json?
  error         String?

  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?      @map("duration_ms")

  attempt       Int       @default(1)

  createdAt     DateTime  @default(now()) @map("created_at")

  execution     OrchestrationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, stepId])
  @@map("orchestration_step_results")
}

// ============================================
// Agent Templates / Starter Kits (Phase 5)
// ============================================

model AgentTemplate {
  id            String   @id @default(uuid()) @db.Uuid

  name          String   @unique
  slug          String   @unique
  title         String
  description   String   @db.Text
  longDescription String? @map("long_description") @db.Text

  category      String
  difficulty    String   @default("beginner")
  tags          String[] @default([])
  framework     String

  systemPrompt  String?  @map("system_prompt") @db.Text
  tools         Json     @default("[]")
  modelConfig   Json     @map("model_config")
  sourceType    String   @map("source_type") @default("inline")
  sourceCode    String?  @map("source_code") @db.Text
  sourceUrl     String?  @map("source_url")
  env           Json     @default("{}")

  graphNodes    Json?    @map("graph_nodes")
  graphEdges    Json?    @map("graph_edges")

  iconUrl       String?  @map("icon_url")
  screenshots   String[] @default([])
  readme        String?  @db.Text

  usageCount    Int      @default(0) @map("usage_count")
  avgRating     Float    @default(0) @map("avg_rating")

  isPublished   Boolean  @default(true) @map("is_published")
  isFeatured    Boolean  @default(false) @map("is_featured")

  authorName    String   @map("author_name")
  authorUrl     String?  @map("author_url")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category, isPublished])
  @@index([framework, isPublished])
  @@index([difficulty, isPublished])
  @@index([isFeatured, isPublished])
  @@index([usageCount])
  @@map("agent_templates")
}

// ============================================
// Two-Factor Authentication (Phase 5)
// ============================================

model TwoFactorAuth {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid

  secret        Bytes
  algorithm     String   @default("SHA1")
  digits        Int      @default(6)
  period        Int      @default(30)

  isEnabled     Boolean  @default(false) @map("is_enabled")
  isVerified    Boolean  @default(false) @map("is_verified")

  backupCodes   Bytes?   @map("backup_codes")
  backupCodesUsed Int    @default(0) @map("backup_codes_used")
  backupCodesTotal Int   @default(10) @map("backup_codes_total")

  recoveryEmail String?  @map("recovery_email")

  lastUsedAt    DateTime? @map("last_used_at")
  lastMethod    String?   @map("last_method")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model TwoFactorChallenge {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid

  token         String   @unique

  isUsed        Boolean  @default(false) @map("is_used")

  expiresAt     DateTime @map("expires_at")

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

// ============================================
// OpenClaw Integration (Phase 6)
// ============================================

enum OpenClawStatus {
  PENDING
  BUILDING
  DEPLOYING
  RUNNING
  STOPPED
  FAILED
}

model OpenClawDeployment {
  id              String         @id @default(uuid()) @db.Uuid
  agentId         String         @unique @map("agent_id") @db.Uuid
  openclawVersion String         @default("latest") @map("openclaw_version")
  dockerImage     String         @default("wheelsai/openclaw-hardened:latest") @map("docker_image")
  envEncrypted    String         @map("env_encrypted") @db.Text
  status          OpenClawStatus @default(PENDING)
  nosanaJobId     String?        @map("nosana_job_id")
  publicUrl       String?        @map("public_url")
  healthLastCheck DateTime?      @map("health_last_check")
  healthStatus    String?        @map("health_status")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  agent           Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channels        OpenClawChannel[]

  @@index([status])
  @@map("openclaw_deployments")
}

model OpenClawChannel {
  id              String   @id @default(uuid()) @db.Uuid
  deploymentId    String   @map("deployment_id") @db.Uuid
  platform        String
  configEncrypted String   @map("config_encrypted") @db.Text
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  deployment      OpenClawDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@map("openclaw_channels")
}

// ============================================
// Agent Token Marketplace (Phase 6)
// ============================================

enum TokenStatus {
  BONDING
  GRADUATED
  FAILED
}

model AgentToken {
  id                String      @id @default(uuid()) @db.Uuid
  agentListingId    String      @unique @map("agent_listing_id") @db.Uuid
  mintAddress       String      @unique @map("mint_address")
  pumpfunUrl        String?     @map("pumpfun_url")
  bondingCurveAddress String?   @map("bonding_curve_address")
  creatorAddress    String      @map("creator_address")
  name              String
  symbol            String
  imageUri          String?     @map("image_uri")
  // Which launchpad minted this token ("pumpfun" | "bags"). Discriminator
  // for the Bags fee-claim sweep (which only operates on bags tokens).
  // Existing rows backfill to "pumpfun".
  launchpad         String      @default("pumpfun")
  // Bags Meteora fee-share config key (base58). Null for pump.fun.
  meteoraConfigKey  String?     @map("meteora_config_key")
  totalSupply       BigInt      @default(1000000000) @map("total_supply")
  curveSupply       BigInt      @default(800000000) @map("curve_supply")
  reservedSupply    BigInt      @default(200000000) @map("reserved_supply")
  status            TokenStatus @default(BONDING)
  graduatedAt       DateTime?   @map("graduated_at")
  raydiumPoolId     String?     @map("raydium_pool_id")
  marketCapUsd      Float       @default(0) @map("market_cap_usd")
  priceUsd          Float       @default(0) @map("price_usd")
  volume24h         Float       @default(0) @map("volume_24h")
  holders           Int         @default(0)
  creatorLockupEnd  DateTime?   @map("creator_lockup_end")
  // Per-agent treasury PDA (derived from mintAddress). Receives the token's
  // fee share and auto-pays the agent's Nosana compute bill. See plan A2/A3.
  treasuryAddress       String? @unique @map("treasury_address")
  treasuryPdaAuthorityBump Int?   @map("treasury_pda_authority_bump")
  // Cumulative lifetime counters (mirror of on-chain state, updated by
  // treasury-settlement worker).
  computePaidLamports BigInt @default(0) @map("compute_paid_lamports")
  revenueLamports     BigInt @default(0) @map("revenue_lamports")
  // Whether the reputation-oracle program's AgentReputation PDA has been
  // initialized on-chain for this token mint (plan A4). The attestation
  // worker skips agents where this is false; the bootstrap path calls
  // initialize_agent_reputation and flips it. Existing rows default false.
  reputationProgramInitialized Boolean   @default(false) @map("reputation_program_initialized")
  // Cursor advanced by the reputation-attestation worker after a
  // successful submit_attestation. Usage records with periodEnd > this
  // cursor contribute to the next attestation. Null = never attested.
  lastOnChainAttestationAt     DateTime? @map("last_on_chain_attestation_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  agentListing      AgentListing @relation(fields: [agentListingId], references: [id], onDelete: Cascade)
  trades            AgentTokenTrade[]
  holdersList       AgentTokenHolder[]
  snapshots         AgentTokenSnapshot[]
  treasury          AgentTreasury?
  onChainAttestations OnChainAttestation[]

  @@index([status])
  @@index([marketCapUsd])
  @@index([volume24h])
  @@index([launchpad])
  @@map("agent_tokens")
}

// ============================================
// On-chain reputation attestation mirror (Plan A4)
// ============================================
//
// The reputation-oracle Anchor program emits an `AttestationSubmitted`
// event on every successful submit_attestation. We mirror those events
// here so off-chain readers (token launchpad eligibility, public
// transparency pages, the runway dashboard) don't have to scan the
// chain on every load. The on-chain AgentReputation PDA remains the
// source of truth — this is a read-cache, not authoritative.

model OnChainAttestation {
  id                  String   @id @default(uuid()) @db.Uuid
  tokenId             String   @map("token_id") @db.Uuid
  txSignature         String   @unique @map("tx_signature")
  attestorAddress     String   @map("attestor_address")
  uptimeSecondsDelta  BigInt   @map("uptime_seconds_delta")
  messageCountDelta   BigInt   @map("message_count_delta")
  score               Int
  // Cumulative totals AFTER applying this attestation, mirroring the
  // values emitted in the AttestationSubmitted event so a reader can
  // reconstruct the state-after without replaying.
  cumulativeUptimeSeconds BigInt @map("cumulative_uptime_seconds")
  cumulativeMessageCount  BigInt @map("cumulative_message_count")
  attestationCount        Int    @map("attestation_count")
  // Attestor-claimed unix timestamp; the program rejected stale values
  // (< prior last_attestation_unix_ts) so this is monotonic per token.
  attestorUnixTs      BigInt   @map("attestor_unix_ts")
  // When we OBSERVED the on-chain landing (cron tick time). Useful for
  // detecting attestor liveness independent of attestor-claimed time.
  observedAt          DateTime @default(now()) @map("observed_at")
  createdAt           DateTime @default(now()) @map("created_at")

  token               AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, attestorUnixTs])
  @@index([attestorAddress])
  @@map("on_chain_attestations")
}

model AgentTokenTrade {
  id            String   @id @default(uuid()) @db.Uuid
  tokenId       String   @map("token_id") @db.Uuid
  txSignature   String   @unique @map("tx_signature")
  traderAddress String   @map("trader_address")
  side          String
  solAmount     Float    @map("sol_amount")
  tokenAmount   Float    @map("token_amount")
  priceUsd      Float    @map("price_usd")
  timestamp     DateTime

  token         AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, timestamp])
  @@index([traderAddress])
  @@map("agent_token_trades")
}

model AgentTokenHolder {
  id            String   @id @default(uuid()) @db.Uuid
  tokenId       String   @map("token_id") @db.Uuid
  walletAddress String   @map("wallet_address")
  balance       Float
  percentage    Float
  updatedAt     DateTime @updatedAt @map("updated_at")

  token         AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, walletAddress])
  @@index([tokenId])
  @@map("agent_token_holders")
}

model AgentTokenSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  tokenId      String   @map("token_id") @db.Uuid
  priceUsd     Float    @map("price_usd")
  marketCapUsd Float    @map("market_cap_usd")
  volume24h    Float    @map("volume_24h")
  holders      Int
  timestamp    DateTime @default(now())

  token        AgentToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, timestamp])
  @@map("agent_token_snapshots")
}

// ============================================
// Per-Agent Treasury (Plan A2/A3)
// ============================================
//
// Each tokenized agent owns a Solana PDA treasury derived from its mint
// address. The on-chain `agent-treasury` Anchor program is the source of
// truth for balances; these rows are a local mirror maintained by the
// treasury-settlement worker for fast reads + indexing.

model AgentTreasury {
  id                       String   @id @default(uuid()) @db.Uuid
  tokenId                  String   @unique @map("token_id") @db.Uuid
  treasuryPdaAddress       String   @unique @map("treasury_pda_address")
  authorityBump            Int      @map("authority_bump")
  solBalanceLamports       BigInt   @default(0) @map("sol_balance_lamports")
  // When the balance-sync tick last mirrored the on-chain PDA lamports into
  // solBalanceLamports (spendable = lamports - rent reserve). Settlement
  // skips treasuries whose mirror is stale — null/old means "skip", never
  // "assume 0 or pay anyway".
  balanceSyncedAt          DateTime? @map("balance_synced_at")
  accruedFeeLamports       BigInt   @default(0) @map("accrued_fee_lamports")
  lastComputeBillLamports  BigInt?  @map("last_compute_bill_lamports")
  lastComputeBillAt        DateTime? @map("last_compute_bill_at")
  // Computed off last-paid compute rate; UI reads this to render the runway
  // card. Recomputed on each settlement tick.
  runwaySecondsEstimate    BigInt   @default(0) @map("runway_seconds_estimate")
  lastSyncedAt             DateTime @default(now()) @map("last_synced_at")
  // Whether the agent-treasury Anchor program has been initialized
  // on-chain for this row (`initialize_treasury` instruction landed).
  // The submit worker reads this to decide between the legacy
  // SystemProgram.transfer path (false) and the program-mediated
  // pay_nosana path (true). Existing rows default to false; the
  // backfill script flips them as it migrates each treasury PDA.
  programInitialized       Boolean  @default(false) @map("program_initialized")
  // Cursor advanced by the fee-router BullMQ worker after a successful
  // fee_receive submission. Trades with timestamp > this cursor are
  // unrouted (eligible for the next batch). Null = never routed.
  lastFeeRoutedAt          DateTime? @map("last_fee_routed_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  token     AgentToken       @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  payments  ComputePayment[]

  @@map("agent_treasuries")
}

enum ComputePaymentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model ComputePayment {
  id             String               @id @default(uuid()) @db.Uuid
  treasuryId     String               @map("treasury_id") @db.Uuid
  nosanaJobId    String               @map("nosana_job_id")
  amountLamports BigInt               @map("amount_lamports")
  computeSeconds BigInt               @map("compute_seconds")
  txSignature    String?              @unique @map("tx_signature")
  status         ComputePaymentStatus @default(PENDING)
  errorMessage   String?              @map("error_message")
  scheduledFor   DateTime             @default(now()) @map("scheduled_for")
  // Set by persistSubmitTransition when status moves PENDING → SUBMITTED.
  // Reaper reads this to detect blockhash-expired stuck submissions
  // (a row whose submittedAt is older than the blockhash window will
  // never confirm).
  submittedAt    DateTime?            @map("submitted_at")
  paidAt         DateTime?            @map("paid_at")
  // Counts retries from FAILED → PENDING resubmissions. Lifecycle
  // shouldRetry() reads this against a maxRetries policy.
  retryCount     Int                  @default(0) @map("retry_count")
  // Billing window this row charges for (delta billing, remediation D2).
  // periodStart = the treasury's lastComputeBillAt cursor at decision time
  // (epoch for the first-ever bill); periodEnd = the tick's `now`, which
  // becomes the new cursor. The composite unique below is the DB backstop
  // against double-billing the same window: createMany(skipDuplicates) makes
  // a crash-replayed tick a no-op. Legacy rows keep NULL periodStart —
  // Postgres treats NULLs as distinct in unique indexes, which is acceptable
  // for pre-migration rows; every new write sets both bounds.
  periodStart    DateTime?            @map("period_start")
  periodEnd      DateTime?            @map("period_end")
  createdAt      DateTime             @default(now()) @map("created_at")

  treasury AgentTreasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)

  @@unique([treasuryId, nosanaJobId, periodStart], map: "compute_payments_treasury_job_period_key")
  @@index([treasuryId, status])
  @@index([status, scheduledFor])
  @@map("compute_payments")
}

// ============================================
// Free Tier Usage Tracking
// ============================================

model FreeTierUsage {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  model        String
  provider     String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  requestCount Int      @default(0) @map("request_count")
  date         DateTime @default(now()) @db.Date

  @@unique([orgId, model, date])
  @@map("free_tier_usage")
}
