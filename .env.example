# ===========================================
# WheelsAI Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://wheelsai:wheelsai@localhost:5434/wheelsai?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6380"

# ---- Web App (Next.js) ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- API Server ----
API_PORT=4000
API_HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:3000"

# ---- Auth ----
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# ---- Encryption (required in production, falls back to JWT_SECRET in dev) ----
# ENCRYPTION_KEY=""

# ---- Agent Wallet Encryption ----
WALLET_MASTER_KEY=""

# ---- Solana / Nosana ----
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_NETWORK="devnet"
NOSANA_WALLET_PRIVATE_KEY=""
TREASURY_WALLET_ADDRESS="11111111111111111111111111111111"

# ---- Nosana deployments (all optional; see apps/api/src/config/nosanaDeploy.ts) ----
# The built-in GPU markets are MAINNET markets. On devnet a tier is deployable only
# when you supply its market (Nosana devnet test market example below).
# NOSANA_MARKETS_JSON='{"4090":"J2mYPCyZkFzhg2oi1EqA8UAYZHhYVmktV4ExB5itFJYW"}'
# NOSANA_JOB_TIMEOUT_SECONDS=7200          # per-job timeout (kept alive by SIMPLE-EXTEND). 600..86400; with an API
#                                          # key paying (prepaid credits) at least 3000: Nosana never assigns a
#                                          # credit-paid job under 50 minutes, and the API refuses to boot below it
# NOSANA_BATCH_JOB_TIMEOUT_SECONDS=21600   # timeout of finite jobs (fine-tuning); the same 3000 minimum with an API key
# NOSANA_PROVISIONING_LIMIT_SECONDS=1800   # a deployment that is not serving after this long is failed, stopped
#                                          # on Nosana and its hold returned (nothing is charged)
# NOSANA_DEPLOYMENT_STRATEGY="SIMPLE-EXTEND"   # or INFINITE (needs NOSANA_JOB_TIMEOUT_SECONDS >= 3600) | SIMPLE
# NOSANA_VAULT_FUND_SECONDS=14400          # run-time funded up front (default 2x job timeout)
# NOSANA_VAULT_SOL_LAMPORTS_PER_REPLICA=10000000
# NOSANA_NETWORK_FEE_BPS=1000
# GPU_BILLING_INTERVAL_MS=60000            # per-second GPU billing tick (0 disables)
# HF_TOKEN=""                              # Hugging Face token for gated models (confidential jobs only)
# ALLOW_LOOPBACK_NODE_URLS=false           # dev only: let /v1 + the health probe reach localhost (also needs NODE_ENV=development)

# ---- Nosana access: who pays Nosana (all optional; see apps/api/src/config/nosanaAccess.ts) ----
# Either a Solana wallet (NOSANA_WALLET_PRIVATE_KEY above: a vault per deployment,
# funded in NOS + SOL) or a dashboard API key (prepaid USD credits, no vault).
# With neither set the API boots and deploys answer 501.
# NOSANA_API_KEY=""                        # dashboard API key; never logged (last 4 characters only)
# NOSANA_ACCESS_MODE=""                    # wallet | api_key. REQUIRED when both credentials are set: the
#                                          # API refuses to boot rather than guess which account pays
# NOSANA_NETWORK=""                        # mainnet | devnet. Default: mainnet with an API key,
#                                          # otherwise derived from SOLANA_NETWORK. With both
#                                          # credentials set and this unset, each keeps its own
#                                          # (wallet: from SOLANA_NETWORK; API key: mainnet)
# NOSANA_API_URL=""                        # Nosana backend base URL (https). Default: the SDK's own
# NOSANA_MIN_CREDITS_USD=5                 # floor: a deployment needs its estimate + this available
# NOSANA_CREDITS_WARN_USD=20               # operator warning threshold
# NOSANA_CREDITS_CACHE_MS=30000            # balance cache for the operator view (the deploy gate reads fresh)
# NOSANA_COST_CACHE_MS=600000              # cache of Nosana's public market list (USD cost per tier)
# NOSANA_TIMEOUT_UNIT="minutes"            # Leave unset. Nosana reads a deployment timeout in minutes
#                                          # (the default). Our settings stay in seconds and are
#                                          # converted (rounded up) when sent. "seconds" still parses
#                                          # but sends 60 times the timeout, and logs an error at boot.
# NOSANA_SDK_TIMEOUT_MS=30000              # deadline on each Nosana SDK call (100..300000)
# Check a key without spending:   cd apps/api && npx tsx scripts/nosana-access-check.ts   (read-only)
# Operator view of the account:   GET /api/platform/compute with x-admin-key (PLATFORM_ADMIN_KEY below)

# ---- Free Model Providers (get free keys at each provider's console) ----
GROQ_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
TOGETHER_API_KEY=""
FREE_TIER_RPM=20
FREE_TIER_RPD=200
# Wall-clock limit (ms) for one agent chat, tool rounds and streaming included.
AGENT_CHAT_TIMEOUT_MS=120000
# A dedicated GPU for an agent. Off until the agent runtime images exist: deploying an agent then answers 501 and reserves nothing.
AGENT_GPU_ENABLED=false

# ---- Public chat: the web chat widget and Try it ----
# These callers are anonymous. Their limits fail CLOSED: when Redis cannot
# count, they are refused (503) rather than let through unlimited.
# Widget: per visitor address, per key, and a key's default daily cap.
WIDGET_PER_IP_PER_MINUTE=10
WIDGET_PER_IP_PER_DAY=200
WIDGET_PER_KEY_PER_MINUTE=60
WIDGET_DEFAULT_DAILY_CAP=1000
# Try it: platform-funded messages per listing per day, per session, per
# visitor address per hour, per signed-in organization per day, and across
# the platform per minute.
TRIAL_BASE_DAILY_MESSAGES=50
TRIAL_MESSAGES_PER_SESSION=10
TRIAL_PER_IP_PER_HOUR=30
TRIAL_SIGNED_IN_PER_DAY=100
TRIAL_GLOBAL_PER_MINUTE=20
# Price (cents) a publisher pays per Try it message above the platform's
# daily ones. Unset = publisher-funded caps are not offered (501).
# TRIAL_FUNDED_MESSAGE_CENTS=
# Cloudflare Turnstile for anonymous Try it visitors. Set both or neither;
# without them Try it requires sign-in.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- GitHub Import (optional, for private repos) ----
# GITHUB_TOKEN=""

# ---- Stripe (Payments — simulated in development) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- IPFS ----
PINATA_API_KEY=""
PINATA_SECRET_KEY=""

# ---- Inference ----
# How long a model node may stay silent before a request fails (default 120000).
# A long answer on a small GPU takes more than 30 seconds.
INFERENCE_TIMEOUT_MS=120000
MAX_RETRIES=2
# How long one attempt to connect out may take before the next address of the
# host is tried, in milliseconds (250 to 30000, default 2500). Node's own 250 ms
# is too short on a slow link, or where IPv6 is advertised but does not work:
# the request then fails although the host is up.
OUTBOUND_CONNECT_ATTEMPT_TIMEOUT_MS=2500

# ---- Agent skills / tools (all optional; see apps/api/src/config/skills.ts) ----
# A tool whose provider is unset answers "unavailable: <reason>" to the model and is
# labelled "needs configuration" in the UI - it never returns made-up output.
# TAVILY_API_KEY=""                       # enables web_search (https://tavily.com)
# SANDBOX_RUNNER_URL=""                   # enables code_interpreter + the graph `code` node;
#                                         # an EXTERNAL runner on a PUBLIC address (SSRF-guarded).
#                                         # HTTP contract: apps/api/src/services/skills/sandboxRunner.ts
# SANDBOX_RUNNER_TOKEN=""                 # sent as Authorization: Bearer <token>
# SANDBOX_LANGUAGES="python,javascript"
# SANDBOX_TIMEOUT_MS=15000                # 1000..120000
# SANDBOX_MAX_OUTPUT_BYTES=65536          # per stream
# AGENT_FILES_MAX_BYTES=1048576           # per-agent file storage (file_read/file_write) reuses
# AGENT_FILES_MAX_COUNT=50                # the dataset bucket: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, DATASETS_BUCKET

# ---- OpenClaw ----
OPENCLAW_DEFAULT_IMAGE="wheelsai/openclaw-hardened:latest"
OPENCLAW_SUBDOMAIN_BASE="openclaw.wheelsai.com"

# ---- Token Marketplace (Pump.fun) ----
PUMPFUN_API_KEY=""
TOKEN_INDEXER_INTERVAL_MS=30000

# ---- X402 Payments (optional, disabled by default) ----
X402_ENABLED=false
X402_INFERENCE_MODE="off"
X402_DEFAULT_ASSET="USDC"
X402_SUBMIT_TRANSACTIONS=false
X402_SETTLEMENT_WORKER_ENABLED=false

# =============================================================================
# Everything else the API and web app read. Optional unless noted; the value
# shown is the default. Source of truth: apps/api/src/config/env.ts (plus
# config/nosanaDeploy.ts and config/skills.ts for their sections above).
# See docs/FOUNDER-ACTIONS.md for which accounts and keys unlock what.
# =============================================================================

# --- Public origins, proxies, cookies -----------------------------------------
# PUBLIC_API_URL=""            # absolute API origin: OAuth redirects, Telegram webhooks, endpoints shown to users
# PUBLIC_WEB_URL=""            # absolute web origin: links in emails, listing URLs
# GPU_FACING_API_URL=""        # where a container on a GPU node reaches the API (training progress, adapter download);
#                              # unset = PUBLIC_API_URL. An address on this machine or a private network is refused
#                              # before a GPU is rented. For a proof from a development machine: infra/gpu-door
# TRUST_PROXY_HOPS=1          # reverse proxies in front of the API (Fly edge = 1)
# RATE_LIMIT_MAX_PER_MINUTE=100 # requests per minute per client across the API (login keeps its own 5/min)
# COOKIE_DOMAIN=""             # e.g. ".wheelsai.app" when web and API are sibling subdomains

# --- Email (verification, password reset, invites, alerts) -------------------
# EMAIL_PROVIDER=""            # "resend" (or "log", development only); unset = email flows answer 501
# RESEND_API_KEY=""
# EMAIL_FROM=""                # e.g. "WheelsAI <no-reply@wheelsai.app>"
# SALES_EMAIL=""               # where Contact Sales requests are emailed (they are also stored)

# --- Stripe (cards, Pro plan) -------------------------------------------------
# STRIPE_PRO_PRICE_ID=""       # recurring Price for the $49/month Pro plan

# --- Object storage (datasets, adapters, agent files): S3, R2 or MinIO --------
# Parsed by apps/api/src/config/training.ts. Run log: docs/OBJECT-STORAGE-RUN.md
# STORAGE_DRIVER=""            # "s3" or "local"; unset = s3 when the three values below are set, else no storage
# AWS_REGION=""                # default "us-east-1", or "auto" when S3_ENDPOINT is set (R2 expects "auto")
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# DATASETS_BUCKET=""           # all three credentials + bucket must be set, else uploads answer 503
# S3_ENDPOINT=""               # S3-compatible endpoint, e.g. https://<account id>.r2.cloudflarestorage.com; unset = AWS S3
# S3_FORCE_PATH_STYLE=false    # true for MinIO (<endpoint>/<bucket>/<key>); R2 and AWS work with false
# STORAGE_LOCAL_DIR=""         # STORAGE_DRIVER=local only (development only, refused elsewhere): files live here;
#                              # default <os tmp>/wheelsai-object-store. Uploads then go through /api/storage/t/<token>
# TRAINING_DATASET_MAX_BYTES=209715200  # largest dataset file (200 MB); checked before upload and at validation
# TRAINING_DATASET_MAX_ROWS=200000      # most rows in a dataset; checked at validation

# --- Fine-tuning jobs -----------------------------------------------------------
# Parsed by apps/api/src/config/training.ts. Image and its contract: infra/training/README.md
# TRAINING_IMAGE=""            # the training image PINNED BY DIGEST: <registry>/<repository>@sha256:<64 hex>.
#                              # Unset (or a tag without a digest) = jobs answer 501 training_image_not_configured
# TRAINING_IMAGE_REGISTRY_SERVER=""    # pull credentials for a private registry: all three or none. They are sent
# TRAINING_IMAGE_REGISTRY_USERNAME=""  # to the node that runs the job, so use a read-only deploy token
# TRAINING_IMAGE_REGISTRY_PASSWORD=""
# TRAINING_POLL_INTERVAL_MS=15000          # how often running jobs are checked on Nosana; 0 = off (jobs then answer 503)
# TRAINING_QUEUE_TIMEOUT_SECONDS=1800      # a job no node takes within this fails and is charged nothing
# TRAINING_SETUP_ALLOWANCE_SECONDS=900     # added to the user's run limit for the Nosana timeout (image pull); never billed
# TRAINING_MAX_ACTIVE_JOBS_PER_ORG=2       # unfinished jobs one organization may have at once
# TRAINING_FREE_FAILURES_PER_DAY=3         # jobs of one organization that may end failed and free in 24 h; then 409
# TRAINING_ADAPTER_MAX_BYTES=2147483648    # largest adapter archive accepted when a job is finalised (2 GiB)
# Also read: HF_TOKEN (gated base models are offered only when set), PUBLIC_API_URL (trainer callbacks),
# NOSANA_BATCH_JOB_TIMEOUT_SECONDS (the run limit is at most this minus the set-up allowance),
# DEPLOYMENT_STATUS_INTERVAL_MS (must be above 0: its worker runs the sweep that stops lost GPU jobs)

# --- Models and embeddings -----------------------------------------------------
# OPENAI_API_KEY=""
# EMBEDDING_PROVIDER=""        # OpenAI-compatible /embeddings provider; unset = keyword search only
# EMBEDDING_MODEL=""
# EMBEDDING_BACKFILL_INTERVAL_MS=0
# EMBEDDING_BACKFILL_BATCH_SIZE=50

# --- Background workers (0 disables a worker) --------------------------------
# DEPLOYMENT_STATUS_INTERVAL_MS=30000
# SCHEDULER_INTERVAL_MS=30000
# Due scheduled tasks one tick runs at the same time.
# SCHEDULER_CONCURRENCY=4
# Workflow runs: how many one process executes at once (0 turns the worker
# off and starting a run answers 501), how often lost runs are reaped, and
# how many runs one organization may have queued or running at a time.
# WORKFLOW_RUN_CONCURRENCY=4
# WORKFLOW_REAP_INTERVAL_MS=60000
# WORKFLOW_MAX_ACTIVE_RUNS_PER_ORG=5
# Offerings and Jobs: how many paid jobs one process runs at once (0 turns
# the runner off; hiring and activating an offering then answer 501), how
# often the sweeper expires, auto-completes and re-queues jobs, and the
# longest one job may run.
# JOB_RUNNER_CONCURRENCY=2
# JOB_SWEEP_INTERVAL_MS=60000
# JOB_MAX_RUN_MS=900000
# What a paid job's use of the platform's free-model keys costs the
# publisher, in cents per million tokens (taken from their share at settle).
# JOB_PLATFORM_MODEL_INPUT_CENTS_PER_MTOK=15
# JOB_PLATFORM_MODEL_OUTPUT_CENTS_PER_MTOK=60
# UPTIME_PROBER_INTERVAL_MS=30000
# ALERT_EVALUATOR_INTERVAL_MS=60000
# ANALYTICS_SNAPSHOT_INTERVAL_MS=3600000
# SUBSCRIPTION_RENEWAL_INTERVAL_MS=3600000
# PENDING_USE_SWEEP_INTERVAL_MS=60000      # gives back a charge per use that a crash left pending for more than 15 minutes; 0 = off
# TREASURY_SETTLEMENT_INTERVAL_MS=60000
# TREASURY_SETTLEMENT_BATCH_INTERVAL_MS=300000
# PAYMENT_SUBMIT_INTERVAL_MS=30000
# PAYMENT_POLL_INTERVAL_MS=15000
# PAYMENT_REAP_INTERVAL_MS=120000
# PAYMENT_BATCH_LIMIT=50
# PAYMENT_REAP_MAX_AGE_SECONDS=150
# PAYMENT_REAP_BATCH_LIMIT=100
# FEE_ROUTER_INTERVAL_MS=0             # needs FEE_ROUTER_WALLET_PRIVATE_KEY (funded)
# BAGS_FEE_SWEEP_INTERVAL_MS=0         # only with LAUNCHPAD=bags
# REPUTATION_ATTESTATION_INTERVAL_MS=0 # needs REPUTATION_ATTESTOR_PRIVATE_KEY (whitelisted attestor)
# PAYOUT_EXECUTOR_INTERVAL_MS=0        # needs PAYOUTS_ENABLED=true
# TOPUP_RECONCILE_INTERVAL_MS=15000    # credits a top-up whose transfer lands after the page is closed
# DEPOSIT_SCAN_INTERVAL_MS=60000       # needs DEPOSITS_ENABLED=true
# SWEEP_INTERVAL_MS=300000             # needs SWEEPS_ENABLED=true
# PAYOUT_EXECUTOR_BATCH_SIZE=10

# --- Limits ----------------------------------------------------------------------
# MAX_ACTIVE_DEPLOYMENTS_PER_ORG=5

# --- Paying in, deposit addresses, sweeps and payouts ----------------------------
# All off by default; docs/DEPLOY-RUNBOOK.md says what each needs and
# docs/PAYMENTS-RUN.md how they were proven. Deposit addresses and the wallet
# that pays out are derived from WALLET_MASTER_KEY (above): keep a copy
# offline, and never change it once an address made from it has been given
# out. In production these need SOLANA_NETWORK="mainnet-beta".
# WALLET_TOPUPS_ENABLED=false          # pay in from a wallet, in USDC or SOL; needs WALLET_MASTER_KEY
# DEPOSITS_ENABLED=false               # credit any transfer sent to an organization's address; needs WALLET_TOPUPS_ENABLED
# DEPOSIT_SCAN_MAX_ADDRESSES=500       # addresses one scan run reads
# DEPOSIT_ACCOUNT_OPENS_PER_DAY=25     # USDC accounts "Prepare address" may open in a day, in all
# HOT_WALLET_MIN_SOL=0.05              # the paying wallet opens accounts and pays for USDC sweeps only above this
# SWEEPS_ENABLED=false                 # move deposits off the addresses; needs DEPOSITS_ENABLED
# SWEEP_MIN_USD=25                     # an address is swept once it holds this much of an asset
# SWEEP_MAX_PER_RUN=20
# HOT_WALLET_FLOAT_USDC=200            # sweeps fill the paying wallet to its floats and send the rest to
# HOT_WALLET_FLOAT_SOL_USD=100         # TREASURY_WALLET_ADDRESS, once scripts/treasury-verify.ts has proven it
# PAYOUTS_ENABLED=false                # creator payouts; also needs PAYOUT_EXECUTOR_INTERVAL_MS above 0
# PAYOUT_MAX_PER_PAYOUT_USD=500        # to a wallet; a payout taken as credits has no cap
# PAYOUT_MAX_PER_DAY_USD=1000          # one creator, to a wallet
# PAYOUT_PLATFORM_MAX_PER_DAY_USD=5000 # every creator together, to a wallet
# PAYOUT_MAX_ATTEMPTS=3                # transfers that may be signed for one payout
# The price of SOL, for anything that turns SOL into dollars or back. "off":
# SOL is not offered, and USDC is unaffected. "pyth": Pyth's SOL/USD account,
# read through SOLANA_RPC_URL. "static": SOL_PRICE_STATIC_USD, for a local
# chain; refused on mainnet and in production.
# SOL_PRICE_SOURCE="off"
# SOL_PRICE_STATIC_USD=""
# SOL_PRICE_MAX_AGE_SECONDS=120        # an older price is refused
# SOL_PRICE_MAX_CONF_BPS=100           # so is one whose stated uncertainty is above this (100 is 1%)
# SOL_PRICE_MAX_EMA_DEVIATION_BPS=1000 # or one this far from its own moving average
# SOL_PRICE_MIN_USD=""                 # an optional sanity band, in dollars
# SOL_PRICE_MAX_USD=""
# SOL_QUOTE_MARGIN_BPS=0               # a further margin on every quote, against the customer
# Pyth's SOL/USD price account (the same address on mainnet and devnet), its
# feed id, and the program or programs allowed to own it. A wrong value makes
# the price refuse; it cannot misprice.
# PYTH_SOL_USD_ACCOUNT="7UVimffxr9ow1uXYxsr4LHAcV58mLzhmwaeKvJ1pjLiE"
# PYTH_SOL_USD_FEED_ID="ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d"
# PYTH_PROGRAM_IDS="rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ"
# CHAIN_EXPIRY_MARGIN_BLOCKS=32        # how far past its last valid block a transfer is taken as unable to land

# --- Development-only switches (refused in production) ---------------------------
# ALLOW_NOSANA_MOCK=false              # mock Nosana jobs (also needs NODE_ENV=development)
# ALLOW_MOCK_CHECKOUT=false            # grant credits without Stripe

# --- Platform wallets ---------------------------------------------------------------
# FEE_ROUTER_WALLET_PRIVATE_KEY=""
# REPUTATION_ATTESTOR_PRIVATE_KEY=""

# --- Token launchpad ----------------------------------------------------------------
# LAUNCHPAD="pumpfun"                  # or "bags" (mainnet only), or "meteora" (Meteora's bonding curve, devnet and mainnet)
# METEORA_FEE_CLAIMER_ADDRESS=""       # required with LAUNCHPAD=meteora: the wallet that claims the platform's share of trading fees (an address, no key)
# METEORA_LEFTOVER_RECEIVER_ADDRESS="" # where a curve's unsold tokens go after graduation; defaults to the fee wallet
# METEORA_CURVE_CACHE_MS=5000          # how long a pool's state read from the chain is kept
# TOKEN_LAUNCH_MIN_REPUTATION=50       # the launch gate: reputation an agent needs before it may launch a token
# TOKEN_LAUNCH_MIN_DEPLOYMENT_AGE_DAYS=7  # the launch gate: days its oldest running deployment must have run
# BAGS_API_KEY=""
# BAGS_FEE_RECIPIENT=""                # a WheelsAI-controlled fee-claimer wallet

# --- x402 settlement and alerts --------------------------------------------------------
# X402_SETTLEMENT_INTERVAL_MS=15000
# X402_SETTLEMENT_BATCH_SIZE=25
# X402_QUOTE_TTL_SECONDS=120           # how long a SOL price quoted to a payer holds
# X402_CONFIRM_WAIT_MS=30000           # how long a paid request waits for its transfer to confirm
# X402_METRICS_HISTORY_LIMIT=168
# X402_METRICS_RETENTION_DAYS=30
# X402_METRICS_PRUNE_INTERVAL_MINUTES=60
# X402_ALERT_WEBHOOK_URL=""
# X402_ALERT_WEBHOOK_SECRET=""
# X402_ALERT_NOTIFY_COOLDOWN_MINUTES=30
# X402_ALERT_MAX_PENDING=25
# X402_ALERT_MAX_FAILED=15
# X402_ALERT_MAX_RETRIABLE=20
# X402_ALERT_MAX_FAILURE_RATE_PERCENT=20
# X402_ALERT_MAX_OLDEST_PENDING_MINUTES=30

# --- Slack app and GitHub App ------------------------------------------------------------
# SLACK_OAUTH_ENABLED=false
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""
# SLACK_SIGNING_SECRET=""
# GITHUB_APP_ENABLED=false
# GITHUB_APP_ID=""
# GITHUB_APP_SLUG=""
# GITHUB_APP_PRIVATE_KEY=""            # PEM, or base64-encoded PEM
# GITHUB_WEBHOOK_SECRET=""             # at least 16 characters

# --- Operations ----------------------------------------------------------------------------
# STATUS_PAGE_ORG_ID=""                # org whose uptime monitors the public /status page shows
# Measured latency: the public p50 is shown only above both thresholds, over the rolling window.
# One organization counts for at most MIN_SAMPLES / MIN_ORGS (rounded up) of its most recent requests.
# PUBLIC_LATENCY_WINDOW_HOURS=24
# PUBLIC_LATENCY_MIN_SAMPLES=50
# PUBLIC_LATENCY_MIN_ORGS=3
# PUBLIC_LATENCY_EXCLUDED_ORG_IDS=""   # comma-separated org ids (internal, test) kept out of the public figure
# LATENCY_SAMPLE_RETENTION_DAYS=30     # per-request timing rows older than this are deleted
# SENTRY_DSN=""
# METRICS_TOKEN=""                     # bearer token for GET /metrics
# PLATFORM_ADMIN_KEY=""                # marketplace curation (featured listings) and the operator's views of
#                                      # GPU compute (GET /api/platform/compute) and of the money
#                                      # (GET /api/platform/money); at least 16 characters

# --- Custom domains (the edge proxy in infra/edge; see apps/api/src/config/customDomains.ts) ---
# Unset = custom domains are "not configured on this server": the API answers
# 501 custom_domains_not_configured and the dashboard says so. They switch on
# only when the hostname, at least one address and both secrets are all valid;
# a partial or malformed set is reported as misconfigured, never half-working.
# CUSTOM_DOMAIN_EDGE_HOSTNAME=""       # DNS name of the edge; the CNAME target customers point at
# CUSTOM_DOMAIN_EDGE_IPV4=""           # comma list of EVERY public IPv4 address of the edge
# CUSTOM_DOMAIN_EDGE_IPV6=""           # comma list of EVERY public IPv6 address of the edge
# CUSTOM_DOMAIN_ASK_TOKEN=""           # shared with the edge (its certificate question); at least 32 characters
# CUSTOM_DOMAIN_EDGE_SECRET=""         # shared with the edge (forwarded requests); at least 32 characters, not the ask token
# CUSTOM_DOMAIN_DNS_SERVERS=""         # resolvers the checker queries, e.g. "1.1.1.1,8.8.8.8"; unset = the host's
# CUSTOM_DOMAIN_CHECK_INTERVAL_MS=60000   # how often due domains are looked for; 0 disables the checker
# CUSTOM_DOMAIN_ROUTE_REFRESH_MS=10000    # how often the host routing table is reloaded (1000 to 60000)
# CUSTOM_DOMAIN_PROBE_TIMEOUT_MS=20000    # limit of one certificate probe (1000 to 120000)
# CUSTOM_DOMAIN_PROBE_EXTRA_CA_PEM=""  # staging only: an extra trust root for the prober; refused in production
# Platform safety limits (not plan limits): they protect the one certificate-authority
# account and the checker that every organization shares.
# CUSTOM_DOMAIN_MAX_PER_ORG=25                # custom domains one organization may have, in any state
# CUSTOM_DOMAIN_ISSUANCE_ORG_LIMIT=30         # new-certificate permissions per organization per 3 hours
# CUSTOM_DOMAIN_ISSUANCE_PLATFORM_LIMIT=200   # the same across all organizations; keep below the CA's account limit (Let's Encrypt: 300 per 3 hours)
# The edge itself (fly secrets on the edge app, not read by the API): ACME_EMAIL,
# and the same CUSTOM_DOMAIN_ASK_TOKEN and CUSTOM_DOMAIN_EDGE_SECRET as above.

# --- Web app (apps/web)----------------------------------------------------------------------
# NEXT_PUBLIC_SOLANA_CLUSTER="devnet"   # "mainnet-beta" on mainnet: it is where explorer links open
# NEXT_PUBLIC_SOLANA_RPC_URL=""
# NEXT_PUBLIC_LAUNCHPAD="pumpfun"      # the launchpad's name in the wizard: "pumpfun", "bags" or "meteora"
# NEXT_PUBLIC_ENABLE_TOKEN_UI=false
# NEXT_PUBLIC_ENABLE_TRADING=false
