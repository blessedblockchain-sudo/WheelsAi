// WheelsAI Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider        = "prisma-client-js"
  // postgresqlExtensions lets the datasource declare `vector` so Prisma
  // creates it in the shadow database during migrate/diff — without it,
  // every migration run fails on the unknown `vector` type (W2 RAG).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================
// Users and Authentication
// ============================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  passwordHash  String?   @map("password_hash")
  walletAddress String?   @unique @map("wallet_address")
  displayName   String?   @map("display_name")
  emailVerified Boolean   @default(false) @map("email_verified")
  metadata      Json?     @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  ownedOrganizations Organization[] @relation("OrgOwner")
  memberships        OrgMember[]
  contributions      AgentContributor[]
  twoFactorAuth      TwoFactorAuth?
  emailTokens        EmailToken[]

  @@map("users")
}

// One-time links sent by email (verify address, reset password). Only the
// SHA-256 of the token is stored; the token itself exists only in the
// email. `email` pins the address the link was sent to, so a verification
// link stops working if the account's email changes afterwards.
model EmailToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String // 'verify_email' | 'reset_password'
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  // Set once, by the compare-and-swap that grants the signup bonus after
  // the owner verifies an email. Null = bonus not yet granted.
  signupBonusGrantedAt DateTime? @map("signup_bonus_granted_at")
  subscription         OrgSubscription?

  branding  Json?    @default("{}")

  owner         User            @relation("OrgOwner", fields: [ownerId], references: [id])
  members       OrgMember[]
  apiKeys       ApiKey[]
  deployments   Deployment[]
  agents        Agent[]
  trainingJobs  TrainingJob[]
  fineTunedModels FineTunedModel[]
  datasets      Dataset[]
  creditBalance CreditBalance?
  transactions  CreditTransaction[]
  usageRecords  UsageRecord[]
  agentWallets  AgentWallet[]
  x402Payments  X402Payment[]
  x402SettlementMetrics X402SettlementMetric[]
  stripePurchases StripePurchase[]
  walletTopUps    WalletTopUp[]
  depositAddress  DepositAddress?
  onchainReceipts OnchainReceipt[]
  chainTransfers  ChainTransfer[]

  // Marketplace relations
  publisherProfile   PublisherProfile?
  publishedListings  AgentListing[]     @relation("PublishedAgents")
  agentReviews       AgentReview[]      @relation("AgentReviews")
  agentInstalls      AgentInstall[]     @relation("AgentInstalls")
  agentSubscriptions AgentSubscription[] @relation("AgentSubscriptions")
  creatorPayouts     CreatorPayout[]    @relation("CreatorPayouts")
  earningsTransactions EarningsTransaction[]
  offerings          Offering[]          @relation("PublishedOfferings")
  jobsHired          Job[]               @relation("JobsHired")
  jobsReceived       Job[]               @relation("JobsReceived")
  widgetKeys         WidgetKey[]

  @@map("organizations")
}

model OrgMember {
  orgId  String @map("org_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role   String // 'owner', 'admin', 'member'

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("org_members")
}

// ============================================
// API Keys
// ============================================

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix") // First 8 chars for display
  name       String?
  scopes     String[]  @default([])
  // Set on a key granted jobs:hire: the most one job may cost, and the most
  // the key may spend in one UTC day (ApiKeySpendWindow).
  maxJobPriceCents   BigInt?   @map("max_job_price_cents")
  dailySpendCapCents BigInt?   @map("daily_spend_cap_cents")
  // Set on a key granted agents:use: the most one paid use of somebody
  // else's agent may cost. The day's cap above is shared with jobs.
  maxUsePriceCents   BigInt?   @map("max_use_price_cents")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  spendWindows ApiKeySpendWindow[]

  @@map("api_keys")
}

/// What one API key has spent on jobs in one UTC day. The hire transaction
/// raises spentCents by compare-and-set against the key's daily cap.
model ApiKeySpendWindow {
  apiKeyId   String   @map("api_key_id") @db.Uuid
  day        DateTime @db.Date
  spentCents BigInt   @default(0) @map("spent_cents")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, day])
  @@map("api_key_spend_windows")
}

// ============================================
// Model Catalog
// ============================================

model Model {
  id               String   @id // e.g., "llama-3.1-8b"
  hfId             String   @map("hf_id") // HuggingFace model ID
  ollamaModelId    String?  @map("ollama_model_id") // Ollama model name (e.g., "llama3.1:8b")
  displayName      String   @map("display_name")
  description      String?
  parameters       BigInt? // 8B, 70B, etc.
  minGpuTier       String   @map("min_gpu_tier")
  supportedEngines String[] @map("supported_engines")
  defaultEngine    String   @map("default_engine")
  contextLength    Int      @map("context_length")
  license          String?
  tags             String[] @default([])
  pricingTier      String   @map("pricing_tier") // 'small', 'medium', 'large'
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  deployments     Deployment[]
  fineTunedModels FineTunedModel[]

  @@map("models")
}

// ============================================
// Deployments
// ============================================

model Deployment {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  name         String
  slug         String
  modelId      String    @map("model_id")
  engine       String
  gpuTier      String    @map("gpu_tier")
  replicas     Int       @default(1)
  config       Json
  status       String    // 'pending', 'provisioning', 'running', 'degraded', 'stopped', 'failed'
  nosanaJobIds String[]  @map("nosana_job_ids")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  stoppedAt    DateTime? @map("stopped_at")

  // Credit reservation taken at admission (deploymentCreditGate). Stored
  // so the release refunds the EXACT amount held, rather than recomputing
  // it from a price table that may have changed since. releasedAt is the
  // idempotency key: the release CASes on it being null.
  reservationCents      BigInt?   @map("reservation_cents")
  reservationReleasedAt DateTime? @map("reservation_released_at")

  // Nosana lifecycle (W2). nosanaJobIds[0] is the Nosana Deployment-Manager
  // id (NOT an on-chain job address).
  //
  // billedThroughAt is the per-second GPU billing cursor: usage up to this
  // instant has been charged to the org (ledger type 'gpu_usage'). It is
  // set when the status worker first observes the deployment running with
  // a live endpoint, and advanced ONLY by a compare-and-set on its previous
  // value, so concurrent billing ticks cannot bill a window twice.
  billedThroughAt DateTime? @map("billed_through_at")
  // Why the deployment left service ('nosana_error', 'insufficient_credits',
  // 'user_stopped', ...). Null while healthy.
  statusReason String? @map("status_reason")
  // Set once the platform's Nosana vault funds were verified recovered
  // (vault.withdraw + zero-balance check). Null on a stopped/failed
  // deployment means the status worker still has to retry the reclaim.
  vaultReclaimedAt DateTime? @map("vault_reclaimed_at")
  // Which RUN of this row is current. A restart reuses the row for a new
  // Nosana deployment and bumps this inside its claim; every writer that can
  // land late (a slow submit, stop, status tick, billing stop) carries the
  // generation it read and makes its write conditional on it, so an earlier
  // run's result can never be written onto a later run.
  runGeneration Int @default(0) @map("run_generation")

  // A replica change in flight (PATCH). `replicas` is the CONFIRMED count -
  // what Nosana is known to run and what billing charges - and only moves once
  // Nosana has confirmed the change. Until then the target sits here as a
  // claim: replicaChangeId is its token (null = no change in flight), so a
  // second PATCH cannot claim, and the request that made the claim commits or
  // clears it by CAS on its own token. A claim left behind by a crash or an
  // ambiguous Nosana failure is resolved by the status worker from Nosana's
  // real replica count once replicaChangeAt is stale.
  pendingReplicas  Int?      @map("pending_replicas")
  replicaChangeId  String?   @map("replica_change_id")
  replicaChangeAt  DateTime? @map("replica_change_at")
  // Credits added to the hold by a pending scale-UP claim, so clearing the
  // claim returns exactly what it took.
  replicaChangeHoldCents BigInt? @map("replica_change_hold_cents")
  // When Nosana confirmed this run's GPUs stopped. Written right after the
  // stop call, before (and outside) the transaction that marks the row
  // stopped: if that transaction fails, the retry ends the final billing
  // window here instead of at its own later clock.
  gpuStoppedAt DateTime? @map("gpu_stopped_at")
  // Last Nosana vault runway check, claimed by CAS so the billing workers of
  // several API replicas check a deployment once per interval between them.
  runwayCheckedAt DateTime? @map("runway_checked_at")
  // Which Nosana credential created nosanaJobIds[0]: 'wallet' | 'api_key'.
  // Null means wallet (every row from before API-key access). Written in the
  // statement that stores the id; every later call on the id passes it, so a
  // deployment is stopped through the account that owns it.
  nosanaAccessMode String? @map("nosana_access_mode")
  // Automatic restarts (a health_check task's onDown = restart_deployment)
  // tried in the current window, and when the last one was. Claimed by CAS
  // before each restart so the limit and its backoff hold across every task
  // watching this deployment; cleared when the owner restarts it by hand.
  autoRestartCount  Int       @default(0) @map("auto_restart_count")
  lastAutoRestartAt DateTime? @map("last_auto_restart_at")
  // Set when the deployment serves a fine-tuned adapter on top of modelId
  // (the base model). A fine-tuned model that a deployment row still names
  // cannot be removed (it is soft-deleted). NoAction and not Restrict: both
  // refuse the delete, but NoAction is checked at the end of the statement,
  // so deleting an organization can still cascade through both tables.
  fineTunedModelId String? @map("fine_tuned_model_id") @db.Uuid

  org          Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  model        Model            @relation(fields: [modelId], references: [id])
  fineTunedModel FineTunedModel? @relation(fields: [fineTunedModelId], references: [id], onDelete: NoAction)
  nodes        DeploymentNode[]
  usageRecords UsageRecord[]
  agentWallet  AgentWallet?

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([status])
  @@index([fineTunedModelId])
  @@map("deployments")
}

model DeploymentNode {
  id              String    @id @default(uuid()) @db.Uuid
  deploymentId    String    @map("deployment_id") @db.Uuid
  nosanaNodeId    String    @map("nosana_node_id")
  nodeUrl         String    @map("node_url")
  healthStatus    String    @default("unknown") @map("health_status")
  lastHealthCheck DateTime? @map("last_health_check")
  latencyMs       Int?      @map("latency_ms")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@map("deployment_nodes")
}

// A Nosana deployment the platform funded that no deployment row tracks (any
// longer): its writer lost a compare-and-set to a later run, its row was
// deleted, or its table has no vault stamp (agent deployments, training jobs).
// The status worker's vault sweep stops it if it is still running and retries
// the vault withdraw until the funds are verified recovered (reclaimedAt).
model NosanaOrphanDeployment {
  id                 String    @id @default(uuid()) @db.Uuid
  nosanaDeploymentId String    @unique @map("nosana_deployment_id")
  // Where the id came from, for an operator. Not a relation: the source row
  // may already be gone.
  sourceKind         String    @map("source_kind") // 'model', 'agent', 'training'
  sourceId           String?   @map("source_id")
  reason             String
  // The Nosana credential that created it ('wallet' | 'api_key'; null = wallet).
  accessMode         String?   @map("access_mode")
  createdAt          DateTime  @default(now()) @map("created_at")
  reclaimedAt        DateTime? @map("reclaimed_at")

  @@index([reclaimedAt, createdAt])
  @@map("nosana_orphan_deployments")
}

// ============================================
// Billing and Credits
// ============================================

model CreditBalance {
  orgId       String   @id @map("org_id") @db.Uuid
  balanceCents BigInt  @default(0) @map("balance_cents")
  // x402 payments returned to this organization that do not yet make a
  // whole cent, in millionths of a dollar. A request paid by x402 costs a
  // fraction of a cent; when one is returned it lands here, and whole cents
  // move to the balance with a ledger row.
  x402RefundCarryMicroUsd BigInt @default(0) @map("x402_refund_carry_micro_usd")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Cascade is correct here, unlike the tables above (G6): this row is derived
  // current state, reconstructible by summing credit_transactions. Losing it
  // with the org loses no history.
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("credit_balances")
}

model CreditTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  amountCents  BigInt   @map("amount_cents") // Positive = credit, negative = debit
  type         String // 'purchase', 'bonus', 'payout_credit' (a creator's payout taken as credits), 'usage', 'refund', 'adjustment', 'marketplace_job', 'marketplace_job_refund' and the other charge and refund types the API writes
  description  String?
  referenceId  String?  @map("reference_id") // Stripe charge ID, usage period, etc.
  balanceAfter BigInt   @map("balance_after")
  // GPU-seconds this row charged for: the seconds of the window times the
  // replicas that ran, for 'gpu_usage'; the seconds billed, for
  // 'training_usage'. Null on every other row. It is what "GPU hours" on the
  // Billing page is the sum of: measured, never estimated.
  gpuSeconds   BigInt?  @map("gpu_seconds")
  createdAt    DateTime @default(now()) @map("created_at")

  // Restrict, not Cascade (G6): this table IS the billing audit trail. A
  // cascade meant deleting an organization silently destroyed every record of
  // what it had been charged. Postgres now refuses the delete, forcing
  // whoever implements account deletion to make an explicit decision —
  // export, anonymise, or archive — instead of losing the evidence by
  // default. See also usage_records and x402_payments.
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("credit_transactions")
}

// Purchase-intent row for the Stripe rail (B2/T2). One row per Checkout
// Session, created BEFORE redirecting the buyer to Stripe. The webhook
// grants credits only by winning the status CAS created→completed on
// this row — that CAS is the idempotency barrier that makes Stripe's
// at-least-once event delivery safe.
model StripePurchase {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  stripeSessionId String    @unique @map("stripe_session_id")
  // Set when the session completes; refunds arrive keyed by it.
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  // Cents already clawed back by refunds (never more than amount + bonus).
  refundedCents   BigInt    @default(0) @map("refunded_cents")
  // Paid amount in cents. The grant = amountCents + bonusCents.
  amountCents     BigInt    @map("amount_cents")
  // Bonus SNAPSHOT at checkout creation — the buyer was quoted this
  // number. If the ladder changes before the webhook arrives, the quote
  // wins, not the current ladder.
  bonusCents      BigInt    @default(0) @map("bonus_cents")
  status          String    @default("created") // 'created' | 'completed' | 'failed' | 'expired'
  completedAt     DateTime? @map("completed_at")
  failureReason   String?   @map("failure_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Restrict (G6): a record of money changing hands. Same reasoning as
  // credit_transactions.
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([status])
  @@map("stripe_purchases")
}

// The organization's platform plan (Starter / Pro / Enterprise). Pro is
// driven by Stripe subscription webhooks; Enterprise is set by an operator.
// No row means Starter.
model OrgSubscription {
  orgId                String    @id @map("org_id") @db.Uuid
  plan                 String    @default("starter") // 'starter' | 'pro' | 'enterprise'
  // Stripe subscription status ('trialing' | 'active' | 'past_due' |
  // 'canceled' | 'unpaid' | 'incomplete' | 'incomplete_expired' | 'paused'),
  // or 'manual' for operator-granted plans.
  status               String    @default("none")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime? @map("current_period_end")
  trialEndsAt          DateTime? @map("trial_ends_at")
  trialUsedAt          DateTime? @map("trial_used_at")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  // Webhooks can arrive out of order; older events never overwrite newer.
  lastStripeEventAt    DateTime? @map("last_stripe_event_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@map("org_subscriptions")
}

// Stripe webhook idempotency: an event id is processed at most once.
model StripeEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}

// "Contact sales" requests from the website.
model ContactRequest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  company   String?
  topic     String   @default("enterprise") // 'enterprise' | 'support' | 'other'
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_requests")
}

// Purchase-intent row for the Solana wallet rail (B2/T2). One row per
// prepared top-up transaction. The server builds the UNSIGNED transfer,
// stores its exact message bytes here, and /submit accepts a signed
// transaction only if its message bytes equal unsignedMessageB64 — the
// user provably signed exactly what we prepared (recipient, amount,
// blockhash all pinned).
model WalletTopUp {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  asset          String    // 'USDC' (production rail) | 'SOL' (devnet test rail)
  network        String    // 'solana:devnet' | 'solana:mainnet' — mirrors x402_payments
  // Credit value of the top-up in USD cents (pre-bonus). The grant =
  // amountUsdCents + bonusCents.
  amountUsdCents BigInt    @map("amount_usd_cents")
  // Bonus snapshot at prepare time — same quote-wins rule as
  // stripe_purchases.
  bonusCents     BigInt    @default(0) @map("bonus_cents")
  // On-chain amount in base units (lamports / USDC-6dp) as a string,
  // mirroring x402_payments.amount_raw.
  amountRaw      String    @map("amount_raw")
  // SOL rail only: the SOL/USD quote used to convert amountUsdCents to
  // lamports, recorded so the grant is auditable against the quote.
  quotedSolPriceUsd Float? @map("quoted_sol_price_usd")
  // The wallet that must sign — pinned at prepare, cross-checked at
  // submit against the authenticated user.
  payerAddress   String    @map("payer_address")
  // Per-org deposit address (HKDF from WALLET_MASTER_KEY, salt
  // "wheelsai-topup-v1"): funds are attributable on-chain by address
  // alone, and sweepable because the key is re-derivable.
  depositAddress String    @map("deposit_address")
  // Exact serialized message bytes of the prepared transaction — the
  // byte-equality anchor for /submit.
  unsignedMessageB64 String @map("unsigned_message_b64")
  // The submitted transaction's signature. UNIQUE is the double-credit
  // guard: one on-chain transaction can never credit two rows.
  txSignature    String?   @unique @map("tx_signature")
  status         String    @default("prepared") // 'prepared' | 'submitting' | 'submitted' | 'credited' | 'failed' | 'expired'
  // The chain's or the node's own words about a failure, kept for
  // operators. Never sent to a customer: the customer's sentence is
  // chosen from failureCode.
  failureReason  String?   @map("failure_reason")
  // Why the row ended, as a code (services/topupSentences.ts):
  // 'unsigned_expired' | 'never_landed' | 'failed_on_chain'. Null on rows
  // from before the codes existed.
  failureCode    String?   @map("failure_code")
  // The signed transaction exactly as the wallet returned it, stored by
  // the same compare-and-set that records txSignature, BEFORE broadcast.
  // A wallet may add its own fee and guard instructions, so these bytes
  // can differ from unsignedMessageB64. They are what is sent again while
  // the transaction can still land.
  signedTxB64    String?   @map("signed_tx_b64")
  // SOL only: the exact price the amount was worked out from, in
  // micro-dollars per SOL after the lean, the price's own publish time,
  // and where it came from ('pyth' | 'static'). quotedSolPriceUsd above
  // is the same figure as a number, for display.
  quotePriceMicroUsd BigInt?   @map("quote_price_micro_usd")
  quotePublishTime   DateTime? @map("quote_publish_time")
  quoteSource        String?   @map("quote_source")
  // When the signed transfer was first handed to the network.
  submittedAt    DateTime? @map("submitted_at")
  // Blockhash validity horizon: past this, the prepared tx can never
  // land and the row is re-preparable, never revivable. expiresAt is the
  // wall-clock UX horizon; lastValidBlockHeight is the CHAIN truth —
  // reconcile declares a submitted tx dead only when the current block
  // height has passed it.
  expiresAt      DateTime  @map("expires_at")
  lastValidBlockHeight BigInt @map("last_valid_block_height")
  creditedAt     DateTime? @map("credited_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Restrict (G6): a record of money changing hands. Same reasoning as
  // credit_transactions.
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  // The on-chain transfer this top-up was credited for (onchain_receipts).
  receipt OnchainReceipt?

  @@index([orgId, createdAt])
  @@index([status])
  @@map("wallet_topups")
}

// An organization's own address for paying in without a prepared top-up:
// a withdrawal from an exchange, a transfer from any wallet. It is the
// address its prepared top-ups already pay into, derived from
// WALLET_MASTER_KEY and the organization (services/topupKeypairs.ts). The
// row exists so the address can be shown, watched and, later, emptied; the
// USDC token account at the address is not stored, it is derived from the
// mint and the address.
//
// Customers save this address, so the master key must never change under
// it. An address stored here that is not the one this server derives is
// left alone and reported, never shown or scanned.
model DepositAddress {
  orgId                  String    @id @map("org_id") @db.Uuid
  address                String    @unique
  network                String // 'solana:devnet' | 'solana:mainnet'
  // The USDC account at the address. openedAt is when it was first seen
  // to exist (it is never closed, so nothing reads the chain for it after
  // that); openedBy is 'platform' when the platform paid to open it
  // ("Prepare address"), null when the sender did. requestedAt is when
  // the platform last sent a transaction to open it: what the limit for
  // a day counts, and what stops two sends in a row.
  usdcAccountOpenedAt    DateTime? @map("usdc_account_opened_at")
  usdcAccountOpenedBy    String?   @map("usdc_account_opened_by")
  usdcAccountRequestedAt DateTime? @map("usdc_account_requested_at")
  // How far the history of the address and of its USDC account has been
  // read: the newest signature already processed for each.
  lastSolSignature       String?   @map("last_sol_signature")
  lastUsdcSignature      String?   @map("last_usdc_signature")
  // What the address held when it was last read. A balance that differs
  // is what triggers a read of its history.
  lastSeenLamports       BigInt    @default(0) @map("last_seen_lamports")
  lastSeenUsdcRaw        BigInt    @default(0) @map("last_seen_usdc_raw")
  // Set by "Check now"; cleared by the scan that answers it.
  scanRequestedAt        DateTime? @map("scan_requested_at")
  lastScannedAt          DateTime? @map("last_scanned_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([lastScannedAt])
  @@map("deposit_addresses")
}

// One row for every on-chain transfer that was, or is waiting to be,
// credited: the transfer of a prepared top-up and a transfer sent straight
// to a deposit address alike. UNIQUE (network, tx_signature, asset) is what
// makes "one transfer is credited once" a fact of the database: whichever
// path sees a transfer first writes the row inside its crediting
// transaction, and the other path finds it there.
model OnchainReceipt {
  id                 String    @id @default(uuid()) @db.Uuid
  network            String // 'solana:devnet' | 'solana:mainnet'
  txSignature        String    @map("tx_signature")
  asset              String // 'USDC' | 'SOL'
  orgId              String    @map("org_id") @db.Uuid
  depositAddress     String    @map("deposit_address")
  // What arrived, in base units (lamports, or USDC with 6 decimals).
  amountRaw          BigInt    @map("amount_raw")
  slot               BigInt?
  blockTime          DateTime? @map("block_time")
  // The signers of the transaction, for the record.
  senderAddresses    String[]  @default([]) @map("sender_addresses")
  // 'prepared': the transfer of a prepared top-up (topupId is set).
  // 'direct': sent straight to the address.
  source             String
  topupId            String?   @unique @map("topup_id") @db.Uuid
  // 'detected': seen, not credited yet (a SOL transfer waiting for a price).
  // 'credited': the credits were granted in the transaction that set this.
  // 'ignored': not credited, and why is in ignoredReason.
  status             String    @default("detected")
  ignoredReason      String?   @map("ignored_reason")
  amountUsdCents     BigInt?   @map("amount_usd_cents")
  bonusCents         BigInt    @default(0) @map("bonus_cents")
  // SOL only: the exact price the credit was worked out from.
  quotePriceMicroUsd BigInt?   @map("quote_price_micro_usd")
  quotePublishTime   DateTime? @map("quote_publish_time")
  quoteSource        String?   @map("quote_source")
  creditedAt         DateTime? @map("credited_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Restrict: a record of money changing hands.
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  topup WalletTopUp? @relation(fields: [topupId], references: [id], onDelete: Restrict)

  @@unique([network, txSignature, asset])
  @@index([orgId, createdAt])
  @@index([status])
  @@map("onchain_receipts")
}

// A transfer the platform itself sends on chain: moving what customers
// paid off their deposit addresses, to the wallet that pays creators (the
// hot wallet) or to the treasury. Claim first: the row is written with its
// signature, the signed bytes and the last block height they can land at
// BEFORE anything is broadcast, and only what the chain says ends it.
//
// One 'sent' row at a time per sending address and asset: a partial unique
// index in the migration (Prisma does not model it).
model ChainTransfer {
  id                   String    @id @default(uuid()) @db.Uuid
  // 'sweep_to_hot' | 'sweep_to_treasury' | 'hot_to_treasury'
  kind                 String
  network              String // 'solana:devnet' | 'solana:mainnet'
  asset                String // 'USDC' | 'SOL'
  fromAddress          String    @map("from_address")
  toAddress            String    @map("to_address")
  // The organization whose deposit address it left; null for a transfer
  // from the hot wallet.
  orgId                String?   @map("org_id") @db.Uuid
  // Base units: lamports, or USDC with 6 decimals.
  amountRaw            BigInt    @map("amount_raw")
  // What the transaction cost, and who paid it. A SOL sweep pays its own
  // fee out of the address it empties; the hot wallet pays for the rest.
  feeLamports          BigInt    @default(0) @map("fee_lamports")
  feePayer             String    @map("fee_payer")
  // 'sent': signed and handed to the network, not ended yet.
  // 'landed' | 'failed' (it failed on the chain) | 'dead' (it can no
  // longer land; the same money is planned again).
  status               String    @default("sent")
  txSignature          String    @unique @map("tx_signature")
  signedTxB64          String    @map("signed_tx_b64")
  lastValidBlockHeight BigInt    @map("last_valid_block_height")
  // The chain's own words about a failure, for operators.
  failureReason        String?   @map("failure_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  settledAt            DateTime? @map("settled_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Restrict: a record of money moving.
  org Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([fromAddress, asset])
  @@index([orgId, createdAt])
  @@map("chain_transfers")
}

// The platform's wallets that are not derived from the master key.
// 'treasury': where money leaves the product to. It is used only after it
// was proven (scripts/treasury-verify.ts): a transfer from that address to
// the hot wallet, signed by it. An address that is not the one in
// TREASURY_WALLET_ADDRESS is never sent to, whatever this row says.
model PlatformWallet {
  role           String // 'treasury'
  network        String // 'solana:devnet' | 'solana:mainnet'
  address        String
  verifiedAt     DateTime @map("verified_at")
  // The transfer that proved it.
  proofSignature String   @map("proof_signature")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([role, network])
  @@map("platform_wallets")
}

// ============================================
// Usage Tracking
// ============================================

model UsageRecord {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  deploymentId  String   @map("deployment_id") @db.Uuid
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  requestCount  Int      @default(0) @map("request_count")
  inputTokens   BigInt   @default(0) @map("input_tokens")
  outputTokens  BigInt   @default(0) @map("output_tokens")
  totalLatencyMs BigInt  @default(0) @map("total_latency_ms")
  errorCount    Int      @default(0) @map("error_count")
  costCents     BigInt   @default(0) @map("cost_cents")
  // Actual GPU-seconds consumed on Nosana (sum of job end-start across this
  // period). Distinct from totalLatencyMs, which is end-to-end request latency.
  computeSeconds  BigInt @default(0) @map("compute_seconds")
  // Authoritative compute cost derived from MARKETS[tier].pricePerSecond *
  // computeSeconds. costCents is kept for backwards compat during rollout.
  actualCostCents BigInt @default(0) @map("actual_cost_cents")

  // Restrict on both (G6): usage is the basis every credit charge is computed
  // from, so it has to outlive the org and the deployment it describes.
  // Neither hard delete is reachable today (DELETE /api/deployments only sets
  // status='stopped', and nothing deletes an organization at all), so this
  // closes the hole before someone opens it — e.g. when account deletion
  // ships for GDPR.
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  deployment Deployment   @relation(fields: [deploymentId], references: [id], onDelete: Restrict)

  @@unique([orgId, deploymentId, periodStart])
  @@index([orgId, periodStart])
  @@map("usage_records")
}

// ============================================
// Agent Wallets (Phase 2)
// ============================================

model AgentWallet {
  id              String  @id @default(uuid()) @db.Uuid
  orgId           String  @map("org_id") @db.Uuid
  deploymentId    String  @unique @map("deployment_id") @db.Uuid
  walletAddress   String  @unique @map("wallet_address")
  encryptedKey    Bytes   @map("encrypted_key")
  keyVersion      Int     @default(1) @map("key_version")
  dailyLimitCents BigInt? @map("daily_limit_cents")
  perTxLimitCents BigInt? @map("per_tx_limit_cents")
  allowedDomains  String[] @default([]) @map("allowed_domains")
  isActive        Boolean @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deployment   Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  transactions AgentTransaction[]

  @@map("agent_wallets")
}

model AgentTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  direction     String   // 'in', 'out'
  amountLamports BigInt  @map("amount_lamports")
  token         String   // 'SOL', 'USDC', 'NOS'
  counterparty  String
  txSignature   String?  @unique @map("tx_signature")
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")

  wallet AgentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("agent_transactions")
}

// ============================================
// Agents (Phase 2)
// ============================================

model Agent {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  slug          String
  description   String?
  framework     String   // 'mastra', 'langchain', 'autogen', 'custom'

  // Agent configuration
  systemPrompt  String?  @map("system_prompt") @db.Text
  tools         Json     @default("[]") // Array of tool configurations
  modelConfig   Json     @map("model_config") // Model to use, temperature, etc.

  // Source code / definition
  sourceType    String   @map("source_type") // 'inline', 'github', 'ipfs'
  sourceUrl     String?  @map("source_url") // GitHub repo URL or IPFS hash
  sourceCode    String?  @map("source_code") @db.Text // Inline code if sourceType = 'inline'

  // Runtime configuration
  env           Json     @default("{}") // Environment variables (encrypted sensitive values)
  secrets       Bytes?   // Encrypted secrets blob

  // Optional RAG grounding (W2): when set, agent chat retrieves relevant
  // chunks from this knowledge base and grounds the answer in them.
  // Nullable by design — unbound agents behave exactly as before.
  // SetNull on delete: losing the knowledge base must un-ground the agent,
  // never delete it.
  knowledgeBaseId String? @map("knowledge_base_id") @db.Uuid

  // What answers a chat (playground and /v1): 'chat' runs the prompt, model
  // and tools above; 'graph' runs the graph saved in the builder
  // (AgentGraph). Set by the agent's owner; 'chat' unless they switch.
  entrypoint    String   @default("chat")

  // How people use the agent: 'conversation' (talk to it), 'task' (a short
  // form in, one result out) or 'scheduled' (it runs on its own). The kind
  // picks the front door and removes nothing: every agent still answers a
  // chat. Not named `kind`: /v1/models already answers wheelsai.kind.
  agentKind     String   @default("conversation") @map("agent_kind")
  // The kind's settings, one key per kind so that changing kind and back
  // loses nothing: { task?: { fields }, scheduled?: { schedule?, prompt? } }.
  // At most 16 KB (services/agentKind.ts). Null until a kind needs settings.
  kindConfig    Json?    @map("kind_config")

  // Metadata
  version       String   @default("1.0.0")
  isPublic      Boolean  @default(false) @map("is_public")
  // The agent's public address, /a/<handle>: unique across the platform, 3
  // to 40 lower-case letters, digits and hyphens (services/publicHandle.ts;
  // the database holds the same rule in agents_public_handle_check). Null
  // until the agent is first made public. Kept out of kindConfig: that JSON
  // is copied on install and restored on rollback, and an address or a
  // privacy switch must not travel that way.
  publicHandle  String?  @unique @map("public_handle")
  // A scheduled agent's latest results are shown on its public page only
  // when its owner turns this on.
  publicResults Boolean  @default(false) @map("public_results")
  tags          String[] @default([])

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase?    @relation("AgentKnowledgeBase", fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  deployments   AgentDeployment[]
  contributors  AgentContributor[]
  listing       AgentListing?
  offerings          Offering[]
  widgetKeys         WidgetKey[]        @relation("WidgetKeyAgent")
  // The one key that lets people use the agent from its public page.
  pageKey            WidgetKey?         @relation("AgentPageKey")
  graph         AgentGraph?
  openclawDeployment OpenClawDeployment?
  // Every scheduled task that runs this agent. The oldest agent_run task is
  // the agent's own schedule (services/agentOwnSchedule.ts). They go with
  // the agent, so a deleted agent leaves nothing firing.
  scheduledTasks     ScheduledTask[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("agents")
}

// ============================================
// Agent Collaboration
// ============================================

model AgentContributor {
  id           String    @id @default(uuid()) @db.Uuid
  agentId      String    @map("agent_id") @db.Uuid
  // Null while an invitation sent to an email is pending: the row is bound
  // to an account only when that account accepts, so the contributor list
  // cannot be used to learn whether an email has an account.
  userId       String?   @map("user_id") @db.Uuid
  // The address an invitation was sent to, trimmed and lowercased.
  invitedEmail String?   @map("invited_email")
  role         String    @default("contributor") // 'owner', 'contributor', 'reviewer'
  revenueShare Float     @default(0) @map("revenue_share") // 0.0 to 1.0 (display mirror)
  // Basis points (0–10000) — integer source of truth for revenue-split
  // math + the ≤100% invariant (remediation D9). revenueShare is kept as
  // a derived display mirror (= bps / 10000).
  revenueShareBps Int    @default(0) @map("revenue_share_bps")
  addedBy      String?   @map("added_by") @db.Uuid
  acceptedAt   DateTime? @map("accepted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@unique([agentId, invitedEmail])
  @@index([agentId])
  @@index([userId])
  @@map("agent_contributors")
}

// Hourly rollup of agent chat traffic, written by the shared agent-chat
// service (apps/api/src/services/agentUsage.ts) for every chat that was
// admitted: playground and /v1, streamed or not, answered or failed.
// No relations on purpose: agents are hard-deleted and their usage history
// must survive them.
model AgentUsageRecord {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  agentId      String   @map("agent_id") @db.Uuid
  // 'playground' | 'api' | 'widget'
  source       String
  // Start of the UTC hour.
  periodStart  DateTime @map("period_start")
  requestCount Int      @default(0) @map("request_count")
  // Chats that produced no answer. A client that hung up is not an error.
  errorCount   Int      @default(0) @map("error_count")
  streamedCount Int     @default(0) @map("streamed_count")
  inputTokens  BigInt   @default(0) @map("input_tokens")
  outputTokens BigInt   @default(0) @map("output_tokens")
  // Answered chats whose provider reported no token usage. Their tokens are
  // NOT in the two sums above; nothing is zero-filled or estimated.
  usageUnreportedCount Int @default(0) @map("usage_unreported_count")
  // Answered chats only, so an average is not skewed by fast failures.
  totalLatencyMs BigInt @default(0) @map("total_latency_ms")
  toolCallCount Int     @default(0) @map("tool_call_count")
  // Answered chats per latency bucket (LATENCY_BUCKETS_MS in agentUsage.ts),
  // for percentiles. Incremented element-wise in SQL.
  latencyHistogram Int[] @default([]) @map("latency_histogram")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([agentId, source, periodStart])
  @@index([orgId, periodStart])
  @@map("agent_usage_records")
}

// One row per chat request that reached a model: the single source every
// stated latency is computed from (services/latencySamples.ts). Append-only
// telemetry with no relations - nothing is checked on the request path, and
// a deleted agent's past timings stay true. Holds timings, never content.
// Pruned after LATENCY_SAMPLE_RETENTION_DAYS. No seed may write here.
model RequestLatencySample {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  // Which way the request came in: 'v1' | 'deployment_chat' |
  // 'deployment_step' for a model deployment, 'agent_<source>' for an agent
  // chat (LATENCY_SURFACES in latencySamples.ts).
  surface      String
  agentId      String?  @map("agent_id") @db.Uuid
  deploymentId String?  @map("deployment_id") @db.Uuid
  model        String?
  // 'nosana' | 'nosana_mock' | 'groq' | 'google' | ... | 'unknown'
  provider     String
  streamed     Boolean  @default(false)
  // 'ok' | 'error' | 'timeout' | 'cancelled'
  outcome      String
  statusCode   Int?     @map("status_code")
  // From the API receiving the request to the end of the answer.
  totalMs      Int      @map("total_ms")
  // The part spent inside the inference node call, where that is separable.
  upstreamMs   Int?     @map("upstream_ms")
  // From receipt to the first content of a streamed answer.
  firstTokenMs Int?     @map("first_token_ms")
  // As reported by the model; null when it reported none.
  outputTokens Int?     @map("output_tokens")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([orgId, createdAt])
  @@index([deploymentId, createdAt])
  @@index([agentId, createdAt])
  @@map("request_latency_samples")
}

model AgentDeployment {
  id            String   @id @default(uuid()) @db.Uuid
  agentId       String   @map("agent_id") @db.Uuid

  // Deployment configuration
  gpuTier       String   @map("gpu_tier")
  replicas      Int      @default(1)

  // Model deployment reference (if using dedicated model)
  modelDeploymentId String? @map("model_deployment_id") @db.Uuid

  // External model endpoint (if using external API)
  externalModelUrl  String? @map("external_model_url")
  externalModelKey  Bytes?  @map("external_model_key") // Encrypted

  // Status
  status        String   @default("pending") // 'pending', 'building', 'deploying', 'running', 'stopped', 'failed'
  // Legacy column, no longer written or returned. The agent's endpoint is the
  // platform API's /v1/agents/<slug>, computed on read from PUBLIC_API_URL
  // (apps/api/src/services/publicEndpoints.ts).
  endpoint      String?
  nosanaJobIds  String[] @map("nosana_job_ids")
  // The Nosana credential that created nosanaJobIds ('wallet' | 'api_key'; null = wallet).
  nosanaAccessMode String? @map("nosana_access_mode")

  // Wallet for autonomous payments
  walletId      String?  @unique @map("wallet_id") @db.Uuid

  // Logs and metrics
  buildLogs     String?  @map("build_logs") @db.Text
  lastError     String?  @map("last_error")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  stoppedAt     DateTime? @map("stopped_at")

  // Credit reservation taken at admission (deploymentCreditGate). Stored
  // so the release refunds the EXACT amount held, rather than recomputing
  // it from a price table that may have changed since. releasedAt is the
  // idempotency key: the release CASes on it being null.
  reservationCents      BigInt?   @map("reservation_cents")
  reservationReleasedAt DateTime? @map("reservation_released_at")

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_deployments")
}

// ============================================
// Training Studio (Phase 2)
// ============================================

model Dataset {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  // The name while the dataset is live, NULL once it is deleted. The unique
  // index is on this column, so a deleted dataset keeps its name for the
  // jobs that used it and the name is free for a new upload.
  liveName      String?  @map("live_name")
  description   String?

  // Storage
  storageType   String   @map("storage_type") // 's3', 'local'
  storageUrl    String   @map("storage_url") // 'store://<key>' (older rows: 's3://<bucket>/<key>')

  // Metadata
  format        String   // what the uploader declared; never overwritten
  fileType      String   @default("jsonl") @map("file_type") // 'jsonl', 'csv', 'parquet': decides the parser
  schemaFormat  String?  @map("schema_format") // detected by validation: 'alpaca', 'sharegpt', 'completion', 'text'
  sizeBytes     BigInt   @map("size_bytes")
  rowCount      Int      @map("row_count")
  // false when the rows could not be counted (a Parquet file with an
  // unreadable footer); rowCount is then a placeholder 0 that must not be
  // shown as "empty" or priced: read it through knownDatasetRowCount.
  rowCountKnown Boolean  @default(true) @map("row_count_known")
  // From the last validation, over every valid row (characters / 4).
  avgTokensPerRow Int?   @map("avg_tokens_per_row")
  totalTokens   BigInt?  @map("total_tokens")
  // What the last validation read: sha256 (hex) of the object's bytes and the
  // store's ETag at that moment. The counts above describe exactly these
  // bytes; a training run pins the sha256.
  contentSha256 String?  @map("content_sha256")
  contentEtag   String?  @map("content_etag")

  // Validation
  isValidated   Boolean  @default(false) @map("is_validated")
  validationErrors Json? @map("validation_errors")

  // Sample data for preview
  sampleRows    Json?    @map("sample_rows")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  // Soft delete: the row stays for the jobs that reference it.
  deletedAt     DateTime? @map("deleted_at")

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  trainingJobs  TrainingJob[]

  @@unique([orgId, liveName])
  @@index([orgId])
  @@map("datasets")
}

model TrainingJob {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String

  // Base model
  baseModelId   String   @map("base_model_id")
  baseModelHfId String   @map("base_model_hf_id")

  // Dataset
  datasetId     String   @map("dataset_id") @db.Uuid

  // Training method
  method        String   // 'lora' | 'qlora' (rows from before 20261012100000 may say 'full')

  // Hyperparameters
  config        Json     // what the request asked for (older rows: the old route's merged defaults)
  // Exactly the HYPERPARAMS object sent to the trainer (only keys it accepts).
  // Null on rows from before 20261012100000.
  hyperparams   Json?
  // Dataset.contentSha256 at admission: the bytes this run is pinned to.
  datasetSha256 String?  @map("dataset_sha256")

  // GPU requirements
  gpuTier       String   @map("gpu_tier")
  gpuCount      Int      @default(1) @map("gpu_count")

  // Status: 'pending', 'submitting', 'queued', 'running', 'finalizing',
  // 'completed', 'failed', 'cancelling', 'cancelled'. Every change is a
  // compare-and-set on the expected status (services/trainingStateMachine.ts).
  status        String   @default("pending")
  progress      Int      @default(0) // 0-100
  currentEpoch  Int?     @map("current_epoch")
  totalEpochs   Int?     @map("total_epochs")
  currentStep   Int?     @map("current_step")
  totalSteps    Int?     @map("total_steps")
  // Why a job failed, as a stable machine string (TRAINING_FAILURE_CODES).
  failureCode   String?  @map("failure_code")

  // Lifecycle. The run limit the user chose is the trainer's
  // MAX_RUNTIME_SECONDS and what the credit hold is sized by; the Nosana
  // timeout is that plus the set-up allowance, which the platform carries.
  maxRuntimeSeconds    Int?      @map("max_runtime_seconds")
  nosanaTimeoutSeconds Int?      @map("nosana_timeout_seconds")
  // One submit attempt: the nonce is part of the deployment name
  // (wheelsai-train-<job id>-<nonce>), so a deployment whose id was never
  // stored can still be found on Nosana.
  submitNonce          String?   @map("submit_nonce")
  submitStartedAt      DateTime? @map("submit_started_at")
  queuedAt             DateTime? @map("queued_at")
  // When the user asked for the cancel: a cancelled run is never billed past it.
  cancelRequestedAt    DateTime? @map("cancel_requested_at")
  // When the Nosana job ended or its stop was confirmed.
  gpuStoppedAt         DateTime? @map("gpu_stopped_at")
  // Trainer events: the highest seq stored (an event is applied only when
  // its seq is greater) and when it arrived.
  lastEventSeq         Int       @default(0) @map("last_event_seq")
  lastEventAt          DateTime? @map("last_event_at")
  // The trainer's own terminal event ('completed' or 'failed'), as reported.
  // A report, not a state: only the reconcile writes a terminal status.
  reportedOutcome      Json?     @map("reported_outcome")
  // When the poller last took this job up. It takes the least recently
  // examined first and stamps them as it takes them, so with more active jobs
  // than one tick examines every job is still reached (null = never, first).
  lastReconciledAt     DateTime? @map("last_reconciled_at")

  // Nosana integration
  nosanaJobId   String?  @map("nosana_job_id") // the Deployment-Manager id
  // The on-chain job of that deployment, once Nosana lists it.
  nosanaJobAddress String? @map("nosana_job_address")
  // The Nosana credential that created nosanaJobId ('wallet' | 'api_key'; null = wallet).
  nosanaAccessMode String? @map("nosana_access_mode")

  // Output
  outputModelId String?  @map("output_model_id") // id of the FineTunedModel this job produced
  outputPath    String?  @map("output_path") // S3/IPFS path to adapter weights

  // Metrics
  trainingLoss  Float?   @map("training_loss")
  evalLoss      Float?   @map("eval_loss")
  metrics       Json?    // Full training metrics history

  // Logs
  logs          String?  @db.Text
  lastError     String?  @map("last_error")

  // Cost tracking. reservationCents is the hold taken in the transaction that
  // created the job (retail price x maxRuntimeSeconds, ledger type
  // 'training_reservation'). settledAt is the idempotency key of the
  // settlement: the terminal compare-and-set requires it to be null, returns
  // the whole hold ('training_reservation_release') and writes the charge
  // ('training_usage') exactly once. actualCostCents is that charge.
  estimatedCostCents BigInt? @map("estimated_cost_cents")
  actualCostCents    BigInt? @map("actual_cost_cents")
  reservationCents   BigInt? @map("reservation_cents")
  // The retail rate the job was admitted at, in micro-dollars per second, so
  // a later change of the price table cannot change what this run costs.
  priceMicroUsdPerSecond BigInt? @map("price_micro_usd_per_second")
  billedSeconds      Int?      @map("billed_seconds")
  settledAt          DateTime? @map("settled_at")

  // Timestamps
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  dataset       Dataset      @relation(fields: [datasetId], references: [id])
  fineTunedModel FineTunedModel?

  @@index([orgId])
  @@index([status])
  @@index([orgId, status])
  @@map("training_jobs")
}

// The result of a completed training job: a LoRA adapter the organization
// owns. It is NOT a row of `models` (the global catalog); it is served by a
// normal deployment of its base model with Deployment.fineTunedModelId set.
model FineTunedModel {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  name          String
  slug          String
  // The slug while the model is live, NULL once it is deleted (the same
  // pattern as Dataset.liveName): the unique index is on this column.
  liveSlug      String?  @map("live_slug")

  baseModelId   String   @map("base_model_id")
  baseModelHfId String   @map("base_model_hf_id")
  // Unique: finalising a job twice finds the row the first attempt wrote.
  trainingJobId String   @unique @map("training_job_id") @db.Uuid

  method        String   // 'lora' | 'qlora'
  loraR         Int      @map("lora_r")
  // Object-store key of the adapter archive, its size and sha256 as checked
  // against storage and the trainer's `uploaded` event at finalisation.
  adapterKey    String   @map("adapter_key")
  adapterBytes  BigInt   @map("adapter_bytes")
  adapterSha256 String   @map("adapter_sha256")
  metrics       Json?

  status        String   @default("ready") // 'ready', 'deleted'
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  baseModel     Model        @relation(fields: [baseModelId], references: [id])
  trainingJob   TrainingJob  @relation(fields: [trainingJobId], references: [id], onDelete: NoAction)
  deployments   Deployment[]

  @@unique([orgId, liveSlug])
  @@index([orgId])
  @@map("fine_tuned_models")
}

// ============================================
// X-402 Payments (Phase 2)
// ============================================

model X402Payment {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid

  // Request context
  deploymentId  String?  @map("deployment_id") @db.Uuid
  agentDeploymentId String? @map("agent_deployment_id") @db.Uuid
  requestId     String   @map("request_id") // Correlation ID

  // Payment details
  network       String   // 'solana:mainnet', 'solana:devnet'
  asset         String   // 'USDC', 'SOL', 'NOS'
  amountRaw     String   @map("amount_raw") // Raw amount as string (to handle big numbers)
  amountUsd     Float    @map("amount_usd") // USD equivalent at time of payment

  // Transaction
  payerAddress  String   @map("payer_address")
  payeeAddress  String   @map("payee_address")
  txSignature   String?  @unique @map("tx_signature")

  // Status
  // 'submitted': recorded and sent, not yet known to have landed.
  // 'verified': landed. 'settled': landed, final, and the request was served.
  // 'failed': never landed, failed on the chain, or refused before sending.
  // 'refunded': landed, not served, returned as credits. 'pending' is the
  // column's default and is not written.
  status        String   @default("pending")
  verifiedAt    DateTime? @map("verified_at")
  settledAt     DateTime? @map("settled_at")

  // Error handling
  failureReason String?  @map("failure_reason")
  retryCount    Int      @default(0) @map("retry_count")

  // Claim first: the signed transaction exactly as the payer handed it over
  // and the blockhash it was built on, written with status 'submitted'
  // BEFORE it is broadcast. Only the chain then says what became of it.
  signedTxB64       String?   @map("signed_tx_b64")
  recentBlockhash   String?   @map("recent_blockhash")
  submittedAt       DateTime? @map("submitted_at")
  // What the transfer actually carried, in base units (amountRaw above is
  // what the request required), the request's price in millionths of a
  // dollar, and, for SOL, the rate the payment was quoted at.
  amountReceivedRaw String?   @map("amount_received_raw")
  amountMicroUsd    BigInt?   @map("amount_micro_usd")
  solMicroUsdPerSol BigInt?   @map("sol_micro_usd_per_sol")
  // Exactly one of these ends a payment that landed: the request was
  // answered (servedAt), or it was not and the payment went back to the
  // organization's credits (refundedAt, with what was returned).
  servedAt          DateTime? @map("served_at")
  refundedAt        DateTime? @map("refunded_at")
  refundMicroUsd    BigInt?   @map("refund_micro_usd")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Restrict (G6): these are real payments received on-chain. Same reasoning
  // as credit_transactions.
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([txSignature])
  @@index([status])
  @@map("x402_payments")
}

model X402SettlementMetric {
  id                   String   @id @default(uuid()) @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  timestamp            DateTime @default(now())

  // Payment status counts at snapshot time
  totalPayments        Int      @default(0) @map("total_payments")
  pendingPayments      Int      @default(0) @map("pending_payments")
  verifiedPayments     Int      @default(0) @map("verified_payments")
  settledPayments      Int      @default(0) @map("settled_payments")
  failedPayments       Int      @default(0) @map("failed_payments")
  retriablePayments    Int      @default(0) @map("retriable_payments")
  failureRatePercent   Float    @default(0) @map("failure_rate_percent")
  oldestPendingMinutes Int?     @map("oldest_pending_minutes")

  // Worker counters at snapshot time
  workerTicks          Int      @default(0) @map("worker_ticks")
  workerProcessed      Int      @default(0) @map("worker_processed")
  workerSettled        Int      @default(0) @map("worker_settled")
  workerFailed         Int      @default(0) @map("worker_failed")
  workerRetried        Int      @default(0) @map("worker_retried")
  workerSkipped        Int      @default(0) @map("worker_skipped")

  // Alert metadata
  alertCount           Int      @default(0) @map("alert_count")
  alerts               Json?    // Array of alert objects

  createdAt            DateTime @default(now()) @map("created_at")

  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, timestamp])
  @@index([timestamp])
  @@map("x402_settlement_metrics")
}

// ============================================
// Agent Marketplace (Phase 3)
// ============================================

model AgentListing {
  id                String    @id @default(uuid()) @db.Uuid
  agentId           String    @unique @map("agent_id") @db.Uuid
  title             String
  slug              String    @unique // URL-friendly identifier
  shortDescription  String    @map("short_description") @db.VarChar(280)
  longDescription   String?   @map("long_description") @db.Text
  category          String    // 'customer-support', 'coding', 'research', 'automation', 'creative', 'other'
  iconUrl           String?   @map("icon_url")
  screenshots       String[]  @default([])
  readme            String?   @db.Text

  // Pricing
  // Pro and Enterprise publishers rank ahead within the same sort.
  priorityPlacement Boolean   @default(false) @map("priority_placement")
  pricingModel      String    @map("pricing_model") // 'free', 'per_request', 'monthly', 'tokenized'
  pricePerRequestCents BigInt? @map("price_per_request_cents")
  monthlyPriceCents BigInt?   @map("monthly_price_cents")

  // What a buyer gets: 'use' (they use the creator's own agent on its page
  // or through the API and never see its instructions) or 'copies' (their
  // own copy, instructions included). No default on purpose: code that
  // creates a listing must say what it sells. CHECK in the migration.
  sells             String
  // Outbound tools the creator allows for people who pay to use the agent,
  // by name. Empty = none.
  useAllowedTools   String[]  @default([]) @map("use_allowed_tools")
  // Running total, in millionths of a cent, of what delivered paid uses cost
  // on the platform's model keys. Each settle adds to it, and only the whole
  // cents it has just crossed leave the creator's amount (marketplaceMetering).
  useModelCostMicros BigInt   @default(0) @map("use_model_cost_micros")

  // Try it: every published listing can be tried for free on the platform's
  // models, up to a platform-funded number of messages a day. This is how
  // many MORE messages a day the publisher pays for (0 = none).
  trialFundedDailyCap Int     @default(0) @map("trial_funded_daily_cap")

  // Publisher
  publisherId       String    @map("publisher_id") @db.Uuid
  publisherName     String    @map("publisher_name")

  // Status & Stats
  status            String    @default("draft") // 'draft', 'pending_review', 'published', 'archived'
  isFeatured        Boolean   @default(false) @map("is_featured")
  totalInstalls     Int       @default(0) @map("total_installs")
  activeInstalls    Int       @default(0) @map("active_installs")
  avgRating         Float     @default(0) @map("avg_rating")
  reviewCount       Int       @default(0) @map("review_count")
  totalRequests     BigInt    @default(0) @map("total_requests")

  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  publisher         Organization @relation("PublishedAgents", fields: [publisherId], references: [id])
  reviews           AgentReview[]
  installs          AgentInstall[]
  subscriptions     AgentSubscription[]
  agentToken        AgentToken?
  offerings     Offering[]
  trialDays         TrialDailyUsage[]

  @@index([publisherId])
  @@index([status, category])
  @@index([avgRating])
  @@index([isFeatured, status])
  @@map("agent_listings")
}

model AgentReview {
  id            String   @id @default(uuid()) @db.Uuid
  listingId     String   @map("listing_id") @db.Uuid
  reviewerId    String   @map("reviewer_id") @db.Uuid
  rating        Int      // 1-5
  title         String?  @db.VarChar(200)
  content       String?  @db.Text
  isVerified    Boolean  @default(false) @map("is_verified") // Verified if reviewer has installed agent
  helpfulCount  Int      @default(0) @map("helpful_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  listing       AgentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer      Organization @relation("AgentReviews", fields: [reviewerId], references: [id])

  @@unique([listingId, reviewerId])
  @@index([listingId, createdAt])
  @@map("agent_reviews")
}

model AgentInstall {
  id              String    @id @default(uuid()) @db.Uuid
  listingId       String    @map("listing_id") @db.Uuid
  buyerId         String    @map("buyer_id") @db.Uuid
  clonedAgentId   String?   @map("cloned_agent_id") @db.Uuid // The cloned agent in buyer's account
  status          String    @default("active") // 'active', 'stopped', 'uninstalled'
  // The buyer's licence: 'copy' (their own copy, clonedAgentId) or 'use' (use
  // of the creator's agent; clonedAgentId stays null). CHECK in the migration.
  kind            String    @default("copy")
  totalRequests   BigInt    @default(0) @map("total_requests")
  totalSpentCents BigInt    @default(0) @map("total_spent_cents")
  // The pricing the buyer agreed to (at install, or when they last accepted
  // a change). A listing price above acceptedPricePerRequestCents, or a
  // different pricing model, pauses the install until the buyer accepts it;
  // a lower price or a move to free applies at once (installAccess).
  acceptedPricingModel         String?   @map("accepted_pricing_model")
  acceptedPricePerRequestCents BigInt?   @map("accepted_price_per_request_cents")
  pricingAcceptedAt            DateTime? @map("pricing_accepted_at")
  installedAt     DateTime  @default(now()) @map("installed_at")
  uninstalledAt   DateTime? @map("uninstalled_at")

  listing         AgentListing @relation(fields: [listingId], references: [id])
  buyer           Organization @relation("AgentInstalls", fields: [buyerId], references: [id])

  @@unique([listingId, buyerId])
  @@index([buyerId])
  // Every inference request asks "is this agent a billable install?".
  // Without this index that lookup is a sequential scan on the hot path.
  @@index([clonedAgentId, status])
  @@map("agent_installs")
}

model AgentSubscription {
  id                  String    @id @default(uuid()) @db.Uuid
  listingId           String    @map("listing_id") @db.Uuid
  subscriberId        String    @map("subscriber_id") @db.Uuid
  status              String    @default("active") // 'active', 'cancelled', 'expired', 'past_due'
  currentPeriodStart  DateTime  @map("current_period_start")
  currentPeriodEnd    DateTime  @map("current_period_end")
  cancelAtPeriodEnd   Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt         DateTime? @map("cancelled_at")
  // The monthly price the buyer agreed to; renewals charge this, not the
  // listing's current price. Null only on rows from before it existed.
  priceCents          BigInt?   @map("price_cents")
  // Why the publisher's side ended it: 'pricing_changed' (the listing left
  // monthly pricing, or the row has no agreed price) or 'listing_archived'.
  // Set = the buyer has not accepted the listing's current pricing; cleared
  // when they do. Null for buyer cancellations and unpaid expiry.
  endReason           String?   @map("end_reason")
  // When the renewal worker last tried this row and did not renew it. Due
  // rows are loaded least-recently-tried first, so rows that keep failing
  // rotate to the back instead of filling every batch.
  lastRenewalAttemptAt DateTime? @map("last_renewal_attempt_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  listing             AgentListing @relation(fields: [listingId], references: [id])
  subscriber          Organization @relation("AgentSubscriptions", fields: [subscriberId], references: [id])

  @@unique([listingId, subscriberId])
  @@index([subscriberId])
  @@index([currentPeriodEnd, status])
  @@index([status, lastRenewalAttemptAt])
  @@map("agent_subscriptions")
}

model PublisherProfile {
  orgId              String   @id @map("org_id") @db.Uuid
  displayName        String   @map("display_name")
  slug               String   @unique // URL-friendly identifier
  bio                String?  @db.Text
  avatarUrl          String?  @map("avatar_url")
  website            String?
  twitter            String?
  github             String?
  isVerified         Boolean  @default(false) @map("is_verified")
  totalRevenueCents  BigInt   @default(0) @map("total_revenue_cents")
  pendingPayoutCents BigInt   @default(0) @map("pending_payout_cents")
  totalListings      Int      @default(0) @map("total_listings")
  totalInstalls      Int      @default(0) @map("total_installs")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Reputation System fields
  reputationScore    Float    @default(0) @map("reputation_score") // 0-100 score
  reputationTier     String   @default("new") @map("reputation_tier") // 'new', 'bronze', 'silver', 'gold', 'platinum'
  avgResponseTimeMs  BigInt?  @map("avg_response_time_ms") // Average response time
  supportResponseMs  BigInt?  @map("support_response_ms") // Average support response time
  successfulPayouts  Int      @default(0) @map("successful_payouts")
  disputeCount       Int      @default(0) @map("dispute_count")
  disputeResolvedCount Int    @default(0) @map("dispute_resolved_count")
  joinedDaysAgo      Int      @default(0) @map("joined_days_ago") // Calculated on profile update
  badges             String[] @default([]) // 'fast-responder', 'top-rated', 'verified-developer', etc.
  lastReputationCalc DateTime? @map("last_reputation_calc")

  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("publisher_profiles")
}

model CreatorPayout {
  id                String    @id @default(uuid()) @db.Uuid
  publisherId       String    @map("publisher_id") @db.Uuid
  amountCents       BigInt    @map("amount_cents")
  payoutMethod      String    @map("payout_method") // 'credits', 'crypto_usdc', 'crypto_sol'
  payoutAddress     String?   @map("payout_address") // Wallet address for crypto payouts
  status            String    @default("pending") // 'pending', 'processing', 'completed', 'failed', 'cancelled'
  txSignature       String?   @unique @map("tx_signature")

  // Revenue breakdown
  grossRevenueCents BigInt    @map("gross_revenue_cents")
  platformFeeCents  BigInt    @map("platform_fee_cents") // 10% platform fee

  // Period covered
  periodStart       DateTime  @map("period_start")
  periodEnd         DateTime  @map("period_end")

  requestedAt       DateTime  @default(now()) @map("requested_at")
  processedAt       DateTime? @map("processed_at")
  // The chain's or the node's own words about a failure, kept for
  // operators. Never sent to a creator: their sentence is chosen from
  // failureCode (services/payoutSentences.ts).
  failureReason     String?   @map("failure_reason")
  // Why a failed payout failed, as a code: 'could_not_send' |
  // 'invalid_address' | 'missing_address' | 'unsupported_method'. Null on
  // rows from before the codes existed.
  failureCode       String?   @map("failure_code")
  // Why a pending wallet payout has not been sent yet, as a code:
  // 'wallet_low' | 'daily_limit_reached' | 'price_unavailable' |
  // 'chain_unavailable'. Null when nothing is holding it. A payout that is
  // waiting is still pending, so its creator can cancel it.
  waitingReason     String?   @map("waiting_reason")

  // The send, claim first (the shape compute payments use). The signed
  // transfer is stored by the same compare-and-set that moves the payout
  // pending -> processing, BEFORE it is broadcast: whatever happens next,
  // the record of "these exact bytes may be in flight" exists, and the
  // same bytes are what is sent again while they can still land.
  signedTxB64          String?   @map("signed_tx_b64")
  // The last block height at which that transfer can land. Past it (with
  // a margin, and its signature unseen) the transfer is dead and a fresh
  // one may be made. Null on a row sent before this column existed.
  lastValidBlockHeight BigInt?   @map("last_valid_block_height")
  claimedAt            DateTime? @map("claimed_at")
  // How many transfers have been signed for this payout. At
  // PAYOUT_MAX_ATTEMPTS a dead or failed one ends the payout and the
  // earnings go back.
  attemptCount         Int       @default(0) @map("attempt_count")
  // Signatures of earlier transfers for this payout that failed on the
  // chain or can no longer land. Kept so each can still be looked up.
  expiredSignatures    String[]  @default([]) @map("expired_signatures")
  // What was sent, in base units (lamports, or USDC with 6 decimals), and
  // for SOL the exact price it was worked out from (micro-dollars per
  // SOL), that price's publish time and its source.
  amountRaw            String?   @map("amount_raw")
  quotePriceMicroUsd   BigInt?   @map("quote_price_micro_usd")
  quotePublishTime     DateTime? @map("quote_publish_time")
  quoteSource          String?   @map("quote_source")

  publisher         Organization @relation("CreatorPayouts", fields: [publisherId], references: [id])

  @@index([publisherId, status])
  @@map("creator_payouts")
}

// What a creator is owed, change by change. One row for every change to
// publisher_profiles.pending_payout_cents, written in the same transaction
// by services/earningsLedger.ts, the only code that may change that number.
// An organization's rows add up to it, from an 'opening_balance' row the
// migration wrote for every creator who was owed something before the
// ledger existed.
model EarningsTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  amountCents  BigInt   @map("amount_cents") // Above zero = owed more, below zero = owed less
  type         String // 'sale' | 'subscription' | 'job' | 'contributor_share' | 'payout_reserved' | 'payout_restored' | 'opening_balance'
  description  String?
  referenceId  String?  @map("reference_id") // The revenue row, payout or contributor earning the change belongs to
  balanceAfter BigInt   @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")

  // Restrict: a record of money owed. Same reasoning as credit_transactions.
  org Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@map("earnings_transactions")
}

// Revenue tracking for marketplace transactions
model MarketplaceRevenue {
  id              String   @id @default(uuid()) @db.Uuid
  // Null for a job whose offering has no agent listing (workflow and
  // model offerings); jobId identifies those.
  listingId       String?  @map("listing_id") @db.Uuid
  // Escrow for one Job (type 'job'): pending while held, settled when the
  // buyer accepts (or the review window lapses), refunded otherwise.
  jobId           String?  @unique @map("job_id") @db.Uuid
  installId       String?  @map("install_id") @db.Uuid
  subscriptionId  String?  @map("subscription_id") @db.Uuid
  buyerId         String   @map("buyer_id") @db.Uuid
  publisherId     String   @map("publisher_id") @db.Uuid

  // Transaction type
  type            String   // 'per_request', 'subscription', 'subscription_renewal', 'job'

  // Amounts
  grossAmountCents BigInt  @map("gross_amount_cents")
  platformFeeCents BigInt  @map("platform_fee_cents") // 10%
  creatorAmountCents BigInt @map("creator_amount_cents") // 90%
  // Job escrow only: what the settle moved from the creator amount into the
  // platform fee for the job's use of the platform's model keys.
  modelCostCents  BigInt   @default(0) @map("model_cost_cents")

  // Request count (for per_request billing)
  requestCount    Int      @default(1) @map("request_count")

  // Status
  status          String   @default("pending") // 'pending', 'settled', 'refunded'
  settledAt       DateTime? @map("settled_at")

  createdAt       DateTime @default(now()) @map("created_at")

  job Job? @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@index([publisherId, createdAt])
  @@index([buyerId, createdAt])
  @@index([status])
  @@map("marketplace_revenue")
}

/// A contributor's share of one settled MarketplaceRevenue row, paid into
/// the organization the contributor owns (its publisher profile accrues
/// the amount; the regular payout flow pays it out). A share whose payout
/// profile did not exist at settlement is still recorded, with accruedAt
/// null, and accrued exactly once when the profile exists.
model ContributorEarning {
  id             String   @id @default(uuid()) @db.Uuid
  revenueId      String   @map("revenue_id") @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  contributorId  String   @map("contributor_id") @db.Uuid // AgentContributor.id
  userId         String   @map("user_id") @db.Uuid
  recipientOrgId String?  @map("recipient_org_id") @db.Uuid
  publisherId    String   @map("publisher_id") @db.Uuid
  shareBps       Int      @map("share_bps")
  amountCents    BigInt   @map("amount_cents")
  // When the amount was added to the recipient's payout balance.
  accruedAt      DateTime? @map("accrued_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([revenueId, userId])
  @@index([userId, accruedAt])
  @@index([recipientOrgId, createdAt])
  @@index([agentId])
  @@map("contributor_earnings")
}

/// A fixed task a publisher sells: their agent, workflow or model runs it
/// for a buyer, paid through escrow (a Job). Runs the publisher's own
/// product in the publisher's org, so instructions and keys never leave it.
model Offering {
  id                String   @id @default(uuid()) @db.Uuid
  publisherId       String   @map("publisher_id") @db.Uuid
  productKind       String   @map("product_kind") // 'agent' | 'workflow' | 'model'
  agentId           String?  @map("agent_id") @db.Uuid
  orchestrationId   String?  @map("orchestration_id") @db.Uuid
  deploymentId      String?  @map("deployment_id") @db.Uuid
  listingId         String?  @map("listing_id") @db.Uuid
  slug              String   @unique
  title             String
  description       String   @db.Text
  priceCents        BigInt   @map("price_cents")
  // Time from funding to a submitted deliverable; past it the job
  // expires and the buyer is refunded.
  slaSeconds        Int      @map("sla_seconds")
  // JSON Schema the buyer's input must satisfy.
  inputSchema       Json?    @map("input_schema")
  // Keys of the form's questions (inputSchema's top-level properties) in
  // the order they were saved: JSONB does not keep key order and the schema
  // checker refuses any ordering keyword. Empty = draw as stored.
  inputOrder        String[] @default([]) @map("input_order")
  // True when the form was taken from the agent's own task form.
  inputFromAgentForm Boolean @default(false) @map("input_from_agent_form")
  sampleInputs      Json     @default("[]") @map("sample_inputs")
  // Private to the publisher: added to the product's instructions for
  // this offering, never shown to buyers.
  instructions      String?  @db.Text
  // Checks the output must pass before it is submitted to the buyer.
  deliverableChecks Json     @default("[]") @map("deliverable_checks")
  // 'text' | 'json': a json deliverable is parsed before it is checked.
  outputFormat      String    @default("text") @map("output_format")
  // Tools of the product a job may use. Empty = every tool the product has
  // that the 'hired' tool mode does not block.
  allowedTools      String[]  @default([]) @map("allowed_tools")
  // Runs per job before it fails and refunds (1-3).
  maxAttempts       Int       @default(1) @map("max_attempts")
  // Jobs funded or running at once; activeJobs is a compare-and-set counter.
  maxConcurrentJobs Int       @default(5) @map("max_concurrent_jobs")
  activeJobs        Int       @default(0) @map("active_jobs")
  status            String   @default("draft") // 'draft' | 'active' | 'paused' | 'archived'
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Restrict: an offering has jobs, and jobs are money records.
  publisher     Organization   @relation("PublishedOfferings", fields: [publisherId], references: [id], onDelete: Restrict)
  // SetNull: an offering whose product was deleted stays for its jobs but
  // can no longer be hired.
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  orchestration Orchestration? @relation(fields: [orchestrationId], references: [id], onDelete: SetNull)
  listing       AgentListing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  jobs Job[]

  @@index([publisherId])
  @@index([status, productKind])
  @@index([agentId])
  @@index([orchestrationId])
  @@index([listingId, status])
  @@map("offerings")
}

/// One purchase of an Offering. Money moves only on these transitions:
///   created -> funded [FUND] -> running -> submitted -> completed [SETTLE]
///   submitted -> rejected [REFUND]; funded|running -> expired|failed|cancelled [REFUND]
model Job {
  id               String    @id @default(uuid()) @db.Uuid
  offeringId       String    @map("offering_id") @db.Uuid
  buyerId          String    @map("buyer_id") @db.Uuid
  publisherId      String    @map("publisher_id") @db.Uuid
  status           String    @default("created")
  input            Json
  output           Json?
  checkResults     Json?     @map("check_results")
  priceCents       BigInt    @map("price_cents")
  failureReason    String?   @map("failure_reason")
  rejectionReason  String?   @map("rejection_reason")
  deadlineAt       DateTime? @map("deadline_at")
  reviewDeadlineAt DateTime? @map("review_deadline_at")
  fundedAt         DateTime? @map("funded_at")
  startedAt        DateTime? @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  completedAt      DateTime? @map("completed_at")
  rating           Int?
  review                   String?   @db.Text
  ratedAt                  DateTime? @map("rated_at")
  // A retried hire with the same key returns the first job; no second charge.
  idempotencyKey           String?   @map("idempotency_key")
  // Who spent the money: a signed-in member, or an API key with jobs:hire.
  hiredByUserId            String?   @map("hired_by_user_id") @db.Uuid
  hiredByApiKeyId          String?   @map("hired_by_api_key_id") @db.Uuid
  // What the buyer agreed to at hire (title, price, SLA, review window,
  // checks, output format). Later edits to the offering do not change it.
  terms                    Json      @default("{}")
  // Runs started for this job, and the running worker's lease: a job whose
  // lease lapsed before its deadline is picked up again.
  attempts                 Int       @default(0)
  leaseExpiresAt           DateTime? @map("lease_expires_at")
  orchestrationExecutionId String?   @map("orchestration_execution_id") @db.Uuid
  // Tokens this job's runs used on the platform's own model keys, and what
  // they cost. The cost comes out of the publisher's share at settlement.
  platformInputTokens      BigInt    @default(0) @map("platform_input_tokens")
  platformOutputTokens     BigInt    @default(0) @map("platform_output_tokens")
  modelCostCents           BigInt    @default(0) @map("model_cost_cents")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  offering Offering @relation(fields: [offeringId], references: [id])
  // Restrict, like CreditTransaction: a job is part of both organizations'
  // billing record.
  buyer     Organization        @relation("JobsHired", fields: [buyerId], references: [id], onDelete: Restrict)
  publisher Organization        @relation("JobsReceived", fields: [publisherId], references: [id], onDelete: Restrict)
  escrow    MarketplaceRevenue?

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, createdAt])
  @@index([publisherId, createdAt])
  @@index([status, deadlineAt])
  @@index([status, reviewDeadlineAt])
  @@index([offeringId, status])
  @@index([status, leaseExpiresAt])
  @@map("jobs")
}

// ============================================
// Enterprise Features (Phase 3)
// ============================================

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String   // 'create', 'update', 'delete', 'login', 'logout', 'deploy', 'invite', etc.
  resource      String   // 'deployment', 'agent', 'api_key', 'user', 'settings', etc.
  resourceId    String?  @map("resource_id")
  details       Json?    // Additional context
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  status        String   @default("success") // 'success', 'failure'
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@index([orgId, action])
  @@index([orgId, resource])
  @@index([userId])
  @@map("audit_logs")
}

model SsoConfig {
  orgId           String   @id @map("org_id") @db.Uuid
  provider        String   // 'saml', 'oidc'
  enabled         Boolean  @default(false)

  // SAML settings
  samlEntityId    String?  @map("saml_entity_id")
  samlSsoUrl      String?  @map("saml_sso_url")
  samlCertificate String?  @map("saml_certificate") @db.Text

  // OIDC settings
