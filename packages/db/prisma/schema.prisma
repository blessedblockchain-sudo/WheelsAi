  schedules     ScheduledTask[]

  @@unique([orgId, name])
  @@unique([orgId, slug])
  @@index([orgId])
  @@map("orchestrations")
}

model OrchestrationStep {
  id              String   @id @default(uuid()) @db.Uuid
  orchestrationId String   @map("orchestration_id") @db.Uuid

  name            String
  stepOrder       Int      @map("step_order")

  // 'agent' | 'model' | 'retrieval'. Exactly one resource is set to match:
  // agentId, deploymentId (optionally modelId), or knowledgeBaseId.
  stepType        String   @default("agent") @map("step_type")
  agentId         String?  @map("agent_id") @db.Uuid
  deploymentId    String?  @map("deployment_id") @db.Uuid
  modelId         String?  @map("model_id")
  knowledgeBaseId String?  @map("knowledge_base_id") @db.Uuid

  promptTemplate  String?  @map("prompt_template") @db.Text
  inputMapping    Json?    @map("input_mapping")
  outputMapping   Json?    @map("output_mapping")
  outputFormat    String   @default("text") @map("output_format") // 'text' | 'json'

  condition       Json?
  // { forEach: "$.steps.x.output", maxItems } or
  // { until: <condition>, maxIterations, onExhausted: 'fail' | 'continue' }
  loop            Json?

  onError         String   @default("fail") @map("on_error")
  fallbackAgentId String?  @map("fallback_agent_id") @db.Uuid
  maxRetries      Int      @default(0) @map("max_retries")
  timeoutMs       Int?     @map("timeout_ms")

  dependsOn       String[] @default([]) @map("depends_on")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orchestration   Orchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@unique([orchestrationId, name])
  @@unique([orchestrationId, stepOrder])
  @@index([orchestrationId])
  @@map("orchestration_steps")
}

model OrchestrationExecution {
  id              String   @id @default(uuid()) @db.Uuid
  orchestrationId String   @map("orchestration_id") @db.Uuid

  // queued | running | completed | failed | cancelled. Every change is a
  // compare-and-set on the previous status.
  status          String   @default("pending")
  progress        Int      @default(0)

  input           Json?
  output          Json?
  context         Json?

  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  durationMs      Int?      @map("duration_ms")

  triggeredBy     String   @default("manual") @map("triggered_by") // manual | api | schedule | job
  triggeredById   String?  @map("triggered_by_id") @db.Uuid

  // Set when a running run is asked to stop; its worker ends it.
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  // What started the run, when it was not a person.
  scheduledTaskId String?  @map("scheduled_task_id") @db.Uuid
  taskExecutionId String?  @unique @map("task_execution_id") @db.Uuid
  jobId           String?  @map("job_id") @db.Uuid

  error           String?
  failedStepId    String?  @map("failed_step_id") @db.Uuid

  createdAt       DateTime @default(now()) @map("created_at")

  orchestration   Orchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)
  stepResults     OrchestrationStepResult[]

  @@index([orchestrationId, status])
  @@index([orchestrationId, createdAt])
  @@index([status, createdAt])
  @@map("orchestration_executions")
}

model OrchestrationStepResult {
  id            String   @id @default(uuid()) @db.Uuid
  executionId   String   @map("execution_id") @db.Uuid
  stepId        String   @map("step_id") @db.Uuid
  stepName      String   @map("step_name")

  status        String   @default("pending")
  stepType      String   @default("agent") @map("step_type")
  agentId       String?  @map("agent_id") @db.Uuid
  // The deployment or knowledge base a non-agent step used.
  resourceId    String?  @map("resource_id") @db.Uuid
  // Loop pass: the item index (forEach) or the pass number (until).
  iteration     Int?

  input         Json?
  output        Json?
  error         String?
  // Tokens the pass's model call reported: { inputTokens, outputTokens }.
  // Null = none reported (or no model call), which is not zero.
  usage         Json?

  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  durationMs    Int?      @map("duration_ms")

  attempt       Int       @default(1)

  createdAt     DateTime  @default(now()) @map("created_at")

  execution     OrchestrationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, stepId])
  @@map("orchestration_step_results")
}

